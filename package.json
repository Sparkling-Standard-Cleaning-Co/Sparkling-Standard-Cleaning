{
  "name": "sparkling-standard-cleaning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marketing, estimate, and lead system for Sparkling Standard Cleaning Co., serving the Pensacola and Cantonment area.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "npm run check && npm run build && npm run validate",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:browser": "npm run build && node --test \"tests/browser/*.test.mjs\"",
    "validate": "node scripts/validate-site.mjs",
    "links": "node scripts/links.mjs",
    "seo": "node scripts/verify-seo.mjs",
    "pending": "node scripts/check-pending-facts.mjs",
    "testimonials": "node scripts/check-fake-testimonials.mjs",
    "marketing:links": "node scripts/generate-marketing-links.mjs",
    "marketing:qr": "node scripts/generate-marketing-links.mjs --qr",
    "marketing:verify": "node scripts/generate-marketing-links.mjs --check",
    "validate:production": "node scripts/validate-production-env.mjs",
    "deploy:secrets": "node scripts/generate-deploy-secrets.mjs",
    "estimate:quotes": "node scripts/quote-preview.mjs",
    "estimate:discount-impact": "node scripts/discount-impact.mjs",
    "promotions:impact": "node scripts/promotions-impact.mjs",
    "gift:certificate": "node scripts/gift-certificate.mjs",
    "live:check": "node scripts/live-check.mjs",
    "mapmap:verify": "node scripts/test-mapmap.mjs",
    "address:check": "node scripts/address-live-check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "audit:facts": "node scripts/audit-facts.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.4.0",
    "astro": "^5.13.0",
    "maplibre-gl": "^6.11.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "jsqr": "^1.4.0",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.7.3"
  }
}
