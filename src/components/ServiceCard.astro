---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';

interface Props {
  title: string;
  summary: string;
  href: string;
  icon: IconName;
  cta?: string;
  featured?: boolean;
}

const { title, summary, href, icon, cta = 'Learn more', featured = false } = Astro.props;
---

<article class:list={['card', 'card--link', featured && 'card--feature']}>
  <span class="card__icon"><Icon name={icon} /></span>
  <h3 class="card__title"><a href={href}>{title}</a></h3>
  <p class="card__text">{summary}</p>
  <a class="card__more" href={href}>{cta} <Icon name="arrow-right" size={16} /></a>
</article>
