---
import PremiumIcon from './PremiumIcon.astro';
import type { PremiumIconName } from '../lib/premium-icons.ts';
import Icon from './Icon.astro';

interface Props {
  title: string;
  summary: string;
  href: string;
  icon: PremiumIconName;
  cta?: string;
  featured?: boolean;
}

const { title, summary, href, icon, cta = 'Learn more', featured = false } = Astro.props;
---

<article class:list={['card', 'card--link', 'service-card', featured && 'card--feature']}>
  <PremiumIcon name={icon} size={3} />
  <h3 class="card__title"><a href={href}>{title}</a></h3>
  <p class="card__text">{summary}</p>
  <a class="card__more" href={href}>{cta} <Icon name="arrow-right" size={16} /></a>
</article>
