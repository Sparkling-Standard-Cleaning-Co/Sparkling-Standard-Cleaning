---
import { business, contactPhone, isPending, isFormEnabled } from '../config/business';
import Icon from './Icon.astro';

const configured = isFormEnabled();
const phone = contactPhone();
const hasEmail = !isPending(business.email);

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<form class:list={['form-card', className]} data-lead-form data-variant="contact" action="#" method="post">
  {
    !configured && (
      <p class="form-status" data-state="info" style="display:block">
        Message delivery is not connected on this preview build. In an emergency-free world you would
        call or text — and you still can:
      </p>
    )
  }

  <div class="field-row field-row--2">
    <div class="field">
      <label for="contact-name">Your name</label>
      <input class="input" id="contact-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="contact-phone">Phone</label>
      <input class="input" id="contact-phone" name="phone" type="tel" autocomplete="tel" required />
    </div>
  </div>

  <div class="field">
    <label for="contact-email">Email</label>
    <input class="input" id="contact-email" name="email" type="email" autocomplete="email" required />
  </div>

  <div class="field">
    <label for="contact-message">How can we help?</label>
    <textarea
      class="textarea"
      id="contact-message"
      name="message"
      rows="5"
      required
      placeholder="Tell us about your home or space, and what you're looking for."
    ></textarea>
  </div>

  <div class="honeypot" aria-hidden="true">
    <input
      id="contact-extra-ref"
      name="extra_ref"
      type="text"
      tabindex="-1"
      autocomplete="off"
      data-lpignore="true"
      data-1p-ignore
      data-bwignore
      data-protonpass-ignore
    />
  </div>

  <p class="small text-muted">
    By sending this message you agree to our <a href="/privacy/">privacy policy</a>. We use your
    details only to respond to you — never for analytics.
  </p>

  <button class="btn btn--primary btn--large btn--block" type="submit" data-cta="contact-submit">
    <Icon name="send" size={18} /> Send message
  </button>

  <p class="form-status" data-form-status role="status" aria-live="polite"></p>

  <div class="contact-fallback">
    <p class="mb-0">
      Prefer to talk?
      {
        phone ? (
          <> Call <a href={phone.href} data-cta="contact-fallback-call">{phone.display}</a>{business.flags.smsEnabled && <> or text <a href={phone.sms} data-cta="contact-fallback-text">{phone.display}</a></>}.</>
        ) : (
          <> A direct phone line is pending — send a message and we will reply.</>
        )
      }
      {hasEmail && <> Or email <a href={`mailto:${business.email}`}>{business.email}</a>.</>}
    </p>
  </div>
</form>

<script>
  import '../scripts/lead-forms';
</script>
