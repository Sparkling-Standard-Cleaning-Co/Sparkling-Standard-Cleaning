---
import {
  FLORIDA_MAP_CONTEXT_PATHS,
  FLORIDA_MAP_HEIGHT,
  FLORIDA_MAP_REGIONS,
  FLORIDA_MAP_STATE_LINE,
  FLORIDA_MAP_WIDTH,
} from '../lib/geo/florida-service-area-overview';
---

<figure class="area-map area-map--overview">
  <div class="area-map__frame">
    <svg
      viewBox={`0 0 ${FLORIDA_MAP_WIDTH} ${FLORIDA_MAP_HEIGHT}`}
      class="area-map__svg"
      role="img"
      aria-label="Florida overview showing two Sparkling Standard operating regions: Northwest Florida around Pensacola and Cantonment, and Tampa Bay covering Pasco, Pinellas and Hillsborough counties. Other Florida counties are neutral context and are not automatic service promises."
    >
      <rect x="0" y="0" width={FLORIDA_MAP_WIDTH} height={FLORIDA_MAP_HEIGHT} fill="var(--color-cream-100)" />
      <g fill="var(--color-cream-200)" stroke="var(--color-sand-300)" stroke-width="1">
        {FLORIDA_MAP_CONTEXT_PATHS.map((path) => <path d={path} />)}
      </g>
      {FLORIDA_MAP_REGIONS.filter((county) => county.category === 'northwest').map((county) => (
        <path d={county.path} class="area-map__county area-map__county--northwest" />
      ))}
      {FLORIDA_MAP_REGIONS.filter((county) => county.category === 'tampa').map((county) => (
        <path d={county.path} class="area-map__county area-map__county--tampa" />
      ))}
      <path d={FLORIDA_MAP_STATE_LINE} class="area-map__stateline" fill="none" />
    </svg>
  </div>
  <figcaption class="area-map__legend">
    <span class="area-map__legend-item">
      <span class="area-map__swatch area-map__swatch--core" aria-hidden="true"></span>
      <span><strong>Northwest Florida</strong> <span class="area-map__legend-note">Pensacola / Cantonment</span></span>
    </span>
    <span class="area-map__legend-item">
      <span class="area-map__swatch area-map__swatch--tampa" aria-hidden="true"></span>
      <span><strong>Tampa Bay</strong> <span class="area-map__legend-note">Pasco / Pinellas / Hillsborough</span></span>
    </span>
    <span class="area-map__legend-item">
      <span class="area-map__swatch area-map__swatch--context" aria-hidden="true"></span>
      <span><strong>Neutral context</strong> <span class="area-map__legend-note">not automatically served</span></span>
    </span>
  </figcaption>
  <p class="small text-muted area-map__note">
    This overview distinguishes our operating regions; it does not imply service
    across every area between them. Each region has its own approved coverage
    and address checks.
  </p>
</figure>
