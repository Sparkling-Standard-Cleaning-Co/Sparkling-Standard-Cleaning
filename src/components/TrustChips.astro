---
import PremiumIcon from './PremiumIcon.astro';

// The owner's four-value trust banner. Headings and icons are owner-specified
// (white-tile collection, 2026-10-25); the 2026-10-26 audit removed all
// descriptive copy beneath them. Keep the four titles and approved icons.
---

<div class="trust-strip">
  <div class="container trust-strip__grid">
    <div class="trust-item">
      <PremiumIcon name="locally-owned" size={4} />
      <p class="trust-item__title">Locally Owned</p>
    </div>

    <div class="trust-item">
      <PremiumIcon name="flexible-scheduling" size={4} />
      <p class="trust-item__title">Flexible Scheduling</p>
    </div>

    <div class="trust-item">
      <PremiumIcon name="christian-values" size={4} />
      <p class="trust-item__title">Christian Values</p>
    </div>

    <div class="trust-item trust-item--pricing">
      <PremiumIcon name="competitive-pricing" size={4.2} />
      <p class="trust-item__title">Competitive Pricing</p>
    </div>
  </div>
</div>
