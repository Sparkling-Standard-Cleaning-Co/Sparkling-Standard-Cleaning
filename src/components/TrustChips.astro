---
import { business } from '../config/business';
import PremiumIcon from './PremiumIcon.astro';

// The owner's four-value trust banner. Headings and icons are owner-specified
// (white-tile collection, 2026-10-25) — never substitute different headings,
// icons or interpretations:
//   Locally Owned          — white-tile house + location marker
//   Flexible Scheduling    — white-tile calendar + clock
//   Christian Values       — white-tile gold cross + heart, with two KJV New
//                            Testament excerpts (owner-supplied verbatim)
//   Competitive Pricing    — exact four-dollar-sign tile: first filled gold,
//                            remaining three outlined, with the exact copy.

interface Verse {
  quote: string;
  reference: string;
}

const CHRISTIAN_VALUES_VERSES: Verse[] = [
  {
    quote: '…by love serve one another.',
    reference: 'Galatians 5:13 (KJV)',
  },
  {
    quote: 'And whatsoever ye do, do it heartily, as to the Lord…',
    reference: 'Colossians 3:23 (KJV)',
  },
];
---

<div class="trust-strip">
  <div class="container trust-strip__grid">
    <div class="trust-item">
      <PremiumIcon name="locally-owned" size={4} />
      <div>
        <p class="trust-item__title">Locally Owned</p>
        <p class="trust-item__text">Proudly rooted in Pensacola — our customers are our neighbors.</p>
      </div>
    </div>

    <div class="trust-item">
      <PremiumIcon name="flexible-scheduling" size={4} />
      <div>
        <p class="trust-item__title">Flexible Scheduling</p>
        <p class="trust-item__text">
          Open {business.hours.days.toLowerCase()} — a rhythm that fits around your life.
        </p>
      </div>
    </div>

    <div class="trust-item">
      <PremiumIcon name="christian-values" size={4} />
      <div>
        <p class="trust-item__title">Christian Values</p>
        <ul class="trust-item__verses">
          {
            CHRISTIAN_VALUES_VERSES.map((verse) => (
              <li>
                <p class="trust-verse">“{verse.quote}”</p>
                <p class="trust-verse__ref">{verse.reference}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="trust-item trust-item--pricing">
      <PremiumIcon name="competitive-pricing" size={4.2} />
      <div>
        <p class="trust-item__title">Competitive Pricing</p>
        <p class="trust-item__text">Quality service at an affordable price</p>
      </div>
    </div>
  </div>
</div>
