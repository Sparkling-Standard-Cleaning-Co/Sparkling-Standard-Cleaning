---
import Icon from './Icon.astro';
import type { IconName } from '../lib/icons';
import { business } from '../config/business';

// The four owner-approved supporting statements for "The difference, in one
// thought." Wording is Hayli's; do not rewrite or add claims.

interface TrustItem {
  icon: IconName;
  title: string;
  text: string;
}

interface Props {
  items?: TrustItem[];
}

const defaultItems: TrustItem[] = [
  {
    icon: 'star',
    title: 'Details matter',
    text: 'The small things get noticed here — fingerprints, buildup, and neglected areas.',
  },
  {
    icon: 'heart',
    title: 'Owner operated',
    text: 'Your cleaning is done by the owner, occasionally alongside a trusted partner — never a rotating crew.',
  },
  {
    icon: 'clipboard',
    title: 'Requests reviewed personally',
    text: 'Appointments are not automatically generated. Dates, scopes, and prices are confirmed by the owner of Sparkling Standard before anything is booked.',
  },
  {
    icon: 'calendar',
    title: 'Flexible scheduling',
    text: `We are open ${business.hours.days.toLowerCase()}, ${business.hours.residentialWindow}.`,
  },
];

const { items = defaultItems } = Astro.props;
---

<div class="trust-strip">
  <div class="container trust-strip__grid">
    {
      items.map((item) => (
        <div class="trust-item">
          <Icon name={item.icon} />
          <div>
            <p class="trust-item__title">{item.title}</p>
            <p class="trust-item__text">{item.text}</p>
          </div>
        </div>
      ))
    }
  </div>
</div>
