---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PremiumIcon from './PremiumIcon.astro';
import type { PremiumIconName } from '../lib/premium-icons.ts';
import Icon from './Icon.astro';

interface Props {
  title: string;
  summary: string;
  paragraphs: string[];
  href: string;
  icon: PremiumIconName;
  cta?: string;
  featured?: boolean;
  /** Representative interior photo (licensed stock — never claimed as our work). */
  image?: ImageMetadata;
  imageAlt?: string;
  imageWidths?: number[];
  imageSizes?: string;
}

const {
  title,
  summary,
  paragraphs,
  href,
  icon,
  cta = 'Explore this service',
  featured = false,
  image,
  imageAlt = '',
  imageWidths = [360, 540, 720],
  imageSizes = '(min-width: 64rem) 21rem, (min-width: 40rem) 44vw, 92vw',
} = Astro.props;

const copy = paragraphs.length > 0 ? paragraphs : [summary];
---

<article
  class:list={[
    'card',
    'service-card',
    'card--link',
    image ? 'service-card--photo' : 'service-card--row',
    featured && 'card--feature',
  ]}
>
  {
    image && (
      <a class="service-card__media card__media" href={href} tabindex="-1" aria-hidden="true">
        <Image
          src={image}
          alt={imageAlt}
          widths={imageWidths}
          sizes={imageSizes}
          loading="lazy"
          decoding="async"
          class="card__media-image"
        />
      </a>
    )
  }
  <div class="service-card__head">
    <PremiumIcon name={icon} size={5} />
    <h3 class="card__title"><a href={href}>{title}</a></h3>
  </div>
  <div class="service-card__body">
    {copy.map((paragraph) => <p class="card__text">{paragraph}</p>)}
    <a class="card__more" href={href}>{cta} <Icon name="arrow-right" size={16} /></a>
  </div>
</article>
