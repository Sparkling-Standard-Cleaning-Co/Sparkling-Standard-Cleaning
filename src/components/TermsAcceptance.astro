---
import { legalTerms } from '../config/legal';

interface Props {
  id: string;
}

const { id } = Astro.props;
---
<div class="terms-acceptance">
  <label class="terms-acceptance__label" for={id}>
    <input
      class="terms-acceptance__input"
      id={id}
      name="termsAccepted"
      type="checkbox"
      value="yes"
      required
      data-error-required="Please agree to the Terms and Conditions and acknowledge the Privacy Policy to continue."
    />
    <span>
      I have read and agree to Sparkling Standard&rsquo;s
      <a href={legalTerms.termsPath} target="_blank" rel="noopener noreferrer">Terms and Conditions</a>
      and acknowledge the
      <a href={legalTerms.privacyPath} target="_blank" rel="noopener noreferrer">Privacy Policy</a>.
    </span>
  </label>
  <p class="terms-acceptance__note">
    The version you accept is recorded with your request. For a continuing service agreement,
    Florida law gives you three business days to cancel without penalty. Please review the policies
    before paying or reserving.
  </p>
</div>
