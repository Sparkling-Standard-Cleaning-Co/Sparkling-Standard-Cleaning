---
// Facility estimate engine — Commercial and Church (Initiative 6.0; pricing 6.1).
//
// One shared facility request experience with engine-specific questions and
// the SAME address finder, travel lookup, lead pipeline, and owner
// notification as the residential estimator. Numeric facility pricing is
// controlled by the owner kill switch (`commercialTierConfig.numericEstimatesEnabled`):
// enabled = Tier A single preliminary price / Tier B range / Tier C personal
// scope review; disabled = a professional scope-review experience with no
// numbers in the UI, request, notification or server verification.
import { isFormEnabled } from '../config/business';
import { commercialTierConfig } from '../config/estimators/commercial';
import { pricing } from '../config/pricing';
import {
  CHURCH_BREAKROOM_OPTIONS,
  CHURCH_PARTNERSHIP_OPTIONS,
  COMMERCIAL_BREAKROOM_OPTIONS,
  COMMERCIAL_FACILITY_TYPES,
  FACILITY_CONDITION_OPTIONS,
  FACILITY_FREQUENCY_OPTIONS,
  FACILITY_INPUT_LIMITS,
  FIRST_CLEAN_OPTIONS,
  FLOORING_OPTIONS,
  SERVICE_WINDOW_OPTIONS,
  SPECIALTY_OPTIONS,
  TRAFFIC_OPTIONS,
} from '../config/estimators/input-definitions';
import { schedulingConfig } from '../config/scheduling';
import { FACILITY_STEPS } from '../lib/estimate/engines';
import { US_STATES } from '../lib/location/location';
import Icon from './Icon.astro';
import TurnstileWidget from './TurnstileWidget.astro';
import PhotoUploadSection from './PhotoUploadSection.astro';
import EstimateReveal from './EstimateReveal.astro';
import TermsAcceptance from './TermsAcceptance.astro';
import BookingPicker from './BookingPicker.astro';

type FacilityEngine = 'commercial' | 'church';

interface Props {
  engine: FacilityEngine;
}

const { engine } = Astro.props;
const configured = isFormEnabled();
const church = engine === 'church';
const discountPercent = pricing.churchDiscount.percent.value;
const discountEnabled = pricing.churchDiscount.enabled.value;
const numericEstimatesEnabled = commercialTierConfig.numericEstimatesEnabled;
const facilitySteps = FACILITY_STEPS[engine];
const facilityStepDescriptions = church
  ? [
      'Tell us about your church or ministry and confirm the facility location.',
      'A few facts about the spaces you need cleaned and how often.',
      'When should we clean, and how should we access the building?',
      'Review the preliminary estimate and send your request.',
    ]
  : [
      'Tell us about your business and confirm the facility location.',
      'A few facts about the space and the cleaning workload.',
      'When should we clean, and how should we access the facility?',
      'Review the preliminary estimate and send your request.',
    ];

---

<form
  class="wizard facility-form"
  id={church ? 'church-estimate-form' : 'commercial-estimate-form'}
  data-facility-form
  data-engine={engine}
  action="#"
  method="post"
  autocomplete="off"
  novalidate
>
  <div class="facility-form__progress">
    <p class="facility-form__progress-title">
      {church ? 'Church cleaning estimate' : 'Commercial cleaning estimate'}
    </p>
    <p class="small text-muted">
      Four short sections. A confirmed address lets us verify travel and service eligibility; the
      final scope and price are always confirmed personally.
    </p>
    <nav class="facility-steps" data-facility-steps aria-label="Facility estimate steps">
      <ol class="facility-steps__list">
        {facilitySteps.map((title, index) => (
          <li class="facility-steps__item">
            <button
              type="button"
              class="facility-steps__button"
              data-facility-step-jump={index + 1}
              aria-current={index === 0 ? 'step' : undefined}
              disabled={index !== 0}
            >
              <span class="facility-steps__number" aria-hidden="true">{index + 1}</span>
              <span class="facility-steps__title">{title}</span>
            </button>
          </li>
        ))}
      </ol>
    </nav>
    <div
      class="facility-progress"
      role="progressbar"
      aria-label="Facility estimate progress"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="25"
      data-facility-progress
    >
      <div class="facility-progress__fill" data-facility-progress-fill></div>
    </div>
    <p class="small text-muted facility-progress__label">
      <span data-facility-step-label>Step 1 of 4 — {facilitySteps[0]}</span>
      <span data-facility-progress-percent>25%</span>
    </p>
    <p class="small facility-step-description" data-facility-step-description>
      {facilityStepDescriptions[0]}
    </p>
  </div>

  {
    !configured && (
      <p class="form-status" data-state="info" style="display:block">
        Request delivery is not connected on this preview build. This form shows the real request
        experience; submissions in preview cannot be delivered.
      </p>
    )
  }

  <div class="error-summary" data-error-summary hidden role="alert" tabindex="-1">
    <p class="error-summary__title" data-error-summary-title>Please review these details before sending:</p>
    <ul data-error-summary-list></ul>
  </div>

  <!-- 1. Facility & address -->
  <section class="facility-form__section" data-facility-section="1" data-facility-step-panel="1">
    <h2 class="wizard__step-heading" tabindex="-1" data-facility-step-title>{church ? 'Your ministry & location' : 'Your facility & location'}</h2>
    <p class="small text-muted facility-step-description">{facilityStepDescriptions[0]}</p>
    <div class="field-row field-row--2">
      <div class="field">
        <label for="fac-org">{church ? 'Church / ministry name' : 'Business / organization'}</label>
        <input class="input" id="fac-org" name="organization" type="text" autocomplete="organization" required />
      </div>
      <div class="field">
        <label for="fac-name">Contact name</label>
        <input class="input" id="fac-name" name="name" type="text" autocomplete="name" required />
      </div>
    </div>

    {
      church && (
        <div class="field">
          <label for="fac-role">Contact role (optional)</label>
          <input class="input" id="fac-role" name="contact_role" type="text" placeholder="e.g. Church administrator, trustee, pastor" />
        </div>
      )
    }

    <div class="address-finder" data-address-finder data-state="idle" data-method="manual">
      <div class="address-gps">
        <button type="button" class="btn btn--primary btn--block" data-address-gps>
          <Icon name="map-pin" size={18} /> Find My Location
        </button>

        <div class="address-permission" data-address-permission hidden>
          <p class="address-permission__title" data-permission-title>Location access is off.</p>
          <p class="hint" data-permission-message></p>
          <ol class="address-permission__steps" data-permission-steps></ol>
          <div class="address-finder__actions">
            <button type="button" class="btn btn--secondary btn--small" data-address-gps-retry>Try Location Again</button>
            <button type="button" class="btn btn--ghost btn--small" data-address-manual-open>Enter Address Manually</button>
          </div>
        </div>
      </div>

      <details class="address-manual" data-address-manual-details>
        <summary class="address-manual__summary" data-address-manual-summary>Or enter the facility address manually</summary>
        <div class="address-manual__body">
          <div class="field-row field-row--2">
            <div class="field field--grow address-street-wrap">
              <label for="est-address">Street address</label>
              <input
                class="input"
                id="est-address"
                name="serviceAddress"
                type="text"
                autocomplete="address-line1"
                placeholder="e.g. 123 Main Street"
                role="combobox"
                aria-expanded="false"
                aria-autocomplete="list"
                aria-controls="est-address-suggestions"
              />
              <ul
                class="address-suggestions"
                id="est-address-suggestions"
                role="listbox"
                aria-label="Address suggestions"
                data-address-suggestions
                hidden
              ></ul>
            </div>
            <div class="field field--unit">
              <label for="est-address-unit">Suite / unit</label>
              <input class="input" id="est-address-unit" name="addressUnit" type="text" autocomplete="address-line2" maxlength="30" placeholder="Optional" />
            </div>
          </div>
          <div class="field-row field-row--3">
            <div class="field field--grow">
              <label for="est-address-city">City</label>
              <input class="input" id="est-address-city" name="addressCity" type="text" autocomplete="address-level2" placeholder="e.g. Pensacola" />
            </div>
            <div class="field">
              <label for="est-address-state">State</label>
              <select class="select" id="est-address-state" name="addressState" autocomplete="address-level1">
                {US_STATES.map((state) => (
                  <option value={state.code} selected={state.code === 'FL'} disabled={state.disabled}>{state.name}</option>
                ))}
              </select>
            </div>
            <div class="field field--zip">
              <label for="est-zip">ZIP code <span class="text-muted">(if known)</span></label>
              <input class="input" id="est-zip" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" placeholder="e.g. 32503" pattern="[0-9]{5}(-[0-9]{4})?" />
            </div>
          </div>
          <p class="hint address-finder__status" data-address-status aria-live="polite">
            Start typing the facility address — suggestions appear as you type.
          </p>
          <div class="address-finder__actions">
            <button type="button" class="btn btn--secondary btn--small" data-address-resolve>Find This Address</button>
          </div>
        </div>
      </details>

      <div class="address-map" data-address-map hidden>
        <div class="address-map__canvas" data-address-map-canvas></div>
        <p class="hint">Confirm this is the right destination, or drag the pin to correct it.</p>
        <p class="hint address-map__fallback" data-address-map-fallback hidden>
          Map preview is unavailable right now — the confirmed coordinates still work. You can continue.
        </p>
        <div class="address-finder__actions">
          <button type="button" class="btn btn--primary btn--small" data-address-confirm>Confirm this location</button>
          <button type="button" class="btn btn--ghost btn--small" data-address-change>Change address</button>
        </div>
      </div>

      <div class="address-confirmed" data-address-confirmed hidden>
        <p class="address-confirmed__title"><Icon name="check" size={16} /> Destination confirmed</p>
        <p class="address-confirmed__label" data-address-confirmed-label></p>
        <p class="hint" data-address-confirmed-travel></p>
      </div>
    </div>
  </section>

  <!-- 2. Space & workload -->
  <section class="facility-form__section" data-facility-section="2" data-facility-step-panel="2" hidden>
    <h2 class="wizard__step-heading" tabindex="-1" data-facility-step-title>{church ? 'Spaces & weekly life' : 'Space & cleaning scope'}</h2>
    <p class="small text-muted facility-step-description">{facilityStepDescriptions[1]}</p>

    {
      church ? (
        <>
          <div class="field-row field-row--2">
            <div class="field">
              <label for="fac-sqft">Approximate cleanable square footage</label>
              <input class="input" id="fac-sqft" name="cleanable_sqft" type="text" inputmode="numeric" placeholder="e.g. 8,000 (the area we actually clean)" required />
              <span class="hint">Floors and rooms that need cleaning — not storage or unused space.</span>
            </div>
            <div class="field">
              <label for="fac-seats">Sanctuary seating (approx.)</label>
              <input class="input" id="fac-seats" name="sanctuary_seats" type="number" min={FACILITY_INPUT_LIMITS.sanctuarySeats.min} max={FACILITY_INPUT_LIMITS.sanctuarySeats.max} inputmode="numeric" placeholder="e.g. 250" />
            </div>
          </div>
          <div class="field-row field-row--3">
            <div class="field">
              <label for="fac-restrooms">Restroom fixtures (toilets, urinals, sinks)</label>
              <input class="input" id="fac-restrooms" name="restroom_fixtures" type="number" min={FACILITY_INPUT_LIMITS.restroomFixtures.min} max={FACILITY_INPUT_LIMITS.restroomFixtures.max} inputmode="numeric" placeholder="e.g. 8" required />
            </div>
            <div class="field">
              <label for="fac-classrooms">Classrooms</label>
              <input class="input" id="fac-classrooms" name="classroom_count" type="number" min={FACILITY_INPUT_LIMITS.classrooms.min} max={FACILITY_INPUT_LIMITS.classrooms.max} inputmode="numeric" placeholder="e.g. 6" />
            </div>
            <div class="field">
              <label for="fac-nursery">Nursery / children's spaces?</label>
              <select class="select" id="fac-nursery" name="nursery" required>
                <option value="no">No</option>
                <option value="yes">Yes</option>
              </select>
            </div>
          </div>
          <div class="field-row field-row--2">
            <div class="field">
              <label for="fac-kitchen">Kitchen / fellowship hall?</label>
              <select class="select" id="fac-kitchen" name="breakroom">
                {CHURCH_BREAKROOM_OPTIONS.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>
            <div class="field">
              <label for="fac-events">Weekly services / events (approx.)</label>
              <input class="input" id="fac-events" name="weekly_events" type="text" placeholder="e.g. Sunday services, Wednesday night, one monthly event" />
            </div>
          </div>
        </>
      ) : (
        <>
          <div class="field-row field-row--2">
            <div class="field">
              <label for="fac-type">Facility type</label>
              <select class="select" id="fac-type" name="facility_type" required>
                <option value="">Choose the closest match…</option>
                {COMMERCIAL_FACILITY_TYPES.map((type) => (<option value={type.value}>{type.label}</option>))}
              </select>
            </div>
            <div class="field">
              <label for="fac-sqft">Approximate cleanable square footage</label>
              <input class="input" id="fac-sqft" name="cleanable_sqft" type="text" inputmode="numeric" placeholder="e.g. 2,000 (the area we actually clean)" required />
              <span class="hint">Floors and rooms that need cleaning — not storage or unused space.</span>
            </div>
          </div>
          <div class="field-row field-row--3">
            <div class="field">
              <label for="fac-restrooms">Restroom fixtures (toilets, urinals, sinks)</label>
              <input class="input" id="fac-restrooms" name="restroom_fixtures" type="number" min={FACILITY_INPUT_LIMITS.restroomFixtures.min} max={FACILITY_INPUT_LIMITS.restroomFixtures.max} inputmode="numeric" placeholder="e.g. 6" required />
            </div>
            <div class="field">
              <label for="fac-workstations">Workstations / offices</label>
              <input class="input" id="fac-workstations" name="workstations" type="number" min={FACILITY_INPUT_LIMITS.workstations.min} max={FACILITY_INPUT_LIMITS.workstations.max} inputmode="numeric" placeholder="Optional" />
            </div>
            <div class="field">
              <label for="fac-breakroom">Kitchen or breakroom?</label>
              <select class="select" id="fac-breakroom" name="breakroom">
                {COMMERCIAL_BREAKROOM_OPTIONS.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>
          </div>
          <div class="field-row field-row--2">
            <div class="field">
              <label for="fac-traffic">Average traffic</label>
              <select class="select" id="fac-traffic" name="traffic">
                {TRAFFIC_OPTIONS.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>
            <div class="field">
              <label for="fac-specialty">Specialty needs (optional)</label>
              <select class="select" id="fac-specialty" name="specialty_services">
                <option value="">None</option>
                {SPECIALTY_OPTIONS.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>
          </div>
        </>
      )
    }

    <div class="field-row field-row--2">
      <div class="field">
        <label for="fac-condition">Current condition</label>
        <select class="select" id="fac-condition" name="condition">
          {FACILITY_CONDITION_OPTIONS.map((option) => (
            <option value={option.value} selected={option.value === 'average'}>{option.label}</option>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="fac-frequency">Desired cleaning frequency</label>
        <select class="select" id="fac-frequency" name="frequency" required>
          <option value="">Choose one…</option>
          {FACILITY_FREQUENCY_OPTIONS.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>
    </div>
    <div class="field-row field-row--2">
      <div class="field">
        <label for="fac-flooring">Dominant flooring</label>
        <select class="select" id="fac-flooring" name="flooring">
          {FLOORING_OPTIONS.map((option) => (
            <option value={option.value} selected={option.value === 'mixed'}>{option.label}</option>
          ))}
        </select>
      </div>
      <div class="field">
        <label for="fac-first-clean">Is this an initial detail clean?</label>
        <select class="select" id="fac-first-clean" name="first_clean">
          {FIRST_CLEAN_OPTIONS.map((option) => (
            <option value={option.value} selected={option.value === 'no'}>{option.label}</option>
          ))}
        </select>
      </div>
    </div>
  </section>

  <!-- 3. Schedule & access -->
  <section class="facility-form__section" data-facility-section="3" data-facility-step-panel="3" hidden>
    <h2 class="wizard__step-heading" tabindex="-1" data-facility-step-title>Schedule & access</h2>
    <p class="small text-muted facility-step-description">{facilityStepDescriptions[2]}</p>
    <div class="field-row field-row--2">
      <div class="field">
        <label for="fac-start">Preferred start date</label>
        <input class="input" id="fac-start" name="preferred_date" type="date" />
        <span class="hint">
          Requests can be made up to {schedulingConfig.advanceReservationDays} days in advance.
          Appointment times are {schedulingConfig.timeZoneLabel}.
        </span>
      </div>
      <div class="field">
        <label for="fac-window">Service window</label>
        <select class="select" id="fac-window" name="time_preference" required>
          <option value="">When should we clean?</option>
          {SERVICE_WINDOW_OPTIONS.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      </div>
    </div>
    <div class="field-row field-row--2">
      <div class="field">
        <label for="fac-days">Preferred days (optional)</label>
        <input class="input" id="fac-days" name="preferred_days" type="text" placeholder="e.g. Tuesday & Friday mornings" />
      </div>
      <div class="field">
        <label for="fac-access">Access notes (optional)</label>
        <input class="input" id="fac-access" name="access_notes" type="text" placeholder="Keys, alarm codes process, parking, freight elevator…" />
      </div>
    </div>
    <div class="field">
      <label for="fac-notes">Anything else we should know?</label>
      <textarea class="textarea" id="fac-notes" name="notes" rows="4" placeholder="Surfaces, restrictions, events, priorities, current cleaning arrangement…"></textarea>
    </div>
  </section>

  <!-- 4. Contact & review -->
  <section class="facility-form__section" data-facility-section="4" data-facility-step-panel="4" hidden>
    <h2 class="wizard__step-heading" tabindex="-1" data-facility-step-title>Contact & review</h2>
    <p class="small text-muted facility-step-description">{facilityStepDescriptions[3]}</p>

    <EstimateReveal />
    <div class="facility-estimate" data-facility-estimate hidden aria-live="polite">
      <p class="facility-estimate__eyebrow" data-facility-estimate-label>Preliminary estimate</p>
      <p class="facility-estimate__price" data-facility-estimate-price>—</p>
      <p class="facility-estimate__range" data-facility-estimate-range hidden></p>
      <ul class="summary-list facility-estimate__lines" data-facility-estimate-lines></ul>
      <p class="facility-estimate__note" data-facility-estimate-note></p>
      <p class="facility-estimate__tax small text-muted" data-facility-estimate-tax></p>
    </div>
    <div class="estimate-result facility-form__result" data-facility-result hidden aria-live="polite">
      <p class="estimate-result__label">Your request</p>
      <p class="estimate-result__price" data-facility-result-title>Scope review</p>
      <p class="estimate-result__note" data-facility-result-note></p>
    </div>

    {
      church && (
        <div class="church-commitment">
          <p class="church-commitment__title">Our Commitment to Local Churches</p>
          {discountEnabled ? (
            <p class="church-commitment__text">
              Rooted in our faith and our respect for the work local congregations do, Sparkling
              Standard offers churches <strong>{discountPercent}% off eligible cleaning services</strong>.
              It is one way we give back to the communities we serve. This is a service discount on
              your cleaning — it is not a charitable donation or a tax-deductible tithe.
            </p>
          ) : (
            <p class="church-commitment__text">
              We value the work local congregations do and welcome a conversation about the right
              scope for your facilities.
            </p>
          )}
          <div class="field">
            <label for="fac-partnership">More than a cleaning relationship (optional)</label>
            <p class="hint">
              We'd welcome conversations about community service, volunteering and ways we might
              support one another's work. Nothing here affects your estimate or discount.
            </p>
            <div class="option-grid option-grid--2">
              {CHURCH_PARTNERSHIP_OPTIONS.map((option) => (
                <label class="option">
                  <input type="checkbox" name={option.value} value="yes" />
                  <span class="option__control"></span>
                  <span><span class="option__label">{option.label}</span></span>
                </label>
              ))}
            </div>
          </div>
        </div>
      )
    }

    <div class="field-row field-row--2">
      <div class="field">
        <label for="fac-phone">Phone</label>
        <input class="input" id="fac-phone" name="phone" type="tel" autocomplete="tel" required />
      </div>
      <div class="field">
        <label for="fac-email">Email</label>
        <input class="input" id="fac-email" name="email" type="email" autocomplete="email" required />
      </div>
    </div>

    <div class="facility-review" data-facility-review aria-live="polite">
      <h3 class="facility-review__title">Your request summary</h3>
      <ul class="summary-list" data-facility-review-lines>
        <li>Choose your facility details to see the summary.</li>
      </ul>
      <p class="facility-review__note" data-facility-review-note>
        {numericEstimatesEnabled
          ? 'A preliminary estimate based on the scope you entered. Pay Now is offered only when the address, photos, time and resources verify.'
          : 'This is a scope-review request. We will confirm the scope and price with you.'}
      </p>
    </div>

    <BookingPicker id={`${engine}-booking`} />
    <PhotoUploadSection engine={engine} />
    <TermsAcceptance id={`${engine}-terms`} />
    <TurnstileWidget />
    <div class="honeypot" aria-hidden="true">
      <input
        id="fac-extra-ref"
        name="extra_ref"
        type="text"
        tabindex="-1"
        autocomplete="off"
        data-lpignore="true"
        data-1p-ignore
        data-bwignore
        data-protonpass-ignore
      />
    </div>

  </section>

  <div class="facility-form__actions">
    <button class="btn btn--secondary" type="button" data-facility-back hidden>
      <Icon name="arrow-right" size={18} class="facility-back-icon" /> Back
    </button>
    <button class="btn btn--primary" type="button" data-facility-next>
      Continue <Icon name="arrow-right" size={18} />
    </button>
    <button class="btn btn--secondary btn--small" type="submit" data-facility-submit data-cta={church ? 'church-submit' : 'commercial-submit'} hidden>
      Request to Reserve This Cleaning (Pay Later)
    </button>
    <button class="btn btn--success btn--large" type="button" data-facility-pay-now hidden>
      Pay Now and Reserve This Cleaning
    </button>
    <button class="btn btn--secondary btn--large btn--block" type="button" data-facility-verify-address hidden>
      Verify Address &amp; Finalize Price
    </button>
    <div class="field" data-facility-gift hidden>
      <label for={`${engine}-gift-code`}>
        Gift certificate code <span class="text-muted">(optional)</span>
      </label>
      <input
        class="input"
        id={`${engine}-gift-code`}
        name="gift_code"
        type="text"
        autocomplete="off"
        autocapitalize="characters"
        spellcheck="false"
        maxlength="20"
        placeholder="SSGC-XXXX-XXXX"
        data-facility-gift-code
      />
      <p class="small text-muted">
        We will apply the certificate's available balance. Any remaining balance is paid securely.
      </p>
    </div>

