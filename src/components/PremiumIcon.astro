---
// White-tile premium icon collection (owner-supplied 2026-10-25).
// The 17 raster tiles are used verbatim; never recolour, crop or replace the
// white tile background. PNG masters live in the local master asset archive;
// the WebP files here are the optimized web renditions.
//
// The full semantic registry lives in src/lib/premium-icons.ts. Adjacent text
// already names each concept in every current placement, so icons are
// decorative by default. Pass `label` only when the icon alone carries meaning.

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { PremiumIconName } from '../lib/premium-icons.ts';

import residentialCleaning from '../assets/icons/white-tile/01_residential-cleaning.webp';
import deepCleaning from '../assets/icons/white-tile/02_deep-cleaning.webp';
import moveInMoveOut from '../assets/icons/white-tile/03_move-in-move-out.webp';
import strTurnover from '../assets/icons/white-tile/04_str-turnover.webp';
import commercialCleaning from '../assets/icons/white-tile/05_commercial-cleaning.webp';
import churchCleaning from '../assets/icons/white-tile/06_church-cleaning.webp';
import communitySupport from '../assets/icons/white-tile/07_community-support.webp';
import readReviews from '../assets/icons/white-tile/08_read-reviews.webp';
import locallyOwned from '../assets/icons/white-tile/09_locally-owned.webp';
import christianValues from '../assets/icons/white-tile/10_christian-values.webp';
import flexibleScheduling from '../assets/icons/white-tile/11_flexible-scheduling.webp';
import competitivePricing from '../assets/icons/white-tile/12_competitive-pricing.webp';
import seniors from '../assets/icons/white-tile/13_seniors.webp';
import firstResponders from '../assets/icons/white-tile/14_first-responders.webp';
import militaryVeterans from '../assets/icons/white-tile/15_military-veterans.webp';
import disabilitySupport from '../assets/icons/white-tile/16_disability-support.webp';
import otherCommunity from '../assets/icons/white-tile/17_other-community.webp';

const ART: Record<PremiumIconName, ImageMetadata> = {
  'recurring-residential': residentialCleaning,
  'deep-cleaning': deepCleaning,
  'move-in-move-out': moveInMoveOut,
  'short-term-rental': strTurnover,
  'commercial-cleaning': commercialCleaning,
  'church-cleaning': churchCleaning,
  'community-support': communitySupport,
  'read-reviews': readReviews,
  'locally-owned': locallyOwned,
  'christian-values': christianValues,
  'flexible-scheduling': flexibleScheduling,
  'competitive-pricing': competitivePricing,
  seniors,
  'first-responders': firstResponders,
  'military-veterans': militaryVeterans,
  'disability-support': disabilitySupport,
  'other-community': otherCommunity,
};

interface Props {
  name: PremiumIconName;
  /** Rendered width and height in CSS rem. */
  size?: number;
  /** Extra classes for the wrapper. */
  class?: string;
  /** Accessible label; omit when adjacent text already names the concept. */
  label?: string;
}

const { name, size = 5, class: className = '', label } = Astro.props;
const art = ART[name];
const pixels = Math.max(24, Math.round(size * 16));
---

<span
  class:list={['premium-icon', className]}
  style={`width:${size}rem;height:${size}rem;`}
  aria-hidden={label ? undefined : 'true'}
>
  <Image
    src={art}
    alt={label ?? ''}
    width={pixels}
    height={pixels}
    widths={[pixels, Math.min(pixels * 2, 384)]}
    sizes={`${size}rem`}
    loading="lazy"
    decoding="async"
    class="premium-icon__image"
  />
</span>
