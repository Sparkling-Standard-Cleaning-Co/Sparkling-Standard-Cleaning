---
// Social platform glyphs in each platform's official colors.
//
// Geometry sources:
//  - Simple Icons (https://simpleicons.org, CC0 1.0) for most glyphs — the
//    official logo shapes, used unmodified.
//  - Official brand assets for marks Simple Icons does not carry:
//    Nextdoor (nextdoor.com/favicon.svg — the house "n" app mark),
//    Gab (gab.com/mask-icon.svg), Parler (parler.com/icons/parler-social.svg)
//    and Locals (locals.com/assets/logo/logo-on-light-bg.svg). These are used
//    solely to identify and link to the owner's official profiles.
//  - LinkedIn is no longer published in Simple Icons; its glyph is the
//    standard "in" mark already used on this site.
// The glyph is decorative: the visible platform label carries the meaning, so
// the SVG is aria-hidden. Only rendered when a real profile URL is configured
// (see business.socials) — never invent a platform or a handle.

import type { SocialName } from '../lib/icons';

interface Props {
  name: SocialName;
  size?: number;
  class?: string;
}

const { name, size = 22, class: className } = Astro.props;

interface SocialGlyph {
  color: string;
  path?: string;
  knockout?: string;
  monogram?: string;
  /** Official viewBox when it differs from the 24×24 default. */
  viewBox?: string;
  /** Official multi-shape mark (inner SVG with its own fills) where one path
   *  cannot represent the logo faithfully. Used verbatim, never redrawn. */
  markup?: string;
}

