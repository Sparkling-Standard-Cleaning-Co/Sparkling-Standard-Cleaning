const icon = icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox={icon.viewBox ?? '0 0 24 24'}
  fill={icon.color}
  class={className}
  aria-hidden="true"
  focusable="false"
>
  {icon.markup && <Fragment set:html={icon.markup} />}
  {!icon.markup && icon.path && <path d={icon.path}></path>}
  {!icon.markup && icon.knockout && <path d={icon.knockout} fill="#ffffff"></path>}
  {
    !icon.markup && icon.monogram && (
      <>
        <rect x="1.5" y="1.5" width="21" height="21" rx="6" fill={icon.color}></rect>
        <text
          x="12"
          y="16.5"
          text-anchor="middle"
          font-family="Nunito Sans, system-ui, sans-serif"
          font-size="12.5"
          font-weight="700"
          fill="#ffffff">{icon.monogram}</text>
      </>
    )
  }
</svg>
