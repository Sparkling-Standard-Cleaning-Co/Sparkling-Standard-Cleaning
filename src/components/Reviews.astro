---
// Customer reviews — renders ONLY genuine entries from src/content/reviews/.
// Never fabricate reviews, never invent star ratings or counts. Public
// attributions are first names only (Initiative 5.0); provenance lives in
// owner records, not in published markup.
//
// Presentation: an editorial layered stage. The active review sits in a
// prominent center card; its neighbours sit slightly recessed behind it at
// both sides, still fully readable. Progressively enhanced: without
// JavaScript every review renders as a readable stacked card. No autoplay,
// no third-party carousel library.

import { getCollection } from 'astro:content';
import GoogleG from './GoogleG.astro';
import Icon from './Icon.astro';
import { business, isPending } from '../config/business';

interface Props {
  heading?: string;
  eyebrow?: string;
}

const { heading = 'Kind Words From Our Customers', eyebrow = 'Reviews' } = Astro.props;

const reviews = (await getCollection('reviews')).sort((a, b) => a.data.order - b.data.order);
const profileUrl = isPending(business.reviews.profileUrl) ? null : business.reviews.profileUrl;
const total = reviews.length;

// Split authentic wording into readable paragraphs on blank lines. The quote
// itself is never edited, truncated or "improved" — only whitespace between
// paragraphs is normalized for presentation.
const paragraphsOf = (quote: string): string[] =>
  quote
    .split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter((paragraph) => paragraph.length > 0);
---

{
  total > 0 ? (
    <section class="section section--alt" id="reviews" aria-labelledby="reviews-heading">
      <div class="container">
        <div class="section-head section-head--center reviews-head">
          <p class="eyebrow">{eyebrow}</p>
          <h2 id="reviews-heading">{heading}</h2>
        </div>
      </div>

      <div class="review-carousel" data-review-carousel>
        <div
          class="review-carousel__stage"
          role="group"
          aria-roledescription="carousel"
          aria-label="Customer reviews"
        >
          {reviews.map((review, index) => {
            const paragraphs = paragraphsOf(review.data.quote);
            return (
              <blockquote
                class="review-carousel__card"
                data-review-card
                data-index={String(index)}
                role="group"
                aria-roledescription="slide"
                aria-label={`Review ${index + 1} of ${total}${review.data.author ? ` — ${review.data.author}` : ''}`}
                aria-current={index === 0 ? 'true' : undefined}
              >
                <div class="review-carousel__stars">
                  {review.data.rating ? (
                    <p
                      class="review-card__stars"
                      role="img"
                      aria-label={`Rated ${review.data.rating} out of 5 stars`}
                    >
                      {Array.from({ length: review.data.rating }).map(() => (
                        <Icon name="star" size={17} />
                      ))}
                    </p>
                  ) : (
                    <p class="review-card__stars review-card__stars--unrated">
                      <span class="visually-hidden">Rating not published</span>
                      <span aria-hidden="true">Google review</span>
                    </p>
                  )}
                </div>

                <div class="review-carousel__quote">
                  {paragraphs.map((paragraph, paragraphIndex) => (
                    <p>
                      {paragraphIndex === 0 ? '“' : ''}
                      {paragraph}
                      {paragraphIndex === paragraphs.length - 1 ? '”' : ''}
                    </p>
                  ))}
                </div>

                <footer class="review-carousel__footer">
                  <strong>{review.data.author}</strong>
                  <span class="review-carousel__meta">
                    {review.data.source === 'google' ? 'Google review' : 'Customer review'}
                  </span>
                </footer>
              </blockquote>
            );
          })}
        </div>

        <div class="review-carousel__controls">
          <button type="button" class="review-carousel__arrow" data-review-prev aria-label="Previous review">
            <Icon name="arrow-right" size={19} class="review-carousel__arrow-icon--prev" />
          </button>
          <div class="review-carousel__dots" role="group" aria-label="Choose a review">
            {reviews.map((_review, index) => (
              <button
                type="button"
                class="review-carousel__dot"
                data-review-dot
                data-index={String(index)}
                aria-label={`Show review ${index + 1} of ${total}`}
                aria-pressed={index === 0 ? 'true' : 'false'}
              />
            ))}
          </div>
          <button type="button" class="review-carousel__arrow" data-review-next aria-label="Next review">
            <Icon name="arrow-right" size={19} />
          </button>
        </div>
        <p class="visually-hidden" aria-live="polite" data-review-status></p>
      </div>

      {profileUrl && (
        <div class="container">
          <p class="reviews-more">
            <a
              href={profileUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Read all our reviews on Google (opens in a new tab)"
              data-review-link="google"
              data-cta="reviews-read-google"
            >
              <GoogleG size={18} /> Read all our reviews on Google
            </a>
          </p>
        </div>
      )}
    </section>
  ) : (
    profileUrl && (
      <section class="section section--alt" id="reviews" aria-labelledby="reviews-heading">
        <div class="container container--narrow">
          <div class="section-head section-head--center">
            <p class="eyebrow">{eyebrow}</p>
            <h2 id="reviews-heading">{heading}</h2>
          </div>
          <div class="reviews-invite">
            <span class="reviews-invite__mark" aria-hidden="true">
              <GoogleG />
            </span>
            <p class="reviews-invite__text">
              Every authentic review — good or critical — lives right on our Google profile.
            </p>
            <a
              class="btn btn--secondary btn--large"
              href={profileUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Read our reviews on Google (opens in a new tab)"
              data-review-link="google"
              data-cta="reviews-read-google"
            >
              Read Our Google Reviews
            </a>
          </div>
        </div>
      </section>
    )
  )
}

<script>
  // Editorial review stage — progressive enhancement, no dependencies.
  // Without JS all reviews remain readable in normal flow. With JS the active
  // review sits center stage and its neighbours are recessed left and right.
  // Navigation: card click, previous/next buttons, dots, arrow keys, swipe.
  const root = document.querySelector<HTMLElement>('[data-review-carousel]');
  const cards = [...(root?.querySelectorAll<HTMLElement>('[data-review-card]') ?? [])];
  if (root && cards.length > 1) {
    const prev = root.querySelector<HTMLButtonElement>('[data-review-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-review-next]');
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-review-dot]')];
    const status = root.querySelector<HTMLElement>('[data-review-status]');
    const total = cards.length;
    let active = 0;

    const offsetOf = (index: number): number => {
      let distance = (index - active + total) % total;
      if (distance > total / 2) distance -= total;
      return distance;
    };

    const update = (announce: boolean): void => {
      for (const card of cards) {
        const index = Number(card.dataset.index ?? '0');
        const offset = offsetOf(index);
        card.dataset.offset = String(offset);
        if (offset === 0) card.setAttribute('aria-current', 'true');
        else card.removeAttribute('aria-current');
      }
      for (const dot of dots) {
        dot.setAttribute('aria-pressed', dot.dataset.index === String(active) ? 'true' : 'false');
      }
      if (announce && status) {
        const author = cards[active]?.querySelector('footer strong')?.textContent?.trim() ?? '';
        status.textContent = `Review ${active + 1} of ${total}${author ? ` — ${author}` : ''}`;
      }
    };

    const go = (target: number, announce = true): void => {
      active = ((target % total) + total) % total;
      update(announce);
    };

    prev?.addEventListener('click', () => go(active - 1));
    next?.addEventListener('click', () => go(active + 1));
    for (const dot of dots) {
      dot.addEventListener('click', () => {
        if (dot.dataset.index !== undefined) go(Number(dot.dataset.index));
      });
    }
    for (const card of cards) {
      card.addEventListener('click', () => {
        const index = Number(card.dataset.index ?? '0');
        if (index !== active) {
          go(index);
          // Keep keyboard control available after a pointer click on a slide.
          root.focus({ preventScroll: true });
        }
      });
    }
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(active - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(active + 1);
      }
    });

    // Light horizontal swipe support (vertical scrolling always wins).
    let startX = 0;
    let startY = 0;
    let tracking = false;
    const stage = root.querySelector<HTMLElement>('.review-carousel__stage');
    stage?.addEventListener(
      'touchstart',
      (event) => {
        const touch = event.touches[0];
        if (!touch) return;
        startX = touch.clientX;
        startY = touch.clientY;
        tracking = true;
      },
      { passive: true },
    );
    stage?.addEventListener(
      'touchend',
      (event) => {
        if (!tracking) return;
        tracking = false;
        const touch = event.changedTouches[0];
        if (!touch) return;
        const dx = touch.clientX - startX;
        const dy = touch.clientY - startY;
        if (Math.abs(dx) > 44 && Math.abs(dx) > Math.abs(dy) * 1.4) {
          go(active + (dx < 0 ? 1 : -1));
        }
      },
      { passive: true },
    );

    update(false);
    root.tabIndex = -1;
    root.dataset.enhanced = 'true';
  }
</script>
