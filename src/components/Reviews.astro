---
// Customer reviews — renders ONLY genuine entries from src/content/reviews/.
// Never fabricate reviews, never invent star ratings or counts (directive
// §43, §56, §77). The two live Google reviews were supplied verbatim by the
// owner on 2026-10-23; more entries render automatically as they are added.
//
// When entries exist, the section also links to the actual Google reviews
// destination (the owner-supplied, verified Maps URL from business.ts).

import { getCollection } from 'astro:content';
import GoogleG from './GoogleG.astro';
import Icon from './Icon.astro';
import { business, isPending } from '../config/business';

interface Props {
  heading?: string;
  eyebrow?: string;
}

const { heading = 'Kind Words From Our Customers', eyebrow = 'Reviews' } = Astro.props;

const reviews = (await getCollection('reviews')).sort((a, b) => a.data.order - b.data.order);
const profileUrl = isPending(business.reviews.profileUrl) ? null : business.reviews.profileUrl;
---

{
  reviews.length > 0 ? (
    <section class="section section--alt" id="reviews" aria-labelledby="reviews-heading">
      <div class="container">
        <div class="section-head section-head--center">
          <p class="eyebrow">{eyebrow}</p>
          <h2 id="reviews-heading">{heading}</h2>
        </div>
        <div class:list={['grid', reviews.length === 2 ? 'grid--2' : 'grid--3']}>
          {reviews.map((review) => (
            <blockquote class="card review-card">
              {review.data.rating && (
                <p class="review-card__stars" role="img" aria-label={`Rated ${review.data.rating} out of 5 stars`}>
                  {Array.from({ length: review.data.rating }).map(() => (
                    <Icon name="star" size={16} />
                  ))}
                </p>
              )}
              <p>“{review.data.quote}”</p>
              <footer class="small text-muted">
                <strong>{review.data.author}</strong>
                {review.data.context ? ` — ${review.data.context}` : ''}
                {review.data.source === 'google' ? ' · Google review' : ''}
              </footer>
            </blockquote>
          ))}
        </div>
        {profileUrl && (
          <p class="reviews-more">
            <a
              href={profileUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Read all our reviews on Google (opens in a new tab)"
              data-review-link="google"
              data-cta="reviews-read-google"
            >
              <GoogleG size={18} /> Read all our reviews on Google
            </a>
          </p>
        )}
      </div>
    </section>
  ) : (
    profileUrl && (
      <section class="section section--alt" id="reviews" aria-labelledby="reviews-heading">
        <div class="container container--narrow">
          <div class="section-head section-head--center">
            <p class="eyebrow">{eyebrow}</p>
            <h2 id="reviews-heading">{heading}</h2>
          </div>
          <div class="reviews-invite">
            <span class="reviews-invite__mark" aria-hidden="true">
              <GoogleG />
            </span>
            <p class="reviews-invite__text">
              Every authentic review — good or critical — lives right on our Google profile.
            </p>
            <a
              class="btn btn--secondary btn--large"
              href={profileUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Read our reviews on Google (opens in a new tab)"
              data-review-link="google"
              data-cta="reviews-read-google"
            >
              Read Our Google Reviews
            </a>
          </div>
        </div>
      </section>
    )
  )
}
