---
import TurnstileWidget from './TurnstileWidget.astro';
import {
  CAREER_BRANCHES,
  CAREER_EXPERIENCE_LEVELS,
  CAREER_ROLES,
  CAREER_TRANSPORT,
} from '../lib/careers.ts';
---

<section class="section section--tight" id="application">
  <div class="container container--narrow">
    <div class="section-head">
      <p class="eyebrow">Application</p>
      <h2>Tell us about your work.</h2>
      <p class="lead">Experienced professional cleaners and entry-level applicants are welcome. We review every application against the current hiring need and will be direct about what is available.</p>
    </div>
    <form class="form-card" data-careers-form enctype="multipart/form-data" novalidate>
      <div class="form-grid">
        <label>Name <input class="input" name="name" autocomplete="name" required maxlength="120" /></label>
        <label>Email <input class="input" name="email" type="email" autocomplete="email" required maxlength="200" /></label>
        <label>Phone <input class="input" name="phone" type="tel" autocomplete="tel" required maxlength="40" /></label>
        <label>Experience
          <select class="select" name="experience_level" required>
            <option value="">Choose one</option>
            {CAREER_EXPERIENCE_LEVELS.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </label>
        <label>Desired role
          <select class="select" name="desired_role" required>
            <option value="">Choose one</option>
            {CAREER_ROLES.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </label>
        <label>Preferred branch
          <select class="select" name="branch_preference" required>
            <option value="">Choose one</option>
            {CAREER_BRANCHES.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </label>
        <label>Transportation
          <select class="select" name="transportation" required>
            <option value="">Choose one</option>
            {CAREER_TRANSPORT.map((option) => <option value={option.value}>{option.label}</option>)}
          </select>
        </label>
        <label>Driver's license
          <select class="select" name="driver_license">
            <option value="prefer_not_to_say">Prefer not to say</option>
            <option value="yes">Yes</option>
            <option value="no">No</option>
          </select>
        </label>
        <label class="form-field--wide">Availability
          <textarea class="textarea" name="availability" rows="3" required maxlength="800" placeholder="Days, times, and any scheduling limits."></textarea>
        </label>
        <label class="form-field--wide">Resume (optional, PDF or DOCX, max 5 MB)
          <input class="input" name="resume" type="file" accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document" />
        </label>
      </div>
      <p class="small text-muted">Do not upload a Social Security number, driver's license image, banking information or medical records. We will request any needed onboarding documents through the approved process.</p>
      <TurnstileWidget />
      <label class="check"><input type="checkbox" name="consent" value="yes" required /> I agree that Sparkling Standard may use this application to evaluate me for current or future cleaning work and may contact me about it. See the <a href="/privacy/">privacy policy</a>.</label>
      <button class="btn btn--primary btn--large" type="submit">Submit Application</button>
      <p class="form-status" data-careers-status role="status" aria-live="polite"></p>
    </form>
    <div data-careers-result hidden></div>

    <details class="form-card" id="status" style="margin-top:1.5rem;">
      <summary><strong>Check an application status</strong></summary>
      <form class="form-card" data-career-status-form style="border:0;box-shadow:none;padding:1rem 0 0;">
        <div class="form-grid">
          <label>Application reference <input class="input" name="reference" placeholder="APP-20261120-ABC123" required maxlength="40" /></label>
          <label>Email used <input class="input" name="email" type="email" required maxlength="200" /></label>
        </div>
        <button class="btn btn--secondary" type="submit">Check Status</button>
        <p class="form-status" data-career-status-result role="status" aria-live="polite"></p>
      </form>
    </details>
  </div>
</section>

<script>
  import { waitForTurnstileToken } from '../lib/forms/submit';
  const form = document.querySelector<HTMLFormElement>('[data-careers-form]');
  const result = document.querySelector<HTMLElement>('[data-careers-result]');
  const status = document.querySelector<HTMLElement>('[data-careers-status]');
  const statusForm = document.querySelector<HTMLFormElement>('[data-career-status-form]');
  const statusResult = document.querySelector<HTMLElement>('[data-career-status-result]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (status) { status.textContent = 'Submitting application...'; status.dataset.kind = 'info'; }
    const data = new FormData(form);
    if (data.get('consent') !== 'yes') {
      if (status) { status.textContent = 'Please agree to the application privacy terms.'; status.dataset.kind = 'error'; }
      return;
    }
    const token = await waitForTurnstileToken();
    if (token) data.set('turnstile_token', token);
    try {
      const response = await fetch('/api/careers-application', { method: 'POST', body: data });
      const body = await response.json().catch(() => ({}));
      if (!response.ok || body.ok !== true) {
        const messages: Record<string, string> = {
          verification_failed: 'Please complete the verification and try again.',
          rate_limited: 'Too many attempts. Please wait and try again later.',
          resume_format_invalid: 'The resume must be a PDF or DOCX file.',
          resume_too_large: 'The resume must be 5 MB or smaller.',
          resume_storage_not_configured: 'Resume upload is unavailable right now. You may apply without a resume and email it to the hiring team.',
          applicant_contact_invalid: 'Check your name, email and phone number.',
          application_fields_invalid: 'Complete every required application question.',
        };
        throw new Error(messages[String(body.error ?? '')] ?? 'The application could not be submitted. Please try again.');
      }
      form.hidden = true;
      if (result) {
        result.hidden = false;
        const reference = String(body.reference ?? '');
        result.innerHTML = '<div class="form-success"><h3>Application received</h3><p>Your reference is <strong>' + reference + '</strong>. The hiring team will review your application against the current need. This is not an offer or a promise of work.</p><p><a href="#status">Check your application status</a></p></div>';
      }
      if (status) status.textContent = '';
    } catch (error) {
      if (status) { status.textContent = error instanceof Error ? error.message : 'The application could not be submitted.'; status.dataset.kind = 'error'; }
    }
  });

  statusForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(statusForm);
    const reference = String(data.get('reference') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    if (statusResult) statusResult.textContent = 'Checking...';
    try {
      const response = await fetch('/api/careers-status?reference=' + encodeURIComponent(reference) + '&email=' + encodeURIComponent(email));
      const body = await response.json().catch(() => ({}));
      if (!response.ok || body.ok !== true) throw new Error('No application matched that reference and email.');
      if (statusResult) {
        statusResult.textContent = 'Application ' + body.reference + ': ' + String(body.status).replaceAll('_', ' ') + '.';
        statusResult.dataset.kind = 'success';
      }
    } catch (error) {
      if (statusResult) { statusResult.textContent = error instanceof Error ? error.message : 'Status could not be checked.'; statusResult.dataset.kind = 'error'; }
    }
  });
</script>
