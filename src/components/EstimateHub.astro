---
// The estimate hub — ONE service-selection surface shared by every estimate
// entry point. Cards are ordinary links so they work without JavaScript and
// keep the chosen engine in the URL.
import PremiumIcon from './PremiumIcon.astro';
import type { EstimateEngine } from '../lib/estimate/engines';
import { ESTIMATE_ENGINES, engineEstimateHref } from '../lib/estimate/engines';
import type { PremiumIconName } from '../lib/premium-icons';

interface Props {
  current?: EstimateEngine;
}

const { current } = Astro.props;

const iconFor: Record<EstimateEngine, PremiumIconName> = {
  residential: 'recurring-residential',
  commercial: 'commercial-cleaning',
  str: 'short-term-rental',
  church: 'church-cleaning',
};

// Preserve campaign/attribution context when moving from the hub into an
// engine. Residential-specific state (service, frequency, supportive, promo)
// only follows the Residential card; UTMs and ad click ids follow every card.
const ATTRIBUTION_KEYS = [
  'utm_source',
  'utm_medium',
  'utm_campaign',
  'utm_content',
  'utm_term',
  'utm_id',
  'gclid',
  'gbraid',
  'wbraid',
  'fbclid',
  'msclkid',
] as const;
const RESIDENTIAL_KEYS = ['service', 'frequency', 'supportive', 'promo'] as const;

function hrefFor(engine: EstimateEngine): string {
  const residential = engine === 'residential';
  const extra: Record<string, string | null> = {};
  for (const key of ATTRIBUTION_KEYS) extra[key] = Astro.url.searchParams.get(key);
  if (residential) {
    for (const key of RESIDENTIAL_KEYS) extra[key] = Astro.url.searchParams.get(key);
  }
  return engineEstimateHref(engine, residential ? Astro.url.searchParams.get('service') : null, extra);
}
---

<section class="estimate-hub" aria-labelledby="estimate-hub-heading">
  <div class="section-head">
    <p class="eyebrow">Instant estimate</p>
    <h2 id="estimate-hub-heading">What would you like us to clean?</h2>
    <p class="lead">
      Choose the option that fits your space. Each path asks only what matters for that kind of
      cleaning — and nothing else.
    </p>
  </div>

  <div class="estimate-hub__grid">
    {
      ESTIMATE_ENGINES.map((engine) => (
        <a
          class:list={['estimate-hub__card', current === engine.id && 'estimate-hub__card--current']}
          href={hrefFor(engine.id)}
          data-estimate-engine={engine.id}
          aria-current={current === engine.id ? 'true' : undefined}
        >
          <span class="estimate-hub__icon">
            <PremiumIcon name={iconFor[engine.id]} />
          </span>
          <span class="estimate-hub__body">
            <span class="estimate-hub__label">{engine.label}</span>
            <span class="estimate-hub__desc">{engine.description}</span>
            <span class="estimate-hub__includes">{engine.includes}</span>
          </span>
          <span class="estimate-hub__cta">
            {current === engine.id ? 'Selected' : engine.ctaLabel}
            <span aria-hidden="true">→</span>
          </span>
        </a>
      ))
    }
  </div>
</section>

<script>
  // Preserve campaign/attribution context when a visitor chooses an engine.
  // The static build cannot know the request query, so this runs in the browser
  // and only appends allowlisted values to each card's clean fallback href.
  const hubParams = new URLSearchParams(window.location.search);
  const attributionKeys = [
    'utm_source',
    'utm_medium',
    'utm_campaign',
    'utm_content',
    'utm_term',
    'utm_id',
    'gclid',
    'gbraid',
    'wbraid',
    'fbclid',
    'msclkid',
  ];
  const residentialKeys = ['service', 'frequency', 'supportive', 'promo'];
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-estimate-engine]')) {
    const href = link.getAttribute('href');
    if (!href) continue;
    const url = new URL(href, window.location.origin);
    for (const key of attributionKeys) {
      const value = hubParams.get(key);
      if (value) url.searchParams.set(key, value);
    }
    if (link.dataset.estimateEngine === 'residential') {
      for (const key of residentialKeys) {
        const value = hubParams.get(key);
        if (value) url.searchParams.set(key, value);
      }
    }
    link.setAttribute('href', `${url.pathname}${url.search}${url.hash}`);
  }
</script>
