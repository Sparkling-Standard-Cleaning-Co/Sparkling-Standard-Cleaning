---
import { pricing } from '../config/pricing';
import { business, contactPhone, isPending } from '../config/business';
import { ESTIMATE_STEPS } from '../lib/estimate/steps';
import { US_STATES } from '../lib/location/location';
import Icon from './Icon.astro';
import TurnstileWidget from './TurnstileWidget.astro';
import ResponseGuarantee from './ResponseGuarantee.astro';
import { isFormEnabled } from '../config/business';

const configured = isFormEnabled();
const addons = pricing.addons.items;
const preview = import.meta.env.PUBLIC_PREVIEW_MODE === 'true';
const phone = contactPhone();
const email = isPending(business.email) ? null : business.email;
const smsEnabled = business.flags.smsEnabled;
const incentiveEnabled = pricing.addonIncentive.enabled.value;
const stepTitle = (index: number): string => ESTIMATE_STEPS[index]?.title ?? '';
---

<div class="estimate-layout split split--sidebar">
  <form class="wizard" id="estimate-form" data-estimate-form action="#" method="post" autocomplete="off" novalidate>
    <div class="wizard__progress">
      <nav class="wizard-steps" data-wizard-steps aria-label="Estimate steps">
        <ol class="wizard-steps__list">
          {
            ESTIMATE_STEPS.map((step, index) => (
              <li class="wizard-steps__item" data-step-item={index + 1} data-state={index === 0 ? 'current' : 'upcoming'}>
                <button
                  type="button"
                  class="wizard-steps__button"
                  data-step-jump={index + 1}
                  aria-label={`Step ${index + 1}: ${step.title}`}
                  aria-current={index === 0 ? 'step' : undefined}
                  disabled={index !== 0}
                >
                  <span class="wizard-steps__number" aria-hidden="true">{index + 1}</span>
                  <span class="wizard-steps__title">{step.title}</span>
                </button>
              </li>
            ))
          }
        </ol>
        <p class="wizard-steps__mobile-title" data-mobile-step-title>
          Step 1 of {ESTIMATE_STEPS.length} — {stepTitle(0)}
        </p>
      </nav>
      <div class="wizard__progress-bar" role="progressbar" aria-label="Estimate progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="17" data-progress-bar>
        <div class="wizard__progress-fill" data-progress-fill></div>
      </div>
      <p class="wizard__step-label">
        <span data-step-label>Step 1 of {ESTIMATE_STEPS.length} — {stepTitle(0)}</span>
        <span data-progress-percent>17%</span>
      </p>
    </div>

    <div class="wizard__body">
      {
        !configured && (
          <p class="form-status" data-state="info" style="display:block">
            Request delivery is not connected on this preview build. The estimate and reservation
            summary still work — sending this request in preview cannot deliver it{preview ? ' (preview mode)' : ''}.
          </p>
        )
      }

      <div class="error-summary" data-error-summary hidden role="alert" tabindex="-1">
        <p class="error-summary__title" data-error-summary-title>Please fix the following before continuing:</p>
        <ul data-error-summary-list></ul>
      </div>

      <div class="estimate-result" data-estimate-live hidden aria-live="polite">
        <p class="estimate-result__label" data-estimate-label>Your proposed cleaning price</p>
        <p class="estimate-result__price" data-estimate-price>—</p>
        <p class="estimate-result__range" data-estimate-range hidden></p>
        <p class="estimate-result__note" data-estimate-note></p>
        <p class="estimate-result__travel" data-estimate-travel></p>
        <p class="estimate-result__reference" data-estimate-reference hidden></p>
        <ul class="estimate-flags" data-estimate-flags></ul>
      </div>

      <!-- Step 1 — service & address -->
      <section class="wizard__step" data-step="1" data-active="true" aria-label={stepTitle(0)}>
        <h2 class="wizard__step-heading">{stepTitle(0)}</h2>
        <fieldset class="field" data-group-error="serviceType" data-group-message="Please select a cleaning service.">
          <legend>What kind of cleaning are you looking for?</legend>
          <div class="option-grid option-grid--2">
            <label class="option">
              <input type="radio" name="serviceType" value="standard" required />
              <span class="option__control"></span>
              <span>
                <span class="option__label">Standard / one-time house cleaning</span>
                <span class="option__desc">A thorough clean of a maintained home.</span>
              </span>
            </label>
            <label class="option">
              <input type="radio" name="serviceType" value="deep" required />
              <span class="option__control"></span>
              <span>
                <span class="option__label">Deep cleaning</span>
                <span class="option__desc">Detail work — baseboards, frames, buildup and more.</span>
              </span>
            </label>
            <label class="option">
              <input type="radio" name="serviceType" value="move_in_out" required />
              <span class="option__control"></span>
              <span>
                <span class="option__label">Move-in / move-out</span>
                <span class="option__desc">Empty-home cleaning built around a walkthrough.</span>
              </span>
            </label>
            <label class="option">
              <input type="radio" name="serviceType" value="str_turnover" required />
              <span class="option__control"></span>
              <span>
                <span class="option__label">Short-term rental turnover</span>
                <span class="option__desc">Guest-ready resets for Airbnb / VRBO hosts.</span>
              </span>
            </label>
          </div>
        </fieldset>

        <div class="address-finder" data-address-finder data-state="idle" data-method="manual">
          <div class="address-gps">
            <button type="button" class="btn btn--primary btn--large btn--block" data-address-gps>
              <Icon name="map-pin" size={18} /> Use My Current Location
            </button>
            <p class="hint address-gps__hint">
              Best if you are physically at the property you want cleaned. We'll use your device's
              location to find the address and ask you to confirm it — nothing is sent until you do.
            </p>

            <div class="address-permission" data-address-permission hidden>
              <p class="address-permission__title" data-permission-title>Location access is off.</p>
              <p class="hint" data-permission-message></p>
              <ol class="address-permission__steps" data-permission-steps></ol>
              <p class="hint" data-permission-retry-note hidden>
                Your browser or device controls the permission prompt. If it no longer appears,
                allow location in the settings above, then return and try again.
              </p>
              <div class="address-finder__actions">
                <button type="button" class="btn btn--secondary btn--small" data-address-gps-retry>
                  Try Location Again
                </button>
                <button type="button" class="btn btn--ghost btn--small" data-address-manual-open>
                  Enter Address Manually
                </button>
              </div>
            </div>
          </div>

          <details class="address-manual" data-address-manual-details>
            <summary class="address-manual__summary" data-address-manual-summary>
              Or enter the address manually
            </summary>
            <div class="address-manual__body">
              <div class="field-row field-row--2">
                <div class="field field--grow">
                  <label for="est-address">Street address</label>
                  <input
                    class="input"
                    id="est-address"
                    name="serviceAddress"
                    type="text"
                    autocomplete="address-line1"
                    placeholder="e.g. 123 Super Clean Way"
                    role="combobox"
                    aria-expanded="false"
                    aria-autocomplete="list"
                    aria-controls="est-address-suggestions"
                    data-error-required="Please enter your street address."
                  />
                </div>
                <div class="field field--unit">
                  <label for="est-address-unit">Apt / unit</label>
                  <input
                    class="input"
                    id="est-address-unit"
                    name="addressUnit"
                    type="text"
                    autocomplete="address-line2"
                    maxlength="30"
                    placeholder="Optional"
                  />
                </div>
              </div>

              <div class="field-row field-row--3">
                <div class="field field--grow">
                  <label for="est-address-city">City</label>
                  <input
                    class="input"
                    id="est-address-city"
                    name="addressCity"
                    type="text"
                    autocomplete="address-level2"
                    placeholder="e.g. Molino"
                  />
                </div>
                <div class="field">
                  <label for="est-address-state">State</label>
                  <select class="select" id="est-address-state" name="addressState" autocomplete="address-level1" required>
                    {US_STATES.map((state) => (
                      <option value={state.code} selected={state.code === 'FL'}>{state.name}</option>
                    ))}
                  </select>
                </div>
                <div class="field field--zip">
                  <label for="est-zip">ZIP code</label>
                  <input class="input" id="est-zip" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" placeholder="e.g. 32577" required pattern="[0-9]{5}(-[0-9]{4})?" />
                </div>
              </div>

              <ul
                class="address-suggestions"
                id="est-address-suggestions"
                role="listbox"
                aria-label="Address suggestions"
                data-address-suggestions
                hidden
              ></ul>

              <p class="hint address-finder__status" data-address-status data-kind="" aria-live="polite">
                Start typing your street address — suggestions appear as you type.
              </p>

              <div class="address-finder__actions">
                <button type="button" class="btn btn--secondary btn--small" data-address-resolve>
                  Find My Address
                </button>
              </div>
            </div>
          </details>

          <div class="address-map" data-address-map hidden>
            <div class="address-map__canvas" data-address-map-canvas></div>
            <p class="hint">
              Confirm this is the right destination, or drag the pin to correct it. The map loads
              only when you look up an address.
            </p>
            <p class="hint address-map__fallback" data-address-map-fallback hidden>
              Map preview is unavailable right now — the confirmed coordinates from your address
              still work. You can continue.
            </p>
            <div class="address-finder__actions">
              <button type="button" class="btn btn--primary btn--small" data-address-confirm>
                Confirm this location
              </button>
              <button type="button" class="btn btn--ghost btn--small" data-address-change>
                Change address
              </button>
            </div>
          </div>

          <div class="address-confirmed" data-address-confirmed hidden>
            <p class="address-confirmed__title">
              <Icon name="check" size={16} /> Destination confirmed
            </p>
            <p class="address-confirmed__label" data-address-confirmed-label></p>
            <p class="hint" data-address-confirmed-travel></p>
          </div>
        </div>
      </section>

      <!-- Step 2 — the home -->
      <section class="wizard__step" data-step="2" aria-label={stepTitle(1)}>
        <h2 class="wizard__step-heading">{stepTitle(1)}</h2>
        <div class="field">
          <label for="est-property">Property type</label>
          <select class="select" id="est-property" name="propertyType" required>
            <option value="">Choose one…</option>
            <option value="house">House</option>
            <option value="apartment">Apartment</option>
            <option value="condo">Condo</option>
            <option value="townhome">Townhome</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="field-row field-row--2">
          <div class="field">
            <label for="est-sqft">Approximate square footage</label>
            <input class="input" id="est-sqft" name="squareFeet" type="number" inputmode="numeric" min="200" max="20000" step="50" placeholder="e.g. 1600" required />
          </div>
          <div class="field">
            <label for="est-bedrooms">Bedrooms</label>
            <input class="input" id="est-bedrooms" name="bedrooms" type="number" inputmode="numeric" min="0" max="12" required />
          </div>
        </div>
        <div class="field-row field-row--2">
          <div class="field">
            <label for="est-full-baths">Full bathrooms</label>
            <input class="input" id="est-full-baths" name="fullBaths" type="number" inputmode="numeric" min="0" max="12" required />
          </div>
          <div class="field">
            <label for="est-half-baths">Half bathrooms</label>
            <input class="input" id="est-half-baths" name="halfBaths" type="number" inputmode="numeric" min="0" max="12" value="0" required />
          </div>
        </div>
        <div class="field" data-str-only hidden>
          <label for="est-beds">Beds to reset (turnovers)</label>
          <input class="input" id="est-beds" name="beds" type="number" inputmode="numeric" min="1" max="30" />
          <span class="hint">Each bed gets fresh linens and a full reset.</span>
        </div>
      </section>

      <!-- Step 3 — condition + frequency -->
      <section class="wizard__step" data-step="3" aria-label={stepTitle(2)}>
        <h2 class="wizard__step-heading">{stepTitle(2)}</h2>
        <div class="field">
          <label for="est-frequency">How often should we clean?</label>
          <select class="select" id="est-frequency" name="frequency" required>
            <option value="">Choose one…</option>
            <option value="weekly">Weekly</option>
            <option value="biweekly">Every two weeks</option>
            <option value="monthly">Monthly</option>
            <option value="one_time">One-time</option>
          </select>
          <span class="hint">Recurring homes stay more maintainable, so per-visit value improves.</span>
        </div>
        <fieldset class="field" data-group-error="condition" data-group-message="Please choose the home's current condition.">
          <legend>What condition is the home in today?</legend>
          <div class="option-grid">
            <label class="option">
              <input type="radio" name="condition" value="maintained" required />
              <span class="option__control"></span>
              <span><span class="option__label">Maintained</span><span class="option__desc">Cleaned regularly; generally in good shape.</span></span>
            </label>
            <label class="option">
              <input type="radio" name="condition" value="average" required />
              <span class="option__control"></span>
              <span><span class="option__label">Average</span><span class="option__desc">Normal lived-in buildup.</span></span>
            </label>
            <label class="option">
              <input type="radio" name="condition" value="needs_attention" required />
              <span class="option__control"></span>
              <span><span class="option__label">Needs attention</span><span class="option__desc">Overdue for a good clean.</span></span>
            </label>
            <label class="option">
              <input type="radio" name="condition" value="heavy" required />
              <span class="option__control"></span>
              <span><span class="option__label">Heavy buildup</span><span class="option__desc">A lot of catching up to do.</span></span>
            </label>
            <label class="option">
              <input type="radio" name="condition" value="severe" required />
              <span class="option__control"></span>
              <span><span class="option__label">Severe</span><span class="option__desc">Needs an in-person review before pricing.</span></span>
            </label>
          </div>
        </fieldset>
        <div class="field">
          <label for="est-last-clean">When was the home last professionally cleaned?</label>
          <select class="select" id="est-last-clean" name="lastClean" required>
            <option value="">Choose one…</option>
            <option value="within_month">Within the last month</option>
            <option value="one_to_three_months">1–3 months ago</option>
            <option value="three_to_twelve_months">3–12 months ago</option>
            <option value="over_a_year">More than a year ago</option>
            <option value="never_professional">Never professionally cleaned</option>
            <option value="not_sure">Not sure</option>
          </select>
        </div>
        <div class="field">
          <label for="est-pets">Pets in the home</label>
          <select class="select" id="est-pets" name="pets" required>
            <option value="none">No pets</option>
            <option value="one">One pet</option>
            <option value="multiple_shedding">Multiple pets / heavy shedding</option>
          </select>
        </div>
      </section>

      <!-- Step 4 — add-ons -->
      <section class="wizard__step" data-step="4" aria-label={stepTitle(3)}>
        <h2 class="wizard__step-heading">{stepTitle(3)}</h2>
        <fieldset class="field">
          <legend>Any extras? (optional)</legend>
          <p class="hint" style="margin-bottom: var(--space-3)">
            The price beside each extra is calculated from your service and current scope — it is
            included in your proposed total when selected. Items marked “Custom quote” are priced
            individually.
          </p>
          {
            incentiveEnabled && (
              <p class="addon-incentive" data-addon-incentive>
                <Icon name="star" size={16} /> <span data-addon-incentive-text></span>
              </p>
            )
          }
          <div class="option-grid option-grid--2">
            {addons.map((addon) => (
              <label class="option option--addon">
                <input type="checkbox" name="addons" value={addon.id} />
                <span class="option__control"></span>
                <span>
                  <span class="option__label">
                    {addon.label}
                    {addon.customQuote ? (
                      <span class="option__price option__price--custom">Custom quote</span>
                    ) : (
                      <span class="option__price" data-addon-price={addon.id}>—</span>
                    )}
                  </span>
                  <span class="option__desc">{addon.blurb}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="price-preview" data-price-preview hidden>
          <h3 class="price-preview__title">Your price so far</h3>
          <ul class="summary-list" data-price-preview-lines></ul>
          <p class="price-preview__note" data-price-preview-note></p>
        </div>
      </section>

      <!-- Step 5 — scheduling -->
      <section class="wizard__step" data-step="5" aria-label={stepTitle(4)}>
        <h2 class="wizard__step-heading">{stepTitle(4)}</h2>
        <div class="field-row field-row--2">
          <div class="field">
            <label for="est-date">Preferred date</label>
            <input class="input" id="est-date" name="preferredDate" type="date" required />
          </div>
          <div class="field">
            <label for="est-arrival">Arrival preference</label>
            <select class="select" id="est-arrival" name="arrivalPreference" required>
              <option value="">Choose one…</option>
              <option value="first-appointment">First appointment of the day (exact time)</option>
              <option value="morning">Morning window</option>
              <option value="afternoon">Afternoon window</option>
              <option value="flexible">Flexible — any reasonable window</option>
            </select>
          </div>
        </div>
        <p class="small text-muted">
          Later appointments get an arrival window, not a promised exact time — we won't rush your
          home to protect a clock.
        </p>
      </section>

      <!-- Step 6 — estimate + reservation + details -->
      <section class="wizard__step" data-step="6" aria-label={stepTitle(5)}>
        <h2 class="wizard__step-heading">{stepTitle(5)}</h2>
        <div class="reservation-summary" data-reservation-summary hidden>
          <p class="reservation-summary__eyebrow">Your proposed cleaning price</p>
          <p class="reservation-summary__price" data-reservation-price>—</p>
          <p class="reservation-summary__meta" data-reservation-reference hidden></p>
          <p class="reservation-summary__meta" data-reservation-validity hidden></p>

          <ul class="summary-list price-breakdown" data-price-breakdown></ul>
          <ul class="summary-list" data-reservation-scope></ul>
          <p class="reservation-summary__qualification" data-reservation-qualification></p>

          <div class="reservation-actions">
            <p class="reservation-actions__note">
              <strong>Reserve This Cleaning</strong> sends a reservation request with all of your
              calculator details — it is not a confirmed appointment until Sparkling Standard
              confirms it.
            </p>
            <div class="reservation-actions__links">
              {phone && (
                <a class="btn btn--ghost btn--small" data-reserve-call href={phone.href}>
                  <Icon name="phone" size={16} /> Call to Reserve
                </a>
              )}
              {phone && smsEnabled && (
                <a class="btn btn--ghost btn--small" data-reserve-text href={phone.sms}>
                  <Icon name="message" size={16} /> Text to Reserve
                </a>
              )}
            </div>
          </div>
        </div>

        <div class="field-row field-row--2">
          <div class="field">
            <label for="est-name">Your name</label>
            <input class="input" id="est-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="est-phone">Phone</label>
            <input class="input" id="est-phone" name="phone" type="tel" autocomplete="tel" required />
          </div>
        </div>
        <div class="field">
          <label for="est-email">Email</label>
          <input class="input" id="est-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="est-notes">Notes (optional)</label>
          <textarea
            class="textarea"
            id="est-notes"
            name="notes"
            rows="4"
            placeholder="Anything we should know — pets, parking, priorities, photos you can share later."
          ></textarea>
        </div>
        <TurnstileWidget />
        <div class="honeypot" aria-hidden="true">
          <label for="est-company-website">Company website</label>
          <input id="est-company-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <p class="small text-muted">
          Sending this request does not book anything. Sparkling Standard reviews it, confirms the
          scope, date and final price with you, and only then is your cleaning booked. See our
          <a href="/privacy/">privacy policy</a>.
        </p>
      </section>
    </div>

    <div class="wizard__nav">
      <button class="btn btn--ghost" type="button" data-back hidden>
        <Icon name="chevron-left" size={16} /> Back
      </button>
      <span class="spacer"></span>
      <button class="btn btn--primary" type="button" data-next>Continue <Icon name="arrow-right" size={16} /></button>
      <button class="btn btn--primary btn--large" type="submit" data-submit hidden data-cta="estimate-submit">
        Reserve This Cleaning
      </button>
    </div>
    <p class="form-status" data-form-status role="status" aria-live="polite" style="margin: 0 var(--space-6) var(--space-5)"></p>
  </form>

  <aside class="stack">
    <div class="card card--muted">
      <h2 class="card__title">How the estimate works</h2>
      <p class="card__text">
        Your confirmed address sets the destination for travel. The price is built on real
        labor-time math for homes like yours — not a template price. It's a proposed price on a
        request, not a confirmed booking: Sparkling Standard confirms the final scope, price and
        timing with you first.
      </p>
    </div>

    <div class="card">
      <h3 class="card__title">After you send</h3>
      <ol class="timeline">
        <li class="timeline__stage">
          <span class="timeline__number" aria-hidden="true">1</span>
          <div class="timeline__content">
            <p class="timeline__title">Request received</p>
            <p class="timeline__text">Sparkling Standard receives your cleaning details and proposed estimate.</p>
          </div>
        </li>
        <li class="timeline__stage">
          <span class="timeline__number" aria-hidden="true">2</span>
          <div class="timeline__content">
            <p class="timeline__title">Personal confirmation</p>
            <p class="timeline__text">We'll review your requirements, confirm your final price and arrange a convenient time.</p>
          </div>
        </li>
        <li class="timeline__stage">
          <span class="timeline__number" aria-hidden="true">3</span>
          <div class="timeline__content">
            <p class="timeline__title">You're booked</p>
            <p class="timeline__text">Your appointment is confirmed, and we'll take care of the rest.</p>
          </div>
        </li>
      </ol>
    </div>

    <ResponseGuarantee />

    {
      (phone || email) && (
        <div class="card">
          <h3 class="card__title">Prefer to talk it through?</h3>
          {phone && (
            <p class="card__text">
              Call or text <a href={phone.href}>{phone.display}</a>
              {email && (
                <> — or email <a href={`mailto:${email}`}>{email}</a>.</>
              )}
            </p>
          )}
          {!phone && email && (
            <p class="card__text">
              Email <a href={`mailto:${email}`}>{email}</a>.
            </p>
          )}
        </div>
      )
    }
    <p class="small text-muted">
      Every visit to this page starts a fresh estimate, and nothing is saved in this browser. You can
      <button type="button" class="link-button" data-estimate-reset style="background:none;border:0;padding:0;color:var(--color-rose-700);text-decoration:underline;cursor:pointer;font:inherit">start over</button>
      at any time.
    </p>
  </aside>
</div>

<script>
  import '../scripts/estimate-wizard';
</script>
