---
import { pricing } from '../config/pricing';
import {
  CONDITION_OPTIONS,
  FREQUENCY_OPTIONS,
  LAST_CLEAN_OPTIONS,
  LINEN_PREFERENCE_OPTIONS,
  PET_OPTIONS,
  PROPERTY_TYPE_OPTIONS,
  RESIDENTIAL_INPUT_LIMITS,
  RESIDENTIAL_SERVICE_OPTIONS,
  TURNOVER_FREQUENCY_OPTIONS,
} from '../config/estimators/input-definitions';
import { schedulingConfig } from '../config/scheduling';
import { business, contactPhone, isPending } from '../config/business';
import { ESTIMATE_STEPS } from '../lib/estimate/steps';
import Icon from './Icon.astro';
import TurnstileWidget from './TurnstileWidget.astro';
import PhotoUploadSection from './PhotoUploadSection.astro';
import ResponseGuarantee from './ResponseGuarantee.astro';
import EstimateReveal from './EstimateReveal.astro';
import TermsAcceptance from './TermsAcceptance.astro';
import BookingCalendar from './BookingCalendar.astro';
import { isFormEnabled } from '../config/business';

const configured = isFormEnabled();
const addons = pricing.addons.items;
const addonLabels = new Map(addons.map((addon) => [addon.id, addon.label]));
const activeBundles = pricing.promotions.addonBundles.filter((bundle) => bundle.enabled);
const preview = import.meta.env.PUBLIC_PREVIEW_MODE === 'true';
const phone = contactPhone();
const email = isPending(business.email) ? null : business.email;
const smsEnabled = business.flags.smsEnabled;
const incentiveEnabled = pricing.addonIncentive.enabled.value;
const customThreeExtraEnabled = pricing.customThreeExtraBundle.enabled.value;
const customThreeExtraPercent = pricing.customThreeExtraBundle.percent.value;
const communitySupportEnabled = pricing.supportiveHomeDiscount.enabled.value;
const communitySupportPercent = pricing.supportiveHomeDiscount.percent.value;
const stepTitle = (index: number): string => ESTIMATE_STEPS[index]?.title ?? '';
---

<div class="estimate-layout split split--sidebar">
  <form class="wizard" id="estimate-form" data-estimate-form action="#" method="post" autocomplete="off" novalidate>
    <div class="wizard__progress">
      <nav class="wizard-steps" data-wizard-steps aria-label="Estimate steps">
        <ol class="wizard-steps__list">
          {
            ESTIMATE_STEPS.map((step, index) => (
              <li class="wizard-steps__item" data-step-item={index + 1} data-state={index === 0 ? 'current' : 'upcoming'}>
                <button
                  type="button"
                  class="wizard-steps__button"
                  data-step-jump={index + 1}
                  aria-label={`Step ${index + 1}: ${step.title}`}
                  aria-current={index === 0 ? 'step' : undefined}
                  disabled={index !== 0}
                >
                  <span class="wizard-steps__number" aria-hidden="true">{index + 1}</span>
                  <span class="wizard-steps__title">{step.title}</span>
                </button>
              </li>
            ))
          }
        </ol>
        <p class="wizard-steps__mobile-title" data-mobile-step-title>
          Step 1 of {ESTIMATE_STEPS.length} — {stepTitle(0)}
        </p>
      </nav>
      <div class="wizard__progress-bar" role="progressbar" aria-label="Estimate progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="17" data-progress-bar>
        <div class="wizard__progress-fill" data-progress-fill></div>
      </div>
      <p class="wizard__step-label">
        <span data-step-label>Step 1 of {ESTIMATE_STEPS.length} — {stepTitle(0)}</span>
        <span data-progress-percent>17%</span>
      </p>
    </div>

    <div class="wizard__body">
      {
        !configured && (
          <p class="form-status" data-state="info" style="display:block">
            Request delivery is not connected on this preview build. The estimate and reservation
            summary still work — sending this request in preview cannot deliver it{preview ? ' (preview mode)' : ''}.
          </p>
        )
      }

      <p class="estimate-engine-note" data-engine-note hidden></p>

      <div class="error-summary" data-error-summary hidden role="alert" tabindex="-1">
        <p class="error-summary__title" data-error-summary-title>Please fix the following before continuing:</p>
        <ul data-error-summary-list></ul>
      </div>

      <div class="estimate-result" data-estimate-live hidden aria-live="polite">
        <p class="estimate-result__label" data-estimate-label>Your proposed cleaning price</p>
        <p class="estimate-result__price" data-estimate-price>—</p>
        <p class="estimate-result__range" data-estimate-range hidden></p>
        <p class="estimate-result__ongoing" data-estimate-ongoing hidden></p>
        <p class="estimate-result__note" data-estimate-note></p>
        <p class="estimate-result__tax small text-muted" data-estimate-tax></p>
        <p class="estimate-result__travel" data-estimate-travel></p>
        <p class="estimate-result__reference" data-estimate-reference hidden></p>
        <ul class="estimate-flags" data-estimate-flags></ul>
      </div>

      <!-- Step 1 — When & Where: premium calendar first, address below -->
      <section class="wizard__step" data-step="1" data-active="true" aria-label={stepTitle(0)}>
        <h2 class="wizard__step-heading" data-step-title={0}>{stepTitle(0)}</h2>
        <p class="wizard__step-lead">Let&rsquo;s find the perfect time for your cleaning.</p>
        <p class="wizard__step-copy">
          Choose your preferred date and time, then tell us where to clean.
        </p>

        <BookingCalendar id="residential-calendar" />

        <div class="address-card" data-address-finder data-address-card data-state="idle" data-method="manual" hidden>
          <div class="address-card__head">
            <h3 class="address-card__title">Where should we clean?</h3>
            <p class="address-card__copy">
              Enter your cleaning address, including ZIP code, or use your current location.
            </p>
          </div>

          <div class="address-gps">
            <button type="button" class="btn btn--secondary btn--large btn--block" data-address-gps>
              <Icon name="map-pin" size={18} /> Find My Location
            </button>

            <div class="address-permission" data-address-permission hidden>
              <p class="address-permission__title" data-permission-title>Location access is off.</p>
              <p class="hint" data-permission-message></p>
              <ol class="address-permission__steps" data-permission-steps></ol>
              <p class="hint" data-permission-retry-note hidden>
                Your browser or device controls the permission prompt. If it no longer appears,
                allow location in the settings above, then return and try again.
              </p>
              <div class="address-finder__actions">
                <button type="button" class="btn btn--secondary btn--small" data-address-gps-retry>
                  Try Location Again
                </button>
                <button type="button" class="btn btn--ghost btn--small" data-address-manual-open>
                  Enter Address Manually
                </button>
              </div>
            </div>
          </div>

          <div class="address-manual__body">
            <div class="field-row field-row--2">
              <div class="field field--grow address-street-wrap">
                <label for="est-address">Street address</label>
                <input
                  class="input"
                  id="est-address"
                  name="serviceAddress"
                  type="text"
                  autocomplete="address-line1"
                  placeholder="e.g. 123 Super Clean Way"
                  role="combobox"
                  aria-expanded="false"
                  aria-autocomplete="list"
                  aria-controls="est-address-suggestions"
                  data-error-required="Please enter your street address."
                />
                <ul
                  class="address-suggestions"
                  id="est-address-suggestions"
                  role="listbox"
                  aria-label="Address suggestions"
                  data-address-suggestions
                  hidden
                ></ul>
              </div>
              <div class="field field--unit">
                <label for="est-address-unit">Apt / unit</label>
                <input
                  class="input"
                  id="est-address-unit"
                  name="addressUnit"
                  type="text"
                  autocomplete="address-line2"
                  maxlength="30"
                  placeholder="Optional"
                />
              </div>
            </div>


            <div data-address-details hidden>
            <div class="field-row field-row--3">
              <div class="field field--grow">
                <label for="est-address-city">City</label>
                <input
                  class="input"
                  id="est-address-city"
                  name="addressCity"
                  type="text"
                  autocomplete="address-level2"
                  placeholder="e.g. Molino"
                  required
                />
              </div>
              <div class="field">
                <label for="est-address-state">State</label>
                <select class="select" id="est-address-state" name="addressState" autocomplete="address-level1" required>
                  <option value="FL" selected>Florida (FL)</option>
                  <option value="AL">Alabama (AL)</option>
                </select>
              </div>
              <div class="field field--zip">
                <label for="est-zip">ZIP code</label>
                <input class="input" id="est-zip" name="zip" type="text" inputmode="numeric" autocomplete="postal-code" maxlength="10" placeholder="e.g. 32577" required pattern="[0-9]{5}(-[0-9]{4})?" />
              </div>
            </div>

            <div class="address-finder__actions">
              <button type="button" class="btn btn--secondary btn--small" data-address-resolve>
                Find My Address
              </button>
            </div>
            <p class="hint address-finder__status" data-address-status data-kind="" aria-live="polite"></p>
            </div>
          </div>

          <div class="address-map" data-address-map hidden>
            <div class="address-map__canvas" data-address-map-canvas></div>
            <p class="hint">Confirm this is the right destination, or drag the pin to correct it.</p>
            <label class="hint" data-pin-property-confirm-wrap hidden style="display:flex;gap:.5rem;align-items:flex-start;margin:.35rem 0;">
              <input type="checkbox" data-pin-property-confirm />
              <span>I confirm this pin is at my property.</span>
            </label>
            <p class="hint address-map__fallback" data-address-map-fallback hidden>
              Map preview is unavailable right now - the confirmed coordinates still work. You can
              continue.
            </p>
            <div class="address-finder__actions">
              <button type="button" class="btn btn--primary btn--small" data-address-confirm>
                Confirm this location
              </button>
              <button type="button" class="btn btn--ghost btn--small" data-address-change>
                Change address
              </button>
            </div>
          </div>

          <div class="address-confirmed" data-address-confirmed hidden>
            <p class="address-confirmed__title"><Icon name="check" size={16} /> Destination confirmed</p>
            <p class="address-confirmed__label" data-address-confirmed-label></p>
            <p class="hint" data-address-confirmed-travel></p>
          </div>
        </div>
      </section>

      <!-- Step 2 — Service & Home -->
      <section class="wizard__step" data-step="2" aria-label={stepTitle(1)}>
        <h2 class="wizard__step-heading" data-step-title={1}>{stepTitle(1)}</h2>
        <p class="wizard__step-copy">
          Choose the cleaning you need and tell us about the home so the estimate reflects the
          real work.
        </p>
        <fieldset class="field" data-service-fieldset data-group-error="serviceType" data-group-message="Please select a cleaning service.">
          <legend>What kind of cleaning are you looking for?</legend>
          <div class="option-grid">
            {
              RESIDENTIAL_SERVICE_OPTIONS.map((option) => (
                <label class="option">
                  <input type="radio" name="serviceType" value={option.value} required />
                  <span class="option__control"></span>
                  <span>
                    <span class="option__label">{option.label}</span>
                    <span class="option__desc">{option.description}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <div data-reveal-group="home" data-reveal-trigger="serviceType" hidden>
        <div class="field">
          <label for="est-property">Property type</label>
          <select class="select" id="est-property" name="propertyType" required>
            <option value="">Choose one…</option>
            {PROPERTY_TYPE_OPTIONS.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </div>
        <div class="field-row field-row--2">
          <div class="field">
            <label for="est-sqft">Approximate square footage</label>
            <input class="input" id="est-sqft" name="squareFeet" type="number" inputmode="numeric" min={RESIDENTIAL_INPUT_LIMITS.squareFeet.min} max={RESIDENTIAL_INPUT_LIMITS.squareFeet.max} step={RESIDENTIAL_INPUT_LIMITS.squareFeet.step} placeholder="e.g. 1600" required />
          </div>
          <div class="field">
            <label for="est-bedrooms">Bedrooms</label>
            <input class="input" id="est-bedrooms" name="bedrooms" type="number" inputmode="numeric" min={RESIDENTIAL_INPUT_LIMITS.bedrooms.min} max={RESIDENTIAL_INPUT_LIMITS.bedrooms.max} required />
          </div>
        </div>
        <div class="field-row field-row--2">
          <div class="field">
            <label for="est-full-baths">Full bathrooms</label>
            <input class="input" id="est-full-baths" name="fullBaths" type="number" inputmode="numeric" min={RESIDENTIAL_INPUT_LIMITS.fullBaths.min} max={RESIDENTIAL_INPUT_LIMITS.fullBaths.max} required />
          </div>
          <div class="field">
            <label for="est-half-baths">Half bathrooms</label>
            <input class="input" id="est-half-baths" name="halfBaths" type="number" inputmode="numeric" min={RESIDENTIAL_INPUT_LIMITS.halfBaths.min} max={RESIDENTIAL_INPUT_LIMITS.halfBaths.max} value="0" required />
          </div>
        </div>
        <div class="field-row field-row--2" data-str-only hidden>
          <div class="field">
            <label for="est-rental-properties">How many rental properties do you manage?</label>
            <input class="input" id="est-rental-properties" name="rentalProperties" type="number" inputmode="numeric" min={RESIDENTIAL_INPUT_LIMITS.rentalProperties.min} max={RESIDENTIAL_INPUT_LIMITS.rentalProperties.max} value="1" />
            <span class="hint">Start with the property below; we can discuss the portfolio after your first turnover.</span>
          </div>
          <div class="field">
            <label for="est-turnover-frequency">How often are turnovers needed?</label>
            <select class="select" id="est-turnover-frequency" name="turnoverFrequency">
              <option value="">Choose one (optional)…</option>
              {TURNOVER_FREQUENCY_OPTIONS.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </div>
        </div>
        <div class="field" data-str-only hidden>
          <label for="est-beds">Beds to reset (turnovers)</label>
          <input class="input" id="est-beds" name="beds" type="number" inputmode="numeric" min={RESIDENTIAL_INPUT_LIMITS.beds.min} max={RESIDENTIAL_INPUT_LIMITS.beds.max} required />
          <span class="hint">Each bed gets fresh linens and a full reset.</span>
        </div>
        <div class="field-row field-row--2" data-str-only hidden>
          <div class="field">
            <label for="est-checkout">Check-out time (optional)</label>
            <input class="input" id="est-checkout" name="checkoutTime" type="text" placeholder="e.g. 10:00 AM" maxlength="20" />
            <span class="hint">When guests leave.</span>
          </div>
          <div class="field">
            <label for="est-checkin">Check-in time (optional)</label>
            <input class="input" id="est-checkin" name="checkinTime" type="text" placeholder="e.g. 4:00 PM" maxlength="20" />
            <span class="hint">When the next guests arrive.</span>
          </div>
        </div>
        <div class="field" data-str-only hidden>
          <label for="est-linen">Linen / laundry preference</label>
          <select class="select" id="est-linen" name="linenPreference">
            <option value="">Choose one (optional)…</option>
            {LINEN_PREFERENCE_OPTIONS.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
          <span class="hint">Hayli confirms the linen plan with you before the first turnover.</span>
        </div>
        </div>
      </section>

      <!-- Step 3 — condition + frequency -->
      <section class="wizard__step" data-step="3" aria-label={stepTitle(2)}>
        <h2 class="wizard__step-heading" data-step-title={2}>{stepTitle(2)}</h2>
        <div class="field" data-frequency-field>
          <label for="est-frequency">How often should we clean?</label>
          <select class="select" id="est-frequency" name="frequency" required>
            <option value="">Choose one…</option>
            {FREQUENCY_OPTIONS.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
          <span class="hint">Recurring homes stay more maintainable, so per-visit value improves.</span>
        </div>
        <div class="policy-notice" data-recurring-deep hidden>
          <p class="policy-notice__title">Your first visit is a Deep Cleaning</p>
          <p>{schedulingConfig.recurringResidential.message}</p>
          <label class="policy-notice__confirm">
            <input
              type="checkbox"
              name="initialDeepCleanAcknowledged"
              value="yes"
              data-error-required="Please confirm that your first recurring visit will be a Deep Cleaning."
            />
            <span>I understand my first recurring visit will be a Deep Cleaning.</span>
          </label>
        </div>


        <div data-reveal-group="condition" data-reveal-trigger="frequency" hidden>
          <fieldset
            class="field"
            data-group-error="condition"
            data-group-message="Please choose the home's current condition."
          >
            <legend>What condition is the home in today?</legend>
            <div class="option-grid">
              {
                CONDITION_OPTIONS.map((option) => (
                  <label class="option">
                    <input type="radio" name="condition" value={option.value} required />
                    <span class="option__control"></span>
                    <span>
                      <span class="option__label">{option.label}</span>
                      <span class="option__desc">{option.description}</span>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>
        <div data-reveal-group="history" data-reveal-trigger="condition" hidden>
        <div class="field">
          <label for="est-last-clean">When was the home last professionally cleaned?</label>
          <select class="select" id="est-last-clean" name="lastClean" required>
            <option value="">Choose one…</option>
            {LAST_CLEAN_OPTIONS.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </div>
        <div class="field">
          <label for="est-pets">Pets in the home</label>
          <select class="select" id="est-pets" name="pets" required>
            {PET_OPTIONS.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </div>
        <PhotoUploadSection engine="residential" />
        <p class="small text-muted" data-photo-unavailable hidden>
          Photo upload is temporarily unavailable. Continue your request and we will contact you
          for photos before confirming the booking.{phone ? ` Call or text ${phone.display}.` : ''}
        </p>
        </div>
      </section>

      <!-- Step 4 — contact details -->
      <section class="wizard__step" data-step="4" aria-label={stepTitle(3)}>
        <h2 class="wizard__step-heading" data-step-title={3}>{stepTitle(3)}</h2>
        <p class="hint">So we can confirm your estimate, request and appointment.</p>
        <div class="field-row field-row--2">
          <div class="field">
            <label for="est-name">Your name</label>
            <input class="input" id="est-name" name="name" type="text" autocomplete="name" required />
          </div>
          <div class="field">
            <label for="est-phone">Phone</label>
            <input class="input" id="est-phone" name="phone" type="tel" autocomplete="tel" required />
          </div>
        </div>
        <div class="field">
          <label for="est-email">Email</label>
          <input class="input" id="est-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="est-notes">Notes (optional)</label>
          <textarea
            class="textarea"
            id="est-notes"
            name="notes"
            rows="4"
            placeholder="Anything we should know - pets, parking, access details, priorities."
          ></textarea>
        </div>
      </section>
      <!-- Step 5 — Your Estimate -->
      <section class="wizard__step" data-step="5" aria-label={stepTitle(4)}>
        <h2 class="wizard__step-heading" data-step-title={4}>{stepTitle(4)}</h2>

        <div class="appointment-summary" data-appointment-summary>
          <div>
            <p class="appointment-summary__eyebrow">Your preferred appointment</p>
            <p class="appointment-summary__value" data-appointment-date>Choose a date in step 1</p>
            <p class="appointment-summary__meta" data-appointment-time></p>
          </div>
          <button class="btn btn--ghost btn--small" type="button" data-appointment-edit>
            Change date or time
          </button>
        </div>
        <div class="booking-alternatives" data-booking-alternatives hidden></div>

        <div class="estimate-reveal-stage">
          <EstimateReveal />
          <div class="reservation-summary" data-reservation-summary hidden>
          <p class="reservation-summary__eyebrow" data-reservation-eyebrow>Your proposed cleaning price</p>
          <p class="reservation-summary__price">
            <span data-reservation-price>—</span>
            <span class="reservation-summary__price-suffix" data-reservation-price-suffix></span>
          </p>
          <p class="reservation-summary__ongoing" data-reservation-ongoing hidden></p>
          <p class="reservation-summary__meta" data-reservation-reference hidden></p>
          <p class="reservation-summary__meta" data-reservation-validity hidden></p>

          <ul class="summary-list price-breakdown" data-price-breakdown></ul>
          <details class="extras-accordion cleaning-details-accordion" data-cleaning-details>
            <summary class="extras-accordion__summary">
              <span class="extras-accordion__heading">Your Cleaning Details</span>
              <span class="extras-accordion__hint"
                >Your selections, appointment and service location.</span
              >
              <Icon name="chevron-down" size={18} class="extras-accordion__chevron" />
            </summary>
            <div class="summary-groups" data-reservation-scope></div>
          </details>


          <details class="extras-accordion" data-extras-accordion>
            <summary class="extras-accordion__summary">
              <span class="extras-accordion__heading">Bundle and Save With These Add-Ons</span>
              <span class="extras-accordion__hint"
                >Add extras, choose a bundle, or customize your cleaning.</span
              >
              <span class="extras-accordion__selected" data-extras-summary>No extras selected</span>
              <Icon name="chevron-down" size={18} class="extras-accordion__chevron" />
            </summary>
            <div class="final-extras">
            <h3 class="bundle-offers__title">Bundles &amp; individual extras</h3>
        <fieldset class="field">
          <legend>Individual extras</legend>
          <p class="hint" style="margin-bottom: var(--space-3)">
            Prices are calculated from your service and scope. Items marked "Custom quote" are
            priced individually.
          </p>

          {
            activeBundles.length > 0 && (
              <div class="bundle-offers" data-bundle-offers>
                <h3 class="bundle-offers__title">Bundle & save</h3>
                <p class="hint">
                  Select every extra in a bundle and the discount applies automatically to your
                  extra services. Only one discount applies per quote.
                </p>
                <div class="bundle-offers__grid">
                  {activeBundles.map((bundle) => (
                    <article
                      class="bundle-offer"
                      data-bundle-id={bundle.id}
                      data-bundle-value={bundle.value ?? 0}
                      data-bundle-kind={bundle.kind}
                      data-bundle-cap={bundle.maxDiscountUsd ?? ''}
                      data-bundle-required={bundle.requiredAddonIds.join(',')}
                      data-bundle-recurring={bundle.requiresRecurring ? 'true' : 'false'}
                      data-bundle-frequencies={bundle.eligibleFrequencies.join(',')}
                    >
                      <h4 class="bundle-offer__title">{bundle.label}</h4>
                      <p class="bundle-offer__contents">
                        {bundle.requiredAddonIds.map((id) => addonLabels.get(id) ?? id).join(' + ')}
                      </p>
                      <p class="bundle-offer__price" data-bundle-price>
                        {bundle.kind === 'percent'
                          ? `Save ${Math.round((bundle.value ?? 0) * 100)}% when selected together`
                          : 'Bundle discount when selected together'}
                      </p>
                      <button class="btn btn--secondary btn--small" type="button" data-bundle-add>
                        Add these extras
                      </button>
                    </article>
                  ))}
                </div>
              </div>
            )
          }

          {
            incentiveEnabled && (
              <p class="addon-incentive" data-addon-incentive>
                <Icon name="star" size={16} /> <span data-addon-incentive-text></span>
              </p>
            )
          }
          {
            customThreeExtraEnabled && (
              <div class="custom-bundle" data-custom-bundle hidden>
                <p class="custom-bundle__title">
                  Want to bundle and save on any of these extras?
                </p>
                <p class="custom-bundle__copy">
                  Choose exactly three eligible extras and save{' '}
                  {Math.round(customThreeExtraPercent * 100)}% on the extras subtotal.
                </p>
                <p class="custom-bundle__math" data-custom-bundle-text></p>
              </div>
            )
          }
          <div class="option-grid option-grid--2">
            {addons.map((addon) => (
              <label class="option option--addon">
                <input type="checkbox" name="addons" value={addon.id} />
                <span class="option__control"></span>
                <span>
                  <span class="option__label">
                    {addon.label}
                    {addon.customQuote ? (
                      <span class="option__price option__price--custom">Custom quote</span>
                    ) : (
                      <span class="option__price" data-addon-price={addon.id}>Calculating...</span>
                    )}
                  </span>
                  <span class="option__desc">{addon.blurb}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>
            </div>
          </details>

          <p class="reservation-summary__qualification reservation-summary__qualification--compact" data-reservation-qualification></p>

          <div class="reservation-actions">
            <p class="reservation-actions__note" data-payment-note></p>
            <button class="btn btn--secondary btn--small" type="button" data-verify-address hidden>Verify Address to Pay Online</button>
            <div class="field gift-code-field" data-gift-field hidden>
              <label for="est-gift-code">Gift certificate code <span class="text-muted">(optional)</span></label>
              <input
                class="input"
                id="est-gift-code"
                name="gift_code"
                type="text"
                autocomplete="off"
                autocapitalize="characters"
                spellcheck="false"
                maxlength="20"
                placeholder="SSGC-XXXX-XXXX"
                data-gift-code
              />
              <p class="small text-muted">
                We will apply the certificate's available balance. Any remaining balance is paid securely.
              </p>
            </div>
            <p class="small text-muted" data-payment-unavailable hidden></p>
            <div class="reservation-actions__links">
              {phone && (
                <a class="btn btn--ghost btn--small" data-reserve-call href={phone.href}>
                  <Icon name="phone" size={16} /> Call to Reserve
                </a>
              )}
              {phone && smsEnabled && (
                <a class="btn btn--ghost btn--small" data-reserve-text href={phone.sms}>
                  <Icon name="message" size={16} /> Text to Reserve
                </a>
              )}
            </div>
          </div>
        </div>
        </div>


        <p class="small photo-summary" data-photo-summary hidden></p>
        <label class="supportive-check" data-supportive-section hidden>
          <input type="checkbox" name="supportiveEligible" value="yes" data-supportive-eligible />
          <span>
            I qualify for Sparkling Standard&rsquo;s{communitySupportEnabled ? ` ${communitySupportPercent}%` : ''}
            Community Support discount.
            <a href="/terms/#community-support" class="supportive-check__link">Eligibility terms</a>
          </span>
        </label>
        <TermsAcceptance id="est-terms" />
        <TurnstileWidget />
        <div class="honeypot" aria-hidden="true">
          <input
            id="est-extra-ref"
            name="extra_ref"
            type="text"
            tabindex="-1"
            autocomplete="off"
            data-lpignore="true"
            data-1p-ignore
            data-bwignore
            data-protonpass-ignore
          />
        </div>
      </section>
    </div>

        <div
          class="photo-gate"
          data-photo-gate
          hidden
          role="dialog"
          aria-modal="true"
          aria-labelledby="photo-gate-title"
        >
          <div class="photo-gate__dialog">
            <p class="photo-gate__title" id="photo-gate-title">Photos of Your Space</p>
            <p class="photo-gate__copy">
              Photos help us verify your cleaning estimate. Would you like to upload them now or
              provide them later?
            </p>
            <div class="btn-row">
              <button class="btn btn--secondary" type="button" data-photo-upload-now>
                Add Photos Now
              </button>
              <button class="btn btn--primary" type="button" data-photo-pay-later>
                I&rsquo;ll Add Them Later
              </button>
            </div>
          </div>
        </div>

    <div class="wizard__nav">
      <button class="btn btn--ghost" type="button" data-back hidden>
        <Icon name="chevron-left" size={16} /> Back
      </button>
      <span class="spacer"></span>
      <button class="btn btn--primary" type="button" data-next>Continue <Icon name="arrow-right" size={16} /></button>
      <div class="wizard__final-actions" data-final-actions hidden>
        <button class="btn btn--success btn--large" type="button" data-pay-now hidden>
          Pay Now and Reserve This Cleaning
        </button>
        <button class="btn btn--secondary btn--large" type="submit" data-submit hidden data-cta="estimate-submit">
          Request to Reserve This Cleaning (Pay Later)
        </button>
      </div>
    </div>
    <p class="form-status" data-form-status role="status" aria-live="polite" style="margin: 0 var(--space-6) var(--space-5)"></p>
  </form>

  <aside class="stack">
    <div class="card card--muted">
      <h2 class="card__title">No two homes are the same</h2>
      <p class="card__text">
        No two homes are the same, so why should their prices be? Your estimate is built from the
        details you provide — square footage, condition, extras and travel — so you can see a real
        proposed total before choosing what to do next.
      </p>
      <p class="card__text">
        Pay securely through Stripe to reserve a verified slot, or send a pay-later request for
        personal review. Paid bookings with complete details and photos confirm automatically when
        the calendar accepts them.
      </p>
      <p class="card__text"><strong>Your home. Your estimate. Your schedule. Your choice.</strong></p>
    </div>

    <div class="card">
      <h3 class="card__title">After you send</h3>
      <ol class="timeline">
        <li class="timeline__stage">
          <span class="timeline__number" aria-hidden="true">1</span>
          <div class="timeline__content">
            <p class="timeline__title">Estimate or reserve</p>
            <p class="timeline__text">Pay now when checkout is available, or send a request to pay later.</p>
          </div>
        </li>
        <li class="timeline__stage">
          <span class="timeline__number" aria-hidden="true">2</span>
          <div class="timeline__content">
            <p class="timeline__title">Requirements checked</p>
            <p class="timeline__text">We verify the address, photos, payment and requested time.</p>
          </div>
        </li>
        <li class="timeline__stage">
          <span class="timeline__number" aria-hidden="true">3</span>
          <div class="timeline__content">
            <p class="timeline__title">Appointment confirmed</p>
            <p class="timeline__text">Complete paid bookings confirm automatically; anything outstanding stays visibly pending.</p>
          </div>
        </li>
      </ol>
    </div>

    <ResponseGuarantee />

    {
      (phone || email) && (
        <div class="card">
          <h3 class="card__title">Prefer to talk it through?</h3>
          {phone && (
            <p class="card__text">
              Call or text <a href={phone.href}>{phone.display}</a>
              {email && (
                <> — or email <a href={`mailto:${email}`}>{email}</a>.</>
              )}
            </p>
          )}
          {!phone && email && (
            <p class="card__text">
              Email <a href={`mailto:${email}`}>{email}</a>.
            </p>
          )}
        </div>
      )
    }
    <p class="small text-muted">
      Every visit to this page starts a fresh estimate, and nothing is saved in this browser. You can
      <button type="button" class="link-button" data-estimate-reset style="background:none;border:0;padding:0;color:var(--color-rose-700);text-decoration:underline;cursor:pointer;font:inherit">start over</button>
      at any time.
    </p>
  </aside>
</div>

<script>
  import '../scripts/estimate-wizard';
</script>
