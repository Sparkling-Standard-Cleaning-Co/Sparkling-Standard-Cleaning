---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import PromoPopup from '../components/PromoPopup.astro';
import SiteAnalytics from '../components/SiteAnalytics.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: object[];
  /** False on estimator form pages, which use their own fixed action bar. */
  showMobileActionBar?: boolean;
  /** False on token-bearing or private pages that must never load analytics. */
  analytics?: boolean;
}

const {
  title,
  description,
  noindex = false,
  schema = [],
  showMobileActionBar = true,
  analytics = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} noindex={noindex} schema={schema} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={['site-main', { 'site-main--estimator': !showMobileActionBar }]}>
      <slot />
    </main>
    <Footer />
    {showMobileActionBar && <MobileActionBar />}
    {analytics && <ConsentBanner compact={!showMobileActionBar} />}
    {analytics && <PromoPopup />}
    {analytics && <SiteAnalytics />}
  </body>
</html>
