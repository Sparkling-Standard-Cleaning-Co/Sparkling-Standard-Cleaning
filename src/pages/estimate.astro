---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EstimateHub from '../components/EstimateHub.astro';
import { breadcrumbNode } from '../lib/schema';

const site = Astro.site ?? new URL('https://pending-website-url.invalid');
const title = 'Cleaning Estimate Options | Sparkling Standard';
const description =
  'Choose the estimate that fits your space: residential cleaning, short-term rental turnovers, commercial facilities or church cleaning. Each path asks only what matters.';
const schema = [
  breadcrumbNode(site, [
    { name: 'Home', path: '/' },
    { name: 'Instant Estimate', path: '/estimate/' },
  ]),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <section class="section section--tight estimate-intro">
    <div class="container">
      <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Instant Estimate', path: '/estimate/' }]} />
      <div class="section-head mt-4">
        <h1>Find the right estimate.</h1>
        <p class="lead">
          Choose the cleaning that matches your space. Each path asks only what matters for that
          kind of cleaning — no account and no obligation.
        </p>
      </div>
    </div>
  </section>

  <div class="container" style="margin-bottom: var(--space-8)">
    <EstimateHub />
  </div>
</BaseLayout>

<script>
  // Backward-compatible forwarding for the pre-6.2 deep links that used the
  // hub URL for a specific engine. The hub itself stays a clean selection
  // page; no redirect happens for a plain /estimate/ visit.
  const params = new URLSearchParams(window.location.search);
  const service = (params.get('service') ?? '').trim().toLowerCase();
  const residentialServices = new Set([
    'recurring',
    'deep',
    'move',
    'move-in',
    'move-out',
    'supportive',
    'one-time',
    'standard',
    'house',
    'residential',
    'str_turnover',
  ]);
  const hasResidentialState = ['frequency', 'supportive', 'promo'].some((key) => params.has(key));
  let target = '';
  if (service === 'str_turnover' || service === 'str') target = '/estimate/str/';
  else if (service === 'commercial' || service === 'commercial_cleaning') target = '/estimate/commercial/';
  else if (service === 'church' || service === 'church_cleaning') target = '/estimate/church/';
  else if ((service && residentialServices.has(service)) || hasResidentialState) target = '/estimate/residential/';
  if (target) window.location.replace(`${target}${window.location.search}${window.location.hash}`);
</script>
