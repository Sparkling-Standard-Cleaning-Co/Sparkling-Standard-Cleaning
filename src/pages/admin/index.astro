---
import '../../styles/global.css';
import '../../styles/admin.css';
import {
  COMMERCIAL_FACILITY_TYPES,
  CONDITION_OPTIONS,
  FACILITY_CONDITION_OPTIONS,
  FACILITY_FREQUENCY_OPTIONS,
  FLOORING_OPTIONS,
  FREQUENCY_OPTIONS,
  LAST_CLEAN_OPTIONS,
  PET_OPTIONS,
  PROPERTY_TYPE_OPTIONS,
  RESIDENTIAL_INPUT_LIMITS,
  TRAFFIC_OPTIONS,
} from '../../config/estimators/input-definitions';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sparkling Standard Operations</title>
  </head>
  <body class="admin-body">
    <main class="admin-main" id="main">
      <div class="admin-gate" data-admin-gate>
        <div class="admin-card" style="max-width: 32rem; margin: 8vh auto 0;">
          <p class="admin-brand__sub">Sparkling Standard</p>
          <h1 class="admin-title">Operations</h1>
          <p class="admin-sub">Private cleaning-company administration.</p>
          <p class="admin-muted" data-admin-gate-status>Checking secure session.</p>

          <form class="admin-form" data-admin-setup hidden>
            <h2 style="font-size:1.1rem;margin:.5rem 0 0;">Create the owner account</h2>
            <p class="admin-muted">Use the setup code configured in the server environment.</p>
            <label>Setup code <input name="setupCode" type="password" autocomplete="one-time-code" required /></label>
            <label>Owner name <input name="name" type="text" autocomplete="name" required /></label>
            <label>Owner email <input name="email" type="email" autocomplete="email" required /></label>
            <label>Password
              <input name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="200" data-admin-password-new aria-describedby="admin-setup-password-hint" />
            </label>
            <p class="admin-muted" id="admin-setup-password-hint">At least 8 characters, including one special character (for example ! @ # $ %).</p>
            <button class="btn btn--primary" type="submit">Create Secure Owner Account</button>
          </form>

          <form class="admin-form" data-admin-login>
            <h2 style="font-size:1.1rem;margin:.5rem 0 0;">Sign in</h2>
            <label>Email <input name="email" type="email" autocomplete="username" required /></label>
            <label>Password <input name="password" type="password" autocomplete="current-password" required /></label>
            <button class="btn btn--primary" type="submit">Sign In</button>
            <p class="admin-muted admin-forgot"><button class="admin-link" type="button" data-admin-forgot>Forgot Password?</button></p>
          </form>

          <form class="admin-form" data-admin-forgot-form hidden>
            <h2 style="font-size:1.1rem;margin:.5rem 0 0;">Reset your password</h2>
            <p class="admin-muted">
              Enter the email address for your administrator account. If it matches an active
              account, we will email a single-use link that lets you choose a new password.
            </p>
            <label>Email <input name="email" type="email" autocomplete="username" required /></label>
            <button class="btn btn--primary" type="submit">Send Reset Link</button>
            <button class="btn btn--ghost btn--small" type="button" data-admin-back-to-login>Return to Sign In</button>
            <p class="admin-status-message" data-admin-forgot-status role="status" aria-live="polite"></p>
          </form>

          <form class="admin-form" data-admin-mfa hidden>
            <h2 style="font-size:1.1rem;margin:.5rem 0 0;">Two-step verification</h2>
            <p class="admin-muted">Enter the current authenticator code. A recovery code also works.</p>
            <label>Authenticator code <input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" /></label>
            <label>Recovery code <input name="recoveryCode" autocomplete="off" maxlength="40" /></label>
            <button class="btn btn--primary" type="submit">Verify and Sign In</button>
            <button class="btn btn--ghost btn--small" type="button" data-admin-mfa-cancel>Back to sign in</button>
          </form>

          <form class="admin-form" data-admin-invite hidden>
            <h2 style="font-size:1.1rem;margin:.5rem 0 0;">Accept administrator invitation</h2>
            <label>Your name <input name="name" type="text" autocomplete="name" required /></label>
            <label>Create password
              <input name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="200" data-admin-password-new aria-describedby="admin-invite-password-hint" />
            </label>
            <label>Confirm password <input name="confirmPassword" type="password" autocomplete="new-password" required data-admin-password-confirm /></label>
            <p class="admin-muted" id="admin-invite-password-hint">At least 8 characters, including one special character (for example ! @ # $ %).</p>
            <button class="btn btn--primary" type="submit">Accept Invitation</button>
          </form>

          <form class="admin-form" data-admin-reset hidden>
            <h2 style="font-size:1.1rem;margin:.5rem 0 0;">Set a new password</h2>
            <label>New password
              <input name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="200" data-admin-password-new aria-describedby="admin-reset-password-hint" />
            </label>
            <label>Confirm new password <input name="confirmPassword" type="password" autocomplete="new-password" required data-admin-password-confirm /></label>
            <p class="admin-muted" id="admin-reset-password-hint">At least 8 characters, including one special character (for example ! @ # $ %).</p>
            <button class="btn btn--primary" type="submit">Update Password</button>
            <button class="btn btn--ghost btn--small" type="button" data-admin-back-to-login>Return to Sign In</button>
            <p class="admin-status-message" data-admin-reset-status role="status" aria-live="polite"></p>
          </form>
          <p class="admin-error" data-admin-error role="alert"></p>
          <p class="admin-status-message" data-admin-success role="status" aria-live="polite"></p>
        </div>
      </div>

      <div class="admin-shell" data-admin-app hidden>
        <aside class="admin-sidebar">
          <a class="admin-brand" href="/admin/">
            <span class="admin-brand__mark">S</span>
            <span><span class="admin-brand__name">Sparkling<br />Standard</span><br /><span class="admin-brand__sub">Operations</span></span>
          </a>
          <nav class="admin-nav" aria-label="Admin sections">
            <button type="button" data-admin-nav="overview">Overview</button>
            <button type="button" data-admin-nav="calendar">Calendar &amp; Requests</button>
            <button type="button" data-admin-nav="leads">Leads &amp; Inquiries</button>
            <button type="button" data-admin-nav="customers">Customers</button>
            <button type="button" data-admin-nav="new-booking">New Booking</button>
            <button type="button" data-admin-nav="recurring">Recurring Plans</button>
            <button type="button" data-admin-nav="jobs">Jobs &amp; Team</button>
            <button type="button" data-admin-nav="documents">Documents &amp; Agreements</button>
            <button type="button" data-admin-nav="timekeeping">Timekeeping</button>
            <button type="button" data-admin-nav="finance">Invoices &amp; Payments</button>
            <button type="button" data-admin-nav="gift">Gift Certificates</button>
            <button type="button" data-admin-nav="reports">Reports</button>
            <button type="button" data-admin-nav="storage">Data &amp; Storage</button>
            <button type="button" data-admin-nav="promotions">Promotions &amp; Discounts</button>
            <button type="button" data-admin-nav="pricing">Pricing &amp; Estimator Control</button>
            <button type="button" data-admin-nav="settings">Settings &amp; Audit</button>
          </nav>
          <div class="admin-sidebar__meta">
            <p data-admin-user></p>
            <button class="btn btn--ghost btn--small" type="button" data-admin-logout>Sign out</button>
          </div>
        </aside>

        <div class="admin-workspace">
          <header class="admin-topbar">
            <div>
              <h1 class="admin-title" data-admin-view-title>Overview</h1>
              <p class="admin-sub" data-admin-view-sub>Live cleaning-company operations.</p>
            </div>
            <span class="admin-status" data-admin-role></span>
          </header>
          <p class="admin-error" data-admin-app-error role="alert"></p>

          <section class="admin-view" data-admin-view="overview">
            <div class="admin-grid" data-admin-kpis></div>
            <div data-admin-alerts style="margin-top:1rem;"></div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Recent inquiries</h2>
              <div data-admin-recent></div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="calendar" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Next seven days</h2>
              <p class="admin-muted">Operational board for scheduling and staffing. Later confirmed appointments remain intact below.</p>
              <div data-admin-week-board></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Reservation requests</h2>
              <p class="admin-muted">Actionable requests appear by default. Search includes closed, archived and historical records.</p>
              <form class="admin-inline-form" data-admin-request-filter>
                <select name="view" aria-label="Request view">
                  <option value="actionable">Actionable</option>
                  <option value="paid_pending">Paid ? awaiting confirmation</option>
                  <option value="pending">Pending</option>
                  <option value="confirmed">Confirmed</option>
                  <option value="completed">Completed</option>
                  <option value="declined">Declined / cancelled</option>
                  <option value="closed">Closed</option>
                  <option value="archived">Archived</option>
                  <option value="all">All / historical</option>
                </select>
                <input name="q" type="search" placeholder="Search reference, customer, address" aria-label="Search requests" />
                <button class="btn btn--secondary btn--small" type="submit">Search</button>
              </form>
              <div data-admin-requests></div>
            </div>
            <div data-admin-request-detail style="margin-top:1rem;" hidden></div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Upcoming appointments</h2>
              <div data-admin-appointments></div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="leads" hidden>
            <div class="admin-card">
              <form class="admin-inline-form" data-admin-lead-filter>
                <label>Status <select name="status"><option value="">All</option><option value="new">New</option><option value="contacted">Contacted</option><option value="quoted">Quoted</option><option value="converted">Converted</option><option value="lost">Lost</option><option value="archived">Archived</option></select></label>
                <label>Search <input name="q" type="search" placeholder="Name, reference, address" /></label>
                <button class="btn btn--secondary btn--small" type="submit">Filter</button>
              </form>
              <div data-admin-leads style="margin-top:1rem;"></div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="customers" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Customers</h2>
              <form class="admin-inline-form" data-admin-customer-search>
                <label>Search <input name="q" type="search" placeholder="Name, email or phone" /></label>
                <button class="btn btn--secondary btn--small" type="submit">Search</button>
                <button class="btn btn--ghost btn--small" type="button" data-admin-customer-new>New customer</button>
              </form>
              <div data-admin-customers style="margin-top:1rem;"></div>
              <div class="admin-detail" data-admin-customer-detail hidden></div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="new-booking" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Create a one-time booking</h2>
              <p class="admin-muted">
                Uses the same estimators, published pricing, document requirements and staffing rules as the
                public website. Property facts are loaded from the saved profile; condition and extras belong to
                this estimate only and never rewrite the profile.
              </p>
              <form class="admin-form admin-form--grid" data-manual-booking-form style="max-width:none">
                <label>Customer <select name="customerId" data-manual-customer required><option value="">Choose a customer</option></select></label>
                <label>Property <select name="propertyId" data-manual-property required><option value="">Choose a customer first</option></select></label>
                <p class="admin-field--wide admin-muted">Need a new customer or another property? <button class="btn btn--ghost btn--small" type="button" data-admin-action="manual-manage-customer">Open the customer record</button></p>
                <label>Booking type
                  <select name="engine" data-manual-engine>
                    <option value="residential">Residential cleaning</option>
                    <option value="str">Short-term rental turnover</option>
                    <option value="commercial">Commercial cleaning</option>
                    <option value="church">Church cleaning</option>
                  </select>
                </label>
                <label>Service
                  <select name="serviceType" data-manual-service>
                    <option value="standard">Residential maintenance</option>
                    <option value="deep">Deep cleaning</option>
                    <option value="move_in_out">Move-in / move-out</option>
                  </select>
                </label>
                <div class="admin-field--wide admin-form admin-form--grid" data-manual-residential>
                  <label>Property type <select name="propertyType">{PROPERTY_TYPE_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
                  <label>Square feet <input name="squareFeet" type="number" min={RESIDENTIAL_INPUT_LIMITS.squareFeet.min} max={RESIDENTIAL_INPUT_LIMITS.squareFeet.max} step={RESIDENTIAL_INPUT_LIMITS.squareFeet.step} data-manual-square-feet /></label>
                  <label>Bedrooms <input name="bedrooms" type="number" min="0" max="12" data-manual-bedrooms /></label>
                  <label>Full bathrooms <input name="fullBaths" type="number" min="0" max="12" data-manual-full-baths /></label>
                  <label>Half bathrooms <input name="halfBaths" type="number" min="0" max="12" data-manual-half-baths /></label>
                  <label>Beds to reset (STR) <input name="beds" type="number" min="1" max="30" data-manual-beds /></label>
                  <label>Pets <select name="pets">{PET_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
                  <label>Condition <select name="condition">{CONDITION_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
                  <label>Last professional clean <select name="lastClean">{LAST_CLEAN_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
                  <label>Frequency <select name="frequency">{FREQUENCY_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
                  <label class="admin-field--wide"><input type="checkbox" name="supportiveEligible" value="yes" /> Community Support eligibility (10% — client attestation only)</label>
                </div>
                <div class="admin-field--wide admin-form admin-form--grid" data-manual-facility hidden>
                  <label>Facility type <select name="facilityType">{COMMERCIAL_FACILITY_TYPES.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
                  <label>Cleanable square feet <input name="cleanableSqft" type="number" min="100" max="200000" step="50" /></label>
                  <label>Restroom fixtures <input name="restroomFixtures" type="number" min="0" max="40" step="1" /></label>
                  <label>Breakroom / kitchen <select name="breakroom"><option value="none">None</option><option value="breakroom">Small breakroom</option><option value="kitchen">Full kitchen</option></select></label>
                  <label>Condition <select name="facilityCondition">{FACILITY_CONDITION_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
                  <label>Traffic <select name="traffic">{TRAFFIC_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
                  <label>Flooring <select name="flooring">{FLOORING_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
                  <label>Visit frequency <select name="facilityFrequency">{FACILITY_FREQUENCY_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}</select></label>
                  <label><input type="checkbox" name="firstClean" value="yes" /> First clean / overdue reset</label>
                  <label><input type="checkbox" name="specialty" value="yes" /> Specialty work requiring review</label>
                </div>
                <fieldset class="admin-field--wide" data-manual-extras>
                  <legend>Extras and bundles</legend>
                  <div class="admin-form admin-form--grid" data-manual-addon-list></div>
                  <div class="admin-form admin-form--grid" data-manual-bundle-list style="margin-top:.5rem;"></div>
                </fieldset>
                <label>Cleaning date <input name="date" type="date" data-manual-date required /></label>
                <label>Crew size <select name="crewSize" data-manual-crew><option value="1">One cleaner</option><option value="2">Two cleaners</option></select></label>
                <label class="admin-field--wide">Internal booking notes <textarea name="notes" rows="2" maxlength="2000" placeholder="Access details, special instructions, or why this estimate differs from the saved profile."></textarea></label>
                <div class="admin-field--wide admin-actions">
                  <button class="btn btn--secondary btn--small" type="button" data-admin-action="manual-quote">Generate Estimate and Check Times</button>
                  <button class="btn btn--ghost btn--small" type="button" data-admin-action="manual-availability">Check Available Times</button>
                </div>
                <div class="admin-field--wide" data-manual-quote-result aria-live="polite"></div>
                <label>Available appointment start <select name="slot" data-manual-slots><option value="">Generate an estimate and check times first</option></select></label>
                <div class="admin-field--wide" data-manual-staff></div>
                <div class="admin-field--wide admin-actions">
                  <button class="btn btn--primary btn--small" type="button" data-admin-action="manual-create">Save Pending Booking</button>
                  <button class="btn btn--secondary btn--small" type="button" data-admin-action="manual-create-confirm">Create Booking and Confirm</button>
                </div>
              </form>
              <div data-manual-booking-result style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Booking recovery queue</h2>
              <p class="admin-muted">Provider writes that did not complete cleanly. Retry from the booking itself; nothing here is deleted automatically.</p>
              <div data-manual-commitments></div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="recurring" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Recurring cleaning plans</h2>
              <div data-admin-recurring-notice></div>
              <div data-admin-recurring></div>
              <div data-admin-recurring-occurrences style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Create a recurring plan</h2>
              <form class="admin-form" data-admin-recurring-create>
                <label>Customer <select name="customerId" data-admin-customer-options required></select></label>
                <label>Property <select name="propertyId" data-admin-property-options required></select></label>
                <label>Frequency <select name="frequency"><option value="biweekly">Every two weeks</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select></label>
                <label>First visit date <input name="startDate" type="date" required /></label>
                <fieldset class="admin-field--wide">
                  <legend>Preferred cleaning window</legend>
                  <label><input type="radio" name="window" value="morning" required /> Morning ? First Appointment (7:00?8:30 AM)</label>
                  <label><input type="radio" name="window" value="afternoon" required /> Afternoon Appointment (12:30?2:30 PM)</label>
                </fieldset>
                <label>Scheduled start time (Central)
                  <select name="startTime" required>
                    <option value="">Choose a start time</option>
                    <option value="07:00">7:00 AM</option><option value="07:15">7:15 AM</option><option value="07:30">7:30 AM</option><option value="07:45">7:45 AM</option><option value="08:00">8:00 AM</option><option value="08:15">8:15 AM</option><option value="08:30">8:30 AM</option>
                    <option value="12:30">12:30 PM</option><option value="12:45">12:45 PM</option><option value="13:00">1:00 PM</option><option value="13:15">1:15 PM</option><option value="13:30">1:30 PM</option><option value="13:45">1:45 PM</option><option value="14:00">2:00 PM</option><option value="14:15">2:15 PM</option><option value="14:30">2:30 PM</option>
                  </select>
                </label>
                <label>Ongoing cleaning duration (minutes) <input name="durationMinutes" type="number" min="30" max="600" step="15" required /></label>
                <label>First deep-clean duration (minutes) <input name="firstDurationMinutes" type="number" min="30" max="600" step="15" /></label>
                <label>Crew size <select name="crewSize"><option value="1">One cleaner</option><option value="2">Two cleaners</option></select></label>
                <label>Ongoing price per visit (USD) <input name="ongoingPrice" type="number" min="0" step="0.01" required /></label>
                <button class="btn btn--primary" type="submit">Create Plan</button>
              </form>
            </div>
          </section>

          <section class="admin-view" data-admin-view="jobs" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Jobs</h2>
              <div data-admin-jobs></div>
              <div data-admin-checklist style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Team</h2>
              <div data-admin-team></div>
              <form class="admin-inline-form" data-admin-team-create style="margin-top:1rem;">
                <label>Name <input name="displayName" required /></label>
                <label>Email <input name="email" type="email" /></label>
                <button class="btn btn--secondary btn--small" type="submit">Add team member</button>
              </form>
            </div>
          </section>

          <section class="admin-view" data-admin-view="documents" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Document templates</h2>
              <p class="admin-muted">Only owner-approved templates can create a signing requirement. Draft and retired templates never block a workflow.</p>
              <div data-admin-documents-templates></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Add a document template</h2>
              <div class="admin-grid">
                <form class="admin-form" data-document-template-text>
                  <h3>Approved text agreement</h3>
                  <label>Title <input name="title" required maxlength="200" /></label>
                  <label>Category <input name="category" maxlength="80" placeholder="residential, employee, commercial" /></label>
                  <label>Version <input name="version" value="1.0" maxlength="40" /></label>
                  <label>Signer <select name="signerParty"><option value="customer">Customer</option><option value="employee">Employee</option><option value="both">Both</option></select></label>
                  <label>Agreement text <textarea name="contentText" rows="8" required maxlength="200000"></textarea></label>
                  <label><input type="checkbox" name="requiresVerification" value="yes" /> Requires owner/admin verification or countersignature</label>
                  <label><input type="checkbox" name="requiresCountersignature" value="yes" /> Requires an explicit owner countersignature</label>
                  <button class="btn btn--secondary btn--small" type="submit">Save draft template</button>
                </form>
                <form class="admin-form" data-document-template-upload enctype="multipart/form-data">
                  <h3>Upload an approved PDF</h3>
                  <label>Title <input name="title" required maxlength="200" /></label>
                  <label>Category <input name="category" maxlength="80" /></label>
                  <label>Version <input name="version" value="1.0" maxlength="40" /></label>
                  <label>Signer <select name="signerParty"><option value="customer">Customer</option><option value="employee">Employee</option><option value="both">Both</option></select></label>
                  <label>PDF file <input name="file" type="file" accept="application/pdf" required /></label>
                  <label><input type="checkbox" name="requiresVerification" value="yes" /> Requires owner/admin verification or countersignature</label>
                  <label><input type="checkbox" name="requiresCountersignature" value="yes" /> Requires an explicit owner countersignature</label>
                  <button class="btn btn--secondary btn--small" type="submit">Upload PDF template</button>
                </form>
              </div>
              <div data-document-template-result style="margin-top:.6rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Document bundles</h2>
              <p class="admin-muted">A bundle defines exactly which approved documents apply to a service, customer or employee group. Conditions are optional.</p>
              <div data-admin-documents-bundles></div>
              <form class="admin-inline-form" data-document-bundle-create style="margin-top:1rem;">
                <label>Code <input name="code" required placeholder="customer.residential" /></label>
                <label>Name <input name="name" required placeholder="Residential cleaning documents" /></label>
                <label>Subject <select name="subjectType"><option value="customer">Customer</option><option value="employee">Employee</option></select></label>
                <label>Service category <input name="serviceCategory" placeholder="residential" /></label>
                <button class="btn btn--secondary btn--small" type="submit">Create bundle</button>
              </form>
              <form class="admin-inline-form" data-document-bundle-item style="margin-top:1rem;">
                <label>Bundle <select name="bundleId" data-document-bundle-options required></select></label>
                <label>Template <select name="templateId" data-document-template-options required></select></label>
                <label>Stage
                  <select name="enforcementStage">
                    <option value="before_payment">Before payment</option>
                    <option value="before_confirmation" selected>Before booking confirmation</option>
                    <option value="before_employee_activation">Before employee activation</option>
                    <option value="optional">Optional / informational</option>
                  </select>
                </label>
                <label>Order <input name="sortOrder" type="number" min="0" value="0" /></label>
                <label>Condition key <input name="conditionKey" placeholder="frequency, access_authorization, role" /></label>
                <label>Condition value <input name="conditionValue" placeholder="weekly,biweekly,monthly" /></label>
                <label><input type="checkbox" name="perBooking" value="yes" /> Sign for every booking</label>
                <button class="btn btn--secondary btn--small" type="submit">Add / update document</button>
              </form>
              <div data-document-bundle-items style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Signing requests</h2>
              <p class="admin-muted">Send a secure single-purpose link to a customer or employee. Signed versions are immutable and retained privately.</p>
              <form class="admin-form admin-form--grid" data-document-send>
                <label>Subject <select name="subjectType"><option value="customer">Customer</option><option value="employee">Employee</option></select></label>
                <label>Customer ID <input name="customerId" placeholder="cust_..." /></label>
                <label>Employee ID <input name="teamMemberId" placeholder="team_..." /></label>
                <label>Service code <input name="serviceCode" placeholder="residential-cleaning" /></label>
                <label>Frequency <input name="frequency" placeholder="weekly" /></label>
                <label>Booking reference <input name="bookingReference" placeholder="SS-..." /></label>
                <label>Recipient email <input name="email" type="email" /></label>
                <button class="btn btn--secondary btn--small" type="submit">Create signing link</button>
              </form>
              <div data-document-send-result style="margin-top:.6rem;"></div>
              <div data-admin-documents-requests style="margin-top:1rem;"></div>
              <div data-document-request-detail style="margin-top:1rem;" hidden></div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="timekeeping" hidden>
            <div class="admin-card">
              <div class="admin-inline-form" style="align-items:end;">
                <label>Week starting <input type="date" data-time-week /></label>
                <button class="btn btn--secondary btn--small" type="button" data-admin-action="time-load">Load Week</button>
                <button class="btn btn--ghost btn--small" type="button" data-admin-action="time-export">Export CSV</button>
              </div>
              <div class="admin-grid" data-admin-time-summary style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Employees</h2>
              <p class="admin-muted">Preliminary hours. Correct a timecard below; every correction records the reason and the previous values.</p>
              <div data-admin-time-employees></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Intervals and corrections</h2>
              <div data-admin-time-intervals></div>
              <details class="admin-detail-toggle" style="margin-top:1rem;"><summary>Correct a time interval</summary>
                <form class="admin-form admin-form--grid" data-form="time-correct">
                  <input type="hidden" name="intervalId" data-time-interval-id />
                  <label>Start (Central) <input name="startedAt" type="datetime-local" required /></label>
                  <label>End (Central) <input name="endedAt" type="datetime-local" required /></label>
                  <label>Kind <select name="kind"><option value="work">Work</option><option value="break">Paid rest break</option><option value="meal">Meal</option></select></label>
                  <label>Rate type <select name="rateType"><option value="regular">Regular</option><option value="lead">Lead</option><option value="solo">Solo assignment</option></select></label>
                  <label><input type="checkbox" name="paid" value="yes" /> Paid interval</label>
                  <label class="admin-field--wide">Reason (required) <input name="reason" maxlength="500" required /></label>
                  <button class="btn btn--primary btn--small" type="submit">Save Correction</button>
                </form>
              </details>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Pending correction requests</h2>
              <div data-admin-time-corrections></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Location verification</h2>
              <p class="admin-muted">Recorded only when an employee taps a clock action. Never continuous tracking.</p>
              <div data-admin-time-events></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Staff access</h2>
              <div class="admin-grid">
                <div>
                  <h3>Invite a cleaner</h3>
                  <form class="admin-form" data-form="time-invite">
                    <label>Name <input name="displayName" required maxlength="120" /></label>
                    <label>Email <input name="email" type="email" required /></label>
                    <label>Qualification
                      <select name="qualification">
                        <option value="helper">Helper / regular cleaner</option>
                        <option value="lead">Lead cleaner</option>
                        <option value="solo">Solo-qualified cleaner</option>
                      </select>
                    </label>
                    <label><input type="checkbox" name="isBookable" value="yes" checked /> Eligible for booking</label>
                    <button class="btn btn--secondary btn--small" type="submit">Send Employee Invitation</button>
                  </form>
                  <div data-time-invite-result style="margin-top:.6rem;"></div>
                </div>
                <div>
                  <h3>Link an account to the roster</h3>
                  <form class="admin-form" data-form="time-link">
                    <label>Account email <input name="email" type="email" required /></label>
                    <label>Team member <select name="teamMemberId" data-time-team-options required></select></label>
                    <button class="btn btn--secondary btn--small" type="submit">Link Account</button>
                  </form>
                </div>
              </div>
              <div data-admin-owner-time-rates style="margin-top:1rem;">
                <h3>Pay rates (owner only)</h3>
                <form class="admin-form admin-form--grid" data-form="time-rate">
                  <label>Team member <select name="teamMemberId" data-time-team-options required></select></label>
                  <label>Rate <select name="rateType"><option value="regular">Regular ? $18/hr</option><option value="lead">Lead ? $22/hr</option><option value="solo">Solo assignment ? $25/hr</option></select></label>
                  <label>Hourly (USD) <input name="hourly" type="number" min="0" step="0.01" required /></label>
                  <label>Effective from <input name="effectiveFrom" type="date" required /></label>
                  <button class="btn btn--secondary btn--small" type="submit">Update Rate</button>
                </form>
              </div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="finance" hidden>
            <div class="admin-grid" data-admin-finance-summary></div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Invoices</h2>
              <div data-admin-invoices></div>
              <div data-admin-invoice-detail style="margin-top:1rem;"></div>
              <div data-admin-invoice-controls style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Create an invoice</h2>
              <form class="admin-form" data-admin-invoice-create>
                <label>Customer <select name="customerId" data-admin-customer-options required></select></label>
                <label>Description <input name="description" required /></label>
                <label>Amount (USD) <input name="amount" type="number" min="0.01" step="0.01" required /></label>
                <label>Due date <input name="dueDate" type="date" required /></label>
                <button class="btn btn--primary" type="submit">Create Invoice</button>
              </form>
            </div>
          </section>

          <section class="admin-view" data-admin-view="gift" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Gift certificates</h2>
              <form class="admin-inline-form" data-admin-gift-filter>
                <label>Search <input name="q" type="search" placeholder="Code, purchaser, recipient or email" /></label>
                <label>Status <select name="status"><option value="">All</option><option value="active">Active</option><option value="scheduled">Scheduled (future)</option><option value="fully_redeemed">Fully redeemed</option><option value="refunded">Refunded</option><option value="void">Voided</option></select></label>
                <button class="btn btn--secondary btn--small" type="submit">Filter</button>
              </form>
              <div data-admin-gifts style="margin-top:1rem;"></div>
              <div data-admin-gift-detail style="margin-top:1rem;"></div>
              <p style="margin-top:1rem;"><a class="btn btn--secondary" href="/gift-admin/">Open Gift Register for Adjustments</a></p>
              <p class="admin-muted">The existing production register remains authoritative for balances. Redemption against an invoice is available from the invoice view.</p>
            </div>
          </section>

          <section class="admin-view" data-admin-view="reports" hidden>
            <div data-admin-reports></div>
          </section>

          <section class="admin-view" data-admin-view="storage" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Data &amp; Storage</h2>
              <p class="admin-muted">Owner-only health, business-record counts, safe exports and photo-retention controls. Provider byte totals require Cloudflare account analytics; no universal capacity percentage is invented.</p>
              <div class="admin-grid" data-admin-storage-kpis></div>
              <p class="small text-muted" data-admin-storage-note></p>
              <div class="admin-actions" style="margin-top:1rem;">
                <button class="btn btn--secondary btn--small" type="button" data-admin-action="storage-refresh">Refresh</button>
                <button class="btn btn--ghost btn--small" type="button" data-admin-action="storage-cleanup-preview">Preview Photo Cleanup</button>
                <button class="btn btn--ghost btn--small" type="button" data-admin-action="storage-cleanup-run">Delete Eligible Photos</button>
              </div>
              <p class="admin-status-message" data-admin-storage-status role="status" aria-live="polite"></p>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Business records export</h2>
              <p class="admin-muted">CSV downloads contain business records only; never credentials, tokens or card data. Each export is owner-authenticated and audit-recorded.</p>
              <div class="admin-actions">
                <button class="btn btn--secondary btn--small" type="button" data-admin-export="customers">Customers CSV</button>
                <button class="btn btn--secondary btn--small" type="button" data-admin-export="properties">Properties CSV</button>
                <button class="btn btn--secondary btn--small" type="button" data-admin-export="appointments">Appointments CSV</button>
                <button class="btn btn--secondary btn--small" type="button" data-admin-export="invoices">Invoices CSV</button>
              </div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Backup and cleanup status</h2>
              <div data-admin-storage-settings></div>
              <p class="admin-muted" style="margin-top:.75rem;">Encrypted D1/R2 off-site backup uses the private master archive and CLI; the encrypted D1 restore has been verified. Full R2 object archive requires owner-provided S3 credentials or an approved destination.</p>
            </div>
          </section>
          <section class="admin-view" data-admin-view="promotions" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Promotions &amp; Discount Codes</h2>
              <p class="admin-muted">Create and schedule owner-controlled discounts. Drafts never appear to customers. The Thanksgiving Deep Clean Special is preloaded as a draft for review; it is not active.</p>
              <form class="admin-form admin-form--grid" data-promotion-form>
                <input type="hidden" name="id" />
                <label>Name <input name="name" required maxlength="200" /></label>
                <label>Code <input name="code" required maxlength="40" placeholder="THANKS75" /></label>
                <label>Type <select name="kind"><option value="fixed">Fixed dollar</option><option value="percent">Percentage</option></select></label>
                <label>Amount (USD) <input name="value" type="number" min="0" step="0.01" /></label>
                <label>Percent <input name="percent" type="number" min="1" max="100" step="1" /></label>
                <label>Minimum eligible price (USD) <input name="minPurchase" type="number" min="0" step="0.01" value="0" /></label>
                <label>Maximum discount (USD, 0 = no cap) <input name="maxDiscount" type="number" min="0" step="0.01" value="0" /></label>
                <label>Starts <input name="startsAt" type="datetime-local" /></label>
                <label>Expires <input name="expiresAt" type="datetime-local" /></label>
                <label>Maximum redemptions (0 = unlimited) <input name="maxRedemptions" type="number" min="0" step="1" value="0" /></label>
                <label>Per-customer limit <input name="perCustomerLimit" type="number" min="1" step="1" value="1" /></label>
                <label>Status <select name="status"><option value="draft">Draft</option><option value="active">Active</option><option value="disabled">Disabled</option><option value="expired">Expired</option></select></label>
                <fieldset class="field admin-field--wide"><legend>Eligible services</legend>
                  <label><input type="checkbox" name="services" value="standard" /> Residential Cleaning</label>
                  <label><input type="checkbox" name="services" value="deep" /> Deep Cleaning</label>
                  <label><input type="checkbox" name="services" value="move_in_out" /> Move-in / Move-out</label>
                  <label><input type="checkbox" name="services" value="str_turnover" /> STR Turnover</label>
                  <label><input type="checkbox" name="services" value="commercial_cleaning" /> Commercial</label>
                  <label><input type="checkbox" name="services" value="church_cleaning" /> Church</label>
                </fieldset>
                <fieldset class="field admin-field--wide"><legend>Eligible branches</legend>
                  <label><input type="checkbox" name="branches" value="branch_pensacola" /> Pensacola</label>
                  <label><input type="checkbox" name="branches" value="branch_tampa" /> Tampa Bay / Central Florida (inactive)</label>
                </fieldset>
                <fieldset class="field admin-field--wide"><legend>Restrictions</legend>
                  <label><input type="checkbox" name="newCustomersOnly" /> New customers only</label>
                  <label><input type="checkbox" name="recurringOnly" /> Recurring cleaning only</label>
                  <label><input type="checkbox" name="firstVisitOnly" checked /> First visit only</label>
                  <label><input type="checkbox" name="combinable" /> Combinable with other offers</label>
                </fieldset>
                <div class="admin-actions admin-field--wide"><button class="btn btn--primary btn--small" type="submit">Save Promotion</button><button class="btn btn--ghost btn--small" type="button" data-promotion-reset>Clear</button></div>
              </form>
              <p class="admin-status-message" data-promotion-status role="status" aria-live="polite"></p>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Promotion list</h2>
              <div data-admin-promotions></div>
            </div>
          </section>
          <section class="admin-view" data-admin-view="pricing" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Pricing &amp; Estimator Control</h2>
              <p class="admin-muted">
                Change the pricing used by the residential, STR, commercial and church estimators.
                Edits stay in a draft until you publish them. Publishing creates a new version and
                new estimates use it immediately; historical quotes and payments keep the price they
                were created with.
              </p>
              <div data-pricing-status>
                <p class="admin-muted">Loading pricing configuration…</p>
              </div>
              <div class="admin-actions" style="margin-top:1rem;">
                <button class="btn btn--primary btn--small" type="button" data-pricing-action="save-draft">Save draft</button>
                <button class="btn btn--secondary btn--small" type="button" data-pricing-action="publish">Publish draft</button>
                <button class="btn btn--ghost btn--small" type="button" data-pricing-action="discard">Discard draft</button>
                <button class="btn btn--ghost btn--small" type="button" data-pricing-action="refresh">Refresh</button>
              </div>
              <p class="admin-muted" data-pricing-notice role="status" aria-live="polite"></p>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Pricing variables</h2>
              <p class="admin-muted">
                Each value lists the published price, the editable draft, the unit and the effect on
                the calculation. Structural rules (how labor, discounts and rounding are applied) are
                fixed in code and are not editable here.
              </p>
              <div data-pricing-editor></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Live estimate simulator</h2>
              <p class="admin-muted">
                Uses the same four pricing engines as the customer site. It creates no lead, hold,
                booking, payment, email or calendar event. Tax is calculated separately at checkout
                from the service address and is not changed by these pricing values.
              </p>
              <div data-pricing-simulator></div>
              <div data-pricing-simulation-result style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Version history</h2>
              <p class="admin-muted">Published versions are immutable. Restoring an older version creates a new version, so nothing is erased.</p>
              <div data-pricing-history></div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="settings" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Your security</h2>
              <div data-admin-mfa-status></div>
              <div data-admin-mfa-setup style="margin-top:1rem;"></div>
              <button class="btn btn--ghost btn--small" type="button" data-admin-revoke-others>Sign out other sessions</button>
              <form class="admin-form" data-admin-password-change style="margin-top:1.25rem;">
                <h3 style="font-size:.95rem;margin:0;">Change password</h3>
                <label>Current password <input name="currentPassword" type="password" autocomplete="current-password" required /></label>
                <label>New password
                  <input name="newPassword" type="password" autocomplete="new-password" required minlength="8" maxlength="200" data-admin-password-new aria-describedby="admin-change-password-hint" />
                </label>
                <label>Confirm new password <input name="confirmPassword" type="password" autocomplete="new-password" required data-admin-password-confirm /></label>
                <p class="admin-muted" id="admin-change-password-hint">At least 8 characters, including one special character (for example ! @ # $ %).</p>
                <button class="btn btn--secondary btn--small" type="submit">Update password</button>
                <p class="admin-status-message" data-admin-password-change-status role="status" aria-live="polite"></p>
              </form>
            </div>
            <div class="admin-card" style="margin-top:1rem;" data-admin-owner-section>
              <h2 class="admin-section-title">Administrators</h2>
              <div data-admin-admins></div>
              <form class="admin-form" data-admin-invite-create style="max-width:none;margin-top:1rem;">
                <label>Email <input name="email" type="email" required /></label>
                <label>Role <select name="role"><option value="manager">Manager</option><option value="finance">Finance</option><option value="cleaner">Cleaner</option></select></label>
                <label>Branch <select name="branchId"><option value="">All branches</option><option value="branch_pensacola">Pensacola</option></select></label>
                <button class="btn btn--primary btn--small" type="submit">Create invitation</button>
              </form>
              <div data-admin-invite-result style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Sessions</h2>
              <div data-admin-sessions></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;" data-admin-owner-section>
              <h2 class="admin-section-title">Audit history</h2>
              <div data-admin-audit></div>
            </div>
          </section>
        </div>
      </div>
    </main>
    <script>
      import '../../scripts/admin';
    </script>
  </body>
</html>
