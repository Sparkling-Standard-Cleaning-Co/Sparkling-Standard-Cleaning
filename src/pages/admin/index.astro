              </label>
              <p class="admin-status-message" data-branch-status role="status" aria-live="polite"></p>
            </div>
            <form class="admin-form admin-card" data-branch-form style="margin-top:1rem;max-width:none;">
              <h2 class="admin-section-title">Branch setup</h2>
              <div class="admin-grid">
                <label>Lifecycle
                  <select name="lifecycle" required>
                    <option value="draft">Draft</option>
                    <option value="setup">Setup</option>
                    <option value="internally_testable">Internally testable</option>
                    <option value="approved_to_launch">Approved to launch</option>
                    <option value="live">Live</option>
                    <option value="paused">Paused</option>
                    <option value="retired">Retired</option>
                  </select>
                </label>
                <label>Public name <input name="publicName" required maxlength="120" /></label>
                <label>Public URL slug <input name="publicSlug" required maxlength="80" pattern="[a-z0-9]+(?:-[a-z0-9]+)*" /></label>
                <label>Region label <input name="regionLabel" maxlength="200" /></label>
                <label>Time zone <input name="timezone" maxlength="80" /></label>
                <label>Public phone <input name="publicPhone" maxlength="40" /></label>
                <label>Public email <input name="publicEmail" type="email" maxlength="200" /></label>
                <label>Hours label <input name="hoursLabel" maxlength="200" /></label>
                <label>Google Business Profile status
                  <select name="gbpStatus">
                    <option value="not_created">Not created</option>
                    <option value="eligibility_review">Eligibility review</option>
                    <option value="prepared">Prepared</option>
                    <option value="submitted">Submitted</option>
                    <option value="verified">Verified</option>
                    <option value="paused">Paused</option>
                  </select>
                </label>
                <label>Google Business Profile URL <input name="gbpUrl" type="url" maxlength="500" /></label>
              </div>
              <fieldset class="admin-field--wide">
                <legend>Service availability</legend>
                <div class="admin-grid">
                  <label>Residential
                    <select name="serviceResidential">
                      <option value="disabled">Disabled</option>
                      <option value="request_only">Request only</option>
                      <option value="estimate_enabled">Estimate enabled</option>
                      <option value="bookable">Bookable</option>
                    </select>
                  </label>
                  <label>STR
                    <select name="serviceStr">
                      <option value="disabled">Disabled</option>
                      <option value="request_only">Request only</option>
                      <option value="estimate_enabled">Estimate enabled</option>
                      <option value="bookable">Bookable</option>
                    </select>
                  </label>
                  <label>Commercial
                    <select name="serviceCommercial">
                      <option value="disabled">Disabled</option>
                      <option value="request_only">Request only</option>
                      <option value="estimate_enabled">Estimate enabled</option>
                      <option value="bookable">Bookable</option>
                    </select>
                  </label>
                  <label>Church
                    <select name="serviceChurch">
                      <option value="disabled">Disabled</option>
                      <option value="request_only">Request only</option>
                      <option value="estimate_enabled">Estimate enabled</option>
                      <option value="bookable">Bookable</option>
                    </select>
                  </label>
                </div>
              </fieldset>
              <label>Service-area ZIPs (comma or line separated)
                <textarea name="serviceAreaZips" rows="6" placeholder="32501, 32502, 32503"></textarea>
              </label>
              <fieldset class="admin-field--wide"><legend>Service states</legend>
                <label><input type="checkbox" name="serviceStateFL" /> Florida</label>
                <label><input type="checkbox" name="serviceStateAL" /> Alabama</label>
              </fieldset>
              <div class="admin-card" style="background:#fbf7f1;">
                <h3>Operating origin</h3>
                <p class="admin-muted">This private branch origin determines customer travel eligibility and dispatch planning. It is never published. Verify it with Google Places before activation.</p>
                <input type="hidden" name="branchId" value="" data-admin-address-branch />
                <div class="admin-field--wide admin-address-block" data-admin-address-block>
                  <div class="admin-address-grid">
                    <label class="admin-field--wide">Street address
                      <input name="addressLine1" maxlength="200" autocomplete="off" data-admin-address-input placeholder="Start typing the verified operating address" />
                    </label>
                    <label>City <input name="city" maxlength="120" data-admin-address-city /></label>
                    <label>State <select name="state" data-admin-address-state><option value="FL">Florida</option><option value="AL">Alabama</option></select></label>
                    <label>ZIP <input name="postalCode" inputmode="numeric" maxlength="10" data-admin-address-zip /></label>
                    <input type="hidden" name="latitude" data-admin-address-lat />
                    <input type="hidden" name="longitude" data-admin-address-lng />
                    <input type="hidden" name="placeId" data-admin-address-place-id />
                  </div>
                  <p class="admin-address-status" data-admin-address-status role="status" aria-live="polite"></p>
                </div>
                <label>Travel limit (one-way miles) <input name="travelLimitMiles" type="number" min="1" max="500" step="0.5" /></label>
              </div>
              <div data-branch-readiness style="margin-bottom:1rem;"></div>
              <label>Launch note <textarea name="launchNote" rows="4" maxlength="1000"></textarea></label>
              <label>Change note <input name="note" maxlength="500" placeholder="Why this setup changed" /></label>
              <div class="admin-actions">
                <button class="btn btn--primary" type="submit">Save branch setup</button>
                <button class="btn btn--ghost btn--small" type="button" data-branch-refresh>Refresh</button>
              </div>
              <p class="admin-status-message" data-branch-form-status role="status" aria-live="polite"></p>
            </form>
          </section>

          <section class="admin-view" data-admin-view="communications" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Communications &amp; notifications</h2>
              <p class="admin-muted">
                The six department addresses are approved architecture. Owners control which department receives each
                operational notice, the reply-to department for customer mail and the approved notification wording.
                Critical security and backup alerts always include both admin@ and owner@.
              </p>
              <div data-admin-communications-status></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Provider and delivery health</h2>
              <div data-admin-communications-provider></div>
              <div data-admin-communications-health style="margin-top:1rem;"></div>
              <div data-admin-communications-failures style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;" data-admin-owner-section>
              <h2 class="admin-section-title">Routing and templates</h2>
              <form data-communications-form>
                <h3 class="admin-section-title" style="font-size:1rem;">Notification routing</h3>
                <div data-communications-routing></div>
                <h3 class="admin-section-title" style="font-size:1rem;margin-top:1.25rem;">Reply-to department</h3>
                <div data-communications-reply-to></div>
                <h3 class="admin-section-title" style="font-size:1rem;margin-top:1.25rem;">Approved template</h3>
                <label>Template <select data-communications-template-select></select></label>
                <label>Subject <input data-communications-subject maxlength="200" /></label>
                <label>Body <textarea data-communications-body rows="10" maxlength="6000"></textarea></label>
                <div class="admin-actions">
                  <button class="btn btn--ghost btn--small" type="button" data-admin-action="communications-preview">Preview</button>
                  <button class="btn btn--ghost btn--small" type="button" data-admin-action="communications-reset">Reset form to saved settings</button>
                </div>
                <div data-communications-preview style="margin-top:.75rem;"></div>
                <h3 class="admin-section-title" style="font-size:1rem;margin-top:1.25rem;">Alert thresholds</h3>
                <div class="admin-form admin-form--grid">
                  <label>Owner escalation (minutes) <input data-communications-escalation type="number" min="5" max="1440" /></label>
                  <label>Failure threshold before escalation <input data-communications-threshold type="number" min="1" max="100" /></label>
                </div>
                <label>Change note <input data-communications-note maxlength="500" placeholder="Why this configuration changed" /></label>
                <div class="admin-actions">
                  <button class="btn btn--primary btn--small" type="submit">Save configuration</button>
                </div>
                <p class="admin-status-message" data-communications-form-status role="status" aria-live="polite"></p>
                <div data-communications-errors class="admin-error" role="alert"></div>
              </form>
            </div>
            <div class="admin-card" style="margin-top:1rem;" data-admin-owner-section>
              <h2 class="admin-section-title">Controlled delivery test</h2>
              <p class="admin-muted">
                Sends a clearly marked test email with no customer data. Only do this when you can check the destination
                mailbox. A provider acceptance is not inbox proof.
              </p>
              <div class="admin-inline-form">
                <label>Department <select data-communications-test-department></select></label>
                <button class="btn btn--secondary btn--small" type="button" data-admin-action="communications-test">Send test message</button>
              </div>
              <p class="admin-status-message" data-communications-test-status role="status" aria-live="polite"></p>
            </div>
            <div class="admin-card" style="margin-top:1rem;" data-admin-owner-section>
              <h2 class="admin-section-title">Version history</h2>
              <div data-communications-versions></div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="settings" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Your security</h2>
              <div data-admin-mfa-status></div>
              <div data-admin-mfa-setup style="margin-top:1rem;"></div>
              <button class="btn btn--ghost btn--small" type="button" data-admin-revoke-others>Sign out other sessions</button>
              <form class="admin-form" data-admin-password-change style="margin-top:1.25rem;">
                <h3 style="font-size:.95rem;margin:0;">Change password</h3>
                <label>Current password <input name="currentPassword" type="password" autocomplete="current-password" required /></label>
                <label>New password
                  <input name="newPassword" type="password" autocomplete="new-password" required minlength="8" maxlength="200" data-admin-password-new aria-describedby="admin-change-password-hint" />
                </label>
                <label>Confirm new password <input name="confirmPassword" type="password" autocomplete="new-password" required data-admin-password-confirm /></label>
                <p class="admin-muted" id="admin-change-password-hint">At least 8 characters, including one special character (for example ! @ # $ %).</p>
                <button class="btn btn--secondary btn--small" type="submit">Update password</button>
                <p class="admin-status-message" data-admin-password-change-status role="status" aria-live="polite"></p>
              </form>
            </div>
            <div class="admin-card" style="margin-top:1rem;" data-admin-owner-section>
              <h2 class="admin-section-title">Administrators</h2>
              <div data-admin-admins></div>
              <form class="admin-form" data-admin-invite-create style="max-width:none;margin-top:1rem;">
                <label>Email <input name="email" type="email" required /></label>
                <label>Role <select name="role"><option value="manager">Manager</option><option value="finance">Finance</option><option value="cleaner">Cleaner</option></select></label>
                <label>Branch <select name="branchId"><option value="">All branches</option><option value="branch_pensacola">Pensacola</option></select></label>
                <button class="btn btn--primary btn--small" type="submit">Create invitation</button>
              </form>
              <div data-admin-invite-result style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Sessions</h2>
              <div data-admin-sessions></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;" data-admin-owner-section>
              <h2 class="admin-section-title">Audit history</h2>
              <div data-admin-audit></div>
              <div data-admin-audit-pagination style="margin-top:.75rem;"></div>
            </div>
          </section>
        </div>
      </div>
    </main>
    <script>
      import '../../scripts/admin';
    </script>
  </body>
</html>
