---
import '../../styles/global.css';
import '../../styles/admin.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sparkling Standard Operations</title>
  </head>
  <body class="admin-body">
    <main class="admin-main" id="main">
      <div class="admin-gate" data-admin-gate>
        <div class="admin-card" style="max-width: 32rem; margin: 8vh auto 0;">
          <p class="admin-brand__sub">Sparkling Standard</p>
          <h1 class="admin-title">Operations</h1>
          <p class="admin-sub">Private cleaning-company administration.</p>
          <p class="admin-muted" data-admin-gate-status>Checking secure session.</p>

          <form class="admin-form" data-admin-setup hidden>
            <h2 style="font-size:1.1rem;margin:.5rem 0 0;">Create the owner account</h2>
            <p class="admin-muted">Use the setup code configured in the server environment.</p>
            <label>Setup code <input name="setupCode" type="password" autocomplete="one-time-code" required /></label>
            <label>Owner name <input name="name" type="text" autocomplete="name" required /></label>
            <label>Owner email <input name="email" type="email" autocomplete="email" required /></label>
            <label>Password
              <input name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="200" data-admin-password-new aria-describedby="admin-setup-password-hint" />
            </label>
            <p class="admin-muted" id="admin-setup-password-hint">At least 8 characters, including one special character (for example ! @ # $ %).</p>
            <button class="btn btn--primary" type="submit">Create Secure Owner Account</button>
          </form>

          <form class="admin-form" data-admin-login>
            <h2 style="font-size:1.1rem;margin:.5rem 0 0;">Sign in</h2>
            <label>Email <input name="email" type="email" autocomplete="username" required /></label>
            <label>Password <input name="password" type="password" autocomplete="current-password" required /></label>
            <button class="btn btn--primary" type="submit">Sign In</button>
            <p class="admin-muted admin-forgot"><button class="admin-link" type="button" data-admin-forgot>Forgot Password?</button></p>
          </form>

          <form class="admin-form" data-admin-forgot-form hidden>
            <h2 style="font-size:1.1rem;margin:.5rem 0 0;">Reset your password</h2>
            <p class="admin-muted">
              Enter the email address for your administrator account. If it matches an active
              account, we will email a single-use link that lets you choose a new password.
            </p>
            <label>Email <input name="email" type="email" autocomplete="username" required /></label>
            <button class="btn btn--primary" type="submit">Send Reset Link</button>
            <button class="btn btn--ghost btn--small" type="button" data-admin-back-to-login>Return to Sign In</button>
            <p class="admin-status-message" data-admin-forgot-status role="status" aria-live="polite"></p>
          </form>

          <form class="admin-form" data-admin-mfa hidden>
            <h2 style="font-size:1.1rem;margin:.5rem 0 0;">Two-step verification</h2>
            <p class="admin-muted">Enter the current authenticator code. A recovery code also works.</p>
            <label>Authenticator code <input name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" /></label>
            <label>Recovery code <input name="recoveryCode" autocomplete="off" maxlength="40" /></label>
            <button class="btn btn--primary" type="submit">Verify and Sign In</button>
            <button class="btn btn--ghost btn--small" type="button" data-admin-mfa-cancel>Back to sign in</button>
          </form>

          <form class="admin-form" data-admin-invite hidden>
            <h2 style="font-size:1.1rem;margin:.5rem 0 0;">Accept administrator invitation</h2>
            <label>Your name <input name="name" type="text" autocomplete="name" required /></label>
            <label>Create password
              <input name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="200" data-admin-password-new aria-describedby="admin-invite-password-hint" />
            </label>
            <label>Confirm password <input name="confirmPassword" type="password" autocomplete="new-password" required data-admin-password-confirm /></label>
            <p class="admin-muted" id="admin-invite-password-hint">At least 8 characters, including one special character (for example ! @ # $ %).</p>
            <button class="btn btn--primary" type="submit">Accept Invitation</button>
          </form>

          <form class="admin-form" data-admin-reset hidden>
            <h2 style="font-size:1.1rem;margin:.5rem 0 0;">Set a new password</h2>
            <label>New password
              <input name="password" type="password" autocomplete="new-password" required minlength="8" maxlength="200" data-admin-password-new aria-describedby="admin-reset-password-hint" />
            </label>
            <label>Confirm new password <input name="confirmPassword" type="password" autocomplete="new-password" required data-admin-password-confirm /></label>
            <p class="admin-muted" id="admin-reset-password-hint">At least 8 characters, including one special character (for example ! @ # $ %).</p>
            <button class="btn btn--primary" type="submit">Update Password</button>
            <button class="btn btn--ghost btn--small" type="button" data-admin-back-to-login>Return to Sign In</button>
            <p class="admin-status-message" data-admin-reset-status role="status" aria-live="polite"></p>
          </form>
          <p class="admin-error" data-admin-error role="alert"></p>
          <p class="admin-status-message" data-admin-success role="status" aria-live="polite"></p>
        </div>
      </div>

      <div class="admin-shell" data-admin-app hidden>
        <aside class="admin-sidebar">
          <a class="admin-brand" href="/admin/">
            <span class="admin-brand__mark">S</span>
            <span><span class="admin-brand__name">Sparkling<br />Standard</span><br /><span class="admin-brand__sub">Operations</span></span>
          </a>
          <nav class="admin-nav" aria-label="Admin sections">
            <button type="button" data-admin-nav="overview">Overview</button>
            <button type="button" data-admin-nav="calendar">Calendar &amp; Requests</button>
            <button type="button" data-admin-nav="leads">Leads &amp; Inquiries</button>
            <button type="button" data-admin-nav="customers">Customers</button>
            <button type="button" data-admin-nav="recurring">Recurring Plans</button>
            <button type="button" data-admin-nav="jobs">Jobs &amp; Team</button>
            <button type="button" data-admin-nav="timekeeping">Timekeeping</button>
            <button type="button" data-admin-nav="finance">Invoices &amp; Payments</button>
            <button type="button" data-admin-nav="gift">Gift Certificates</button>
            <button type="button" data-admin-nav="reports">Reports</button>
            <button type="button" data-admin-nav="settings">Settings &amp; Audit</button>
          </nav>
          <div class="admin-sidebar__meta">
            <p data-admin-user></p>
            <button class="btn btn--ghost btn--small" type="button" data-admin-logout>Sign out</button>
          </div>
        </aside>

        <div class="admin-workspace">
          <header class="admin-topbar">
            <div>
              <h1 class="admin-title" data-admin-view-title>Overview</h1>
              <p class="admin-sub" data-admin-view-sub>Live cleaning-company operations.</p>
            </div>
            <span class="admin-status" data-admin-role></span>
          </header>
          <p class="admin-error" data-admin-app-error role="alert"></p>

          <section class="admin-view" data-admin-view="overview">
            <div class="admin-grid" data-admin-kpis></div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Recent inquiries</h2>
              <div data-admin-recent></div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="calendar" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Next seven days</h2>
              <p class="admin-muted">Operational board for scheduling and staffing. Later confirmed appointments remain intact below.</p>
              <div data-admin-week-board></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Reservation requests</h2>
              <p class="admin-muted">Actionable requests appear by default. Search includes closed, archived and historical records.</p>
              <form class="admin-inline-form" data-admin-request-filter>
                <select name="view" aria-label="Request view">
                  <option value="actionable">Actionable</option>
                  <option value="pending">Pending</option>
                  <option value="confirmed">Confirmed</option>
                  <option value="completed">Completed</option>
                  <option value="declined">Declined / cancelled</option>
                  <option value="closed">Closed</option>
                  <option value="archived">Archived</option>
                  <option value="all">All / historical</option>
                </select>
                <input name="q" type="search" placeholder="Search reference, customer, address" aria-label="Search requests" />
                <button class="btn btn--secondary btn--small" type="submit">Search</button>
              </form>
              <div data-admin-requests></div>
            </div>
            <div data-admin-request-detail style="margin-top:1rem;" hidden></div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Upcoming appointments</h2>
              <div data-admin-appointments></div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="leads" hidden>
            <div class="admin-card">
              <form class="admin-inline-form" data-admin-lead-filter>
                <label>Status <select name="status"><option value="">All</option><option value="new">New</option><option value="contacted">Contacted</option><option value="quoted">Quoted</option><option value="converted">Converted</option><option value="lost">Lost</option><option value="archived">Archived</option></select></label>
                <label>Search <input name="q" type="search" placeholder="Name, reference, address" /></label>
                <button class="btn btn--secondary btn--small" type="submit">Filter</button>
              </form>
              <div data-admin-leads style="margin-top:1rem;"></div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="customers" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Customers</h2>
              <form class="admin-inline-form" data-admin-customer-search>
                <label>Search <input name="q" type="search" placeholder="Name, email or phone" /></label>
                <button class="btn btn--secondary btn--small" type="submit">Search</button>
                <button class="btn btn--ghost btn--small" type="button" data-admin-customer-new>New customer</button>
              </form>
              <div data-admin-customers style="margin-top:1rem;"></div>
              <div class="admin-detail" data-admin-customer-detail hidden></div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="recurring" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Recurring cleaning plans</h2>
              <div data-admin-recurring></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Create a recurring plan</h2>
              <form class="admin-form" data-admin-recurring-create>
                <label>Customer <select name="customerId" data-admin-customer-options required></select></label>
                <label>Property <select name="propertyId" data-admin-property-options required></select></label>
                <label>Frequency <select name="frequency"><option value="biweekly">Every two weeks</option><option value="weekly">Weekly</option><option value="monthly">Monthly</option></select></label>
                <label>First visit date <input name="startDate" type="date" required /></label>
                <label>Ongoing price per visit (USD) <input name="ongoingPrice" type="number" min="0" step="0.01" required /></label>
                <button class="btn btn--primary" type="submit">Create Plan</button>
              </form>
            </div>
          </section>

          <section class="admin-view" data-admin-view="jobs" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Jobs</h2>
              <div data-admin-jobs></div>
              <div data-admin-checklist style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Team</h2>
              <div data-admin-team></div>
              <form class="admin-inline-form" data-admin-team-create style="margin-top:1rem;">
                <label>Name <input name="displayName" required /></label>
                <label>Email <input name="email" type="email" /></label>
                <button class="btn btn--secondary btn--small" type="submit">Add team member</button>
              </form>
            </div>
          </section>

          <section class="admin-view" data-admin-view="timekeeping" hidden>
            <div class="admin-card">
              <div class="admin-inline-form" style="align-items:end;">
                <label>Week starting <input type="date" data-time-week /></label>
                <button class="btn btn--secondary btn--small" type="button" data-admin-action="time-load">Load Week</button>
                <button class="btn btn--ghost btn--small" type="button" data-admin-action="time-export">Export CSV</button>
              </div>
              <div class="admin-grid" data-admin-time-summary style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Employees</h2>
              <p class="admin-muted">Preliminary hours. Correct a timecard below; every correction records the reason and the previous values.</p>
              <div data-admin-time-employees></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Intervals and corrections</h2>
              <div data-admin-time-intervals></div>
              <details class="admin-detail-toggle" style="margin-top:1rem;"><summary>Correct a time interval</summary>
                <form class="admin-form admin-form--grid" data-form="time-correct">
                  <input type="hidden" name="intervalId" data-time-interval-id />
                  <label>Start (Central) <input name="startedAt" type="datetime-local" required /></label>
                  <label>End (Central) <input name="endedAt" type="datetime-local" required /></label>
                  <label>Kind <select name="kind"><option value="work">Work</option><option value="break">Paid rest break</option><option value="meal">Meal</option></select></label>
                  <label>Rate type <select name="rateType"><option value="regular">Regular</option><option value="lead">Lead</option><option value="solo">Solo assignment</option></select></label>
                  <label><input type="checkbox" name="paid" value="yes" /> Paid interval</label>
                  <label class="admin-field--wide">Reason (required) <input name="reason" maxlength="500" required /></label>
                  <button class="btn btn--primary btn--small" type="submit">Save Correction</button>
                </form>
              </details>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Pending correction requests</h2>
              <div data-admin-time-corrections></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Location verification</h2>
              <p class="admin-muted">Recorded only when an employee taps a clock action. Never continuous tracking.</p>
              <div data-admin-time-events></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Staff access</h2>
              <div class="admin-grid">
                <div>
                  <h3>Invite a cleaner</h3>
                  <form class="admin-form" data-form="time-invite">
                    <label>Email <input name="email" type="email" required /></label>
                    <button class="btn btn--secondary btn--small" type="submit">Send Employee Invitation</button>
                  </form>
                  <div data-time-invite-result style="margin-top:.6rem;"></div>
                </div>
                <div>
                  <h3>Link an account to the roster</h3>
                  <form class="admin-form" data-form="time-link">
                    <label>Account email <input name="email" type="email" required /></label>
                    <label>Team member <select name="teamMemberId" data-time-team-options required></select></label>
                    <button class="btn btn--secondary btn--small" type="submit">Link Account</button>
                  </form>
                </div>
              </div>
              <div data-admin-owner-time-rates style="margin-top:1rem;">
                <h3>Pay rates (owner only)</h3>
                <form class="admin-form admin-form--grid" data-form="time-rate">
                  <label>Team member <select name="teamMemberId" data-time-team-options required></select></label>
                  <label>Rate <select name="rateType"><option value="regular">Regular ? $18/hr</option><option value="lead">Lead ? $22/hr</option><option value="solo">Solo assignment ? $25/hr</option></select></label>
                  <label>Hourly (USD) <input name="hourly" type="number" min="0" step="0.01" required /></label>
                  <label>Effective from <input name="effectiveFrom" type="date" required /></label>
                  <button class="btn btn--secondary btn--small" type="submit">Update Rate</button>
                </form>
              </div>
            </div>
          </section>

          <section class="admin-view" data-admin-view="finance" hidden>
            <div class="admin-grid" data-admin-finance-summary></div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Invoices</h2>
              <div data-admin-invoices></div>
              <div data-admin-invoice-detail style="margin-top:1rem;"></div>
              <div data-admin-invoice-controls style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Create an invoice</h2>
              <form class="admin-form" data-admin-invoice-create>
                <label>Customer <select name="customerId" data-admin-customer-options required></select></label>
                <label>Description <input name="description" required /></label>
                <label>Amount (USD) <input name="amount" type="number" min="0.01" step="0.01" required /></label>
                <label>Due date <input name="dueDate" type="date" required /></label>
                <button class="btn btn--primary" type="submit">Create Invoice</button>
              </form>
            </div>
          </section>

          <section class="admin-view" data-admin-view="gift" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Gift certificates</h2>
              <form class="admin-inline-form" data-admin-gift-filter>
                <label>Search <input name="q" type="search" placeholder="Code, purchaser, recipient or email" /></label>
                <label>Status <select name="status"><option value="">All</option><option value="active">Active</option><option value="scheduled">Scheduled (future)</option><option value="fully_redeemed">Fully redeemed</option><option value="refunded">Refunded</option><option value="void">Voided</option></select></label>
                <button class="btn btn--secondary btn--small" type="submit">Filter</button>
              </form>
              <div data-admin-gifts style="margin-top:1rem;"></div>
              <div data-admin-gift-detail style="margin-top:1rem;"></div>
              <p style="margin-top:1rem;"><a class="btn btn--secondary" href="/gift-admin/">Open Gift Register for Adjustments</a></p>
              <p class="admin-muted">The existing production register remains authoritative for balances. Redemption against an invoice is available from the invoice view.</p>
            </div>
          </section>

          <section class="admin-view" data-admin-view="reports" hidden>
            <div data-admin-reports></div>
          </section>

          <section class="admin-view" data-admin-view="settings" hidden>
            <div class="admin-card">
              <h2 class="admin-section-title">Your security</h2>
              <div data-admin-mfa-status></div>
              <div data-admin-mfa-setup style="margin-top:1rem;"></div>
              <button class="btn btn--ghost btn--small" type="button" data-admin-revoke-others>Sign out other sessions</button>
              <form class="admin-form" data-admin-password-change style="margin-top:1.25rem;">
                <h3 style="font-size:.95rem;margin:0;">Change password</h3>
                <label>Current password <input name="currentPassword" type="password" autocomplete="current-password" required /></label>
                <label>New password
                  <input name="newPassword" type="password" autocomplete="new-password" required minlength="8" maxlength="200" data-admin-password-new aria-describedby="admin-change-password-hint" />
                </label>
                <label>Confirm new password <input name="confirmPassword" type="password" autocomplete="new-password" required data-admin-password-confirm /></label>
                <p class="admin-muted" id="admin-change-password-hint">At least 8 characters, including one special character (for example ! @ # $ %).</p>
                <button class="btn btn--secondary btn--small" type="submit">Update password</button>
                <p class="admin-status-message" data-admin-password-change-status role="status" aria-live="polite"></p>
              </form>
            </div>
            <div class="admin-card" style="margin-top:1rem;" data-admin-owner-section>
              <h2 class="admin-section-title">Administrators</h2>
              <div data-admin-admins></div>
              <form class="admin-form" data-admin-invite-create style="max-width:none;margin-top:1rem;">
                <label>Email <input name="email" type="email" required /></label>
                <label>Role <select name="role"><option value="manager">Manager</option><option value="finance">Finance</option><option value="cleaner">Cleaner</option></select></label>
                <label>Branch <select name="branchId"><option value="">All branches</option><option value="branch_pensacola">Pensacola</option></select></label>
                <button class="btn btn--primary btn--small" type="submit">Create invitation</button>
              </form>
              <div data-admin-invite-result style="margin-top:1rem;"></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;">
              <h2 class="admin-section-title">Sessions</h2>
              <div data-admin-sessions></div>
            </div>
            <div class="admin-card" style="margin-top:1rem;" data-admin-owner-section>
              <h2 class="admin-section-title">Audit history</h2>
              <div data-admin-audit></div>
            </div>
          </section>
        </div>
      </div>
    </main>
    <script>
      import '../../scripts/admin';
    </script>
  </body>
</html>
