---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import ServiceAreaMap from '../components/ServiceAreaMap.astro';
import TampaServiceAreaMap from '../components/TampaServiceAreaMap.astro';
import FloridaServiceAreaOverview from '../components/FloridaServiceAreaOverview.astro';
import { breadcrumbNode } from '../lib/schema';

const entry = await getEntry('site', 'service-area');
if (!entry) throw new Error('Missing content entry: src/content/site/service-area.md');
const { data } = entry;

const site = Astro.site ?? new URL('https://pending-website-url.invalid');
const schema = [
  breadcrumbNode(site, [
    { name: 'Home', path: '/' },
    { name: 'Service Area', path: '/service-area/' },
  ]),
];
---

<BaseLayout title={data.metaTitle} description={data.metaDescription} schema={schema}>
  <section class="section section--tight area-intro">
    <div class="container">
      <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Service Area', path: '/service-area/' }]} />
      <div class="section-head mt-4">
        <h1 data-service-area-heading>
          {data.hero.headline}
          {data.hero.accent && <span class="hero__accent">{data.hero.accent}</span>}
        </h1>
        <p class="lead" data-service-area-lead>{data.hero.lead}</p>
      </div>
    </div>
  </section>

  <!-- SERVICE_AREA_SINGLE_START -->
  <div data-service-area-single-start hidden></div>
  <div data-service-area-single>
    <section class="section section--tight area-map-section">
      <div class="container">
        <div class="section-head section-head--center">
          <p class="eyebrow">Pensacola &amp; Northwest Florida</p>
          <h2>Our Pensacola service area</h2>
          <p class="lead">Owner-operated cleaning across Pensacola, Cantonment and approved surrounding communities.</p>
        </div>
        <ServiceAreaMap />
      </div>
    </section>

    <section class="section section--alt">
      <div class="container split">
        <div>
          <p class="eyebrow">Coverage</p>
          <h2>{data.communities?.heading}</h2>
          <p>{data.communities?.lead}</p>
          <ul class="checklist mt-4">
            {data.communities?.list.map((place) => (
              <li>
                <Icon name="map-pin" size={18} />
                <span>{place}</span>
              </li>
            ))}
          </ul>
          {data.coverageNote && <p class="small text-muted mt-4">{data.coverageNote}</p>}
        </div>
        <div class="card">
          <p class="eyebrow">Beyond the usual map</p>
          <h2 class="card__title">{data.beyond?.heading}</h2>
          <p class="card__text">{data.beyond?.text}</p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container container--narrow stack">
        {
          data.sections.map((section) => (
            <div>
              {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
              <h2>{section.heading}</h2>
              {section.lead && <p class="lead">{section.lead}</p>}
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          ))
        }
      </div>
    </section>
  </div>
  <div data-service-area-single-end hidden></div>
  <!-- SERVICE_AREA_SINGLE_END -->

  <!-- SERVICE_AREA_MULTI_START -->
  <div data-service-area-multi-start hidden></div>
  <template data-service-area-multi-template>
    <section class="section section--tight">
      <div class="container">
        <div class="section-head section-head--center">
          <p class="eyebrow">Our Service Areas</p>
          <h2>Sparkling Standard Cleaning Co. &middot; Our Service Areas</h2>
          <p class="lead">Two owner-operated Florida regions, each with its own local coverage and confirmation process.</p>
        </div>
        <FloridaServiceAreaOverview />
      </div>
    </section>

    <section class="section section--alt">
      <div class="container stack">
        <div class="service-region">
          <div class="service-region__copy">
            <p class="eyebrow">Northwest Florida</p>
            <h2>Pensacola / Northwest Florida</h2>
            <p>Owner-operated residential, commercial, church and STR cleaning across Pensacola, Cantonment and approved surrounding communities. Select nearby Alabama communities are available by arrangement.</p>
            <p><a class="btn btn--secondary" href="/locations/pensacola/" data-cta="area-pensacola-branch">Explore Pensacola operations</a></p>
          </div>
          <div class="service-region__map"><ServiceAreaMap /></div>
        </div>

        <div class="service-region service-region--reverse">
          <div class="service-region__copy">
            <p class="eyebrow">Tampa Bay / Central Florida</p>
            <h2>Tampa Bay / Central Florida</h2>
            <p>Approved service areas in Pasco, Pinellas and Hillsborough Counties. Tampa eligibility requires both an approved ZIP and a verified road-driving distance of 20 miles or less from the Tampa operating origin.</p>
            <p><a class="btn btn--secondary" href="/locations/tampa-bay/" data-cta="area-tampa-branch">Explore Tampa Bay operations</a></p>
          </div>
          <div class="service-region__map"><TampaServiceAreaMap /></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container split">
        <div>
          <p class="eyebrow">Coverage</p>
          <h2>{data.communities?.heading}</h2>
          <p>{data.communities?.lead}</p>
          <ul class="checklist mt-4">
            {data.communities?.list.map((place) => (
              <li>
                <Icon name="map-pin" size={18} />
                <span>{place}</span>
              </li>
            ))}
          </ul>
          {data.coverageNote && <p class="small text-muted mt-4">{data.coverageNote}</p>}
        </div>
        <div class="card">
          <p class="eyebrow">Beyond the usual map</p>
          <h2 class="card__title">{data.beyond?.heading}</h2>
          <p class="card__text">{data.beyond?.text}</p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container container--narrow stack">
        {
          data.sections.map((section) => (
            <div>
              {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
              <h2>{section.heading}</h2>
              {section.lead && <p class="lead">{section.lead}</p>}
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          ))
        }
      </div>
    </section>
  </template>
  <div data-service-area-multi-end hidden></div>
  <!-- SERVICE_AREA_MULTI_END -->

  <div class="container section section--tight">
    <CtaBand
      title={data.ctaBand?.heading ?? 'Not sure if we reach you?'}
      text={data.ctaBand?.text}
      primaryLabel="Check Your Address"
      primaryHref="/estimate/"
      secondaryLabel="Ask Directly"
      secondaryHref="/contact/"
    />
  </div>
</BaseLayout>
