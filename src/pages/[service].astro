---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Checklist from '../components/Checklist.astro';
import FaqItem from '../components/FaqItem.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CtaBand from '../components/CtaBand.astro';
import PremiumIcon from '../components/PremiumIcon.astro';
import Scripture from '../components/Scripture.astro';
import type { ScriptureId } from '../config/scriptures';
import { serviceNode, breadcrumbNode, faqNode } from '../lib/schema';
import { pricing } from '../config/pricing';
import { replacePricingTokens } from '../lib/content/pricing-text';

export async function getStaticPaths() {
  const services = await getCollection('services');
  // Recurring Residential Cleaning has its own dedicated page
  // (src/pages/recurring-cleaning.astro) with the owner-directed structure:
  // centered hero, ongoing-value story, grouped Included Services, the CTA
  // band directly under "What this service doesn't cover", and the deep-first
  // policy section after it. It must not also render through this template.
  return services
    .filter((entry) => entry.data.path !== '/recurring-cleaning/')
    .map((entry) => ({
      params: { service: entry.data.path.replaceAll('/', '') },
      props: { entry },
    }));
}

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const data = replacePricingTokens(entry.data);
const { Content } = await render(entry);
const churchDiscountPercent = pricing.churchDiscount.percent.value;

const serviceScripture: ScriptureId =
  entry.id === 'church-cleaning'
    ? 'glory'
    : entry.id === 'commercial-cleaning'
      ? 'integrity'
      : entry.id === 'short-term-rental-cleaning'
        ? 'hospitality'
        : entry.id === 'move-in-move-out-cleaning'
          ? 'workmanship'
          : entry.id === 'deep-cleaning'
            ? 'excellence'
            : 'service';

const site = Astro.site ?? new URL('https://pending-website-url.invalid');
const services = await getCollection('services');
const faqs = await getCollection('faqs');
const checklists = await getCollection('checklists');

const pageFaqs = faqs
  .filter((faq) => data.faqIds.includes(faq.id))
  .sort((a, b) => a.data.order - b.data.order);

const related = services
  .filter((service) => data.related.includes(service.data.path))
  .sort((a, b) => a.data.order - b.data.order);

const checklist = data.checklistId
  ? checklists.find((item) => item.id === data.checklistId && item.data.visibility === 'public')
  : undefined;

// ONE authoritative request path per service family (Initiative 6.0). The old
// embedded STR and walkthrough forms are retired: every CTA enters the same
// estimate system with the right engine selected.
const engineRequest =
  data.embedForm === 'str'
    ? {
        href: '/estimate/str/',
        label: 'Get a Turnover Estimate',
        eyebrow: 'Turnover estimate',
        heading: 'One turnover request, priced for your property',
        lead: 'Tell us about the property, linen plan and guest windows. Sparkling Standard reviews every turnover request personally and confirms scope, schedule and price before anything is booked.',
        cta: 'estimate-engine-str',
      }
    : entry.id === 'church-cleaning'
      ? {
          href: '/estimate/church/',
          label: 'Estimate Church Cleaning',
          eyebrow: 'Church estimate',
          heading: `A church estimate with our ${churchDiscountPercent}% church discount`,
          lead: `Tell us about your sanctuary, classrooms, fellowship spaces and schedule. Sparkling Standard confirms the scope and your ${churchDiscountPercent}% church discount personally before anything is scheduled.`,
          cta: 'estimate-engine-church',
        }
      : {
          href: '/estimate/commercial/',
          label: 'Estimate My Facility Cleaning',
          eyebrow: 'Facility estimate',
          heading: 'A cleaning estimate built around your facility',
          lead: 'Tell us about your space and access needs. Sparkling Standard reviews the scope and confirms a clear commercial price with you before any work begins.',
          cta: 'estimate-engine-commercial',
        };

const schema = [
  serviceNode({
    site,
    name: data.title,
    description: data.metaDescription,
    path: data.path,
    serviceType: data.serviceType,
  }),
  breadcrumbNode(site, [
    { name: 'Home', path: '/' },
    { name: data.title, path: data.path },
  ]),
  ...(pageFaqs.length > 0
    ? [faqNode(pageFaqs.map((faq) => ({ question: faq.data.question, answer: faq.data.answer })))]
    : []),
];
---

<BaseLayout title={data.metaTitle ?? data.title} description={data.metaDescription} schema={schema}>
  <section class="section section--tight">
    <div class="container">
      <Breadcrumbs
        trail={[
          { name: 'Home', path: '/' },
          { name: data.title, path: data.path },
        ]}
      />
      <div class="split" style="align-items: start; margin-top: var(--space-5)">
        <div>
          {data.heroEyebrow && <p class="eyebrow">{data.heroEyebrow}</p>}
          <h1>{data.title} in Pensacola &amp; Cantonment</h1>
          <p class="lead">{data.heroLead}</p>
          <div class="btn-row mt-4">
            <a class="btn btn--primary btn--large" href={data.ctaHref} data-cta="service-primary">
              {data.ctaLabel}
            </a>
            <a class="btn btn--ghost" href="/contact/" data-cta="service-contact">Ask a Question</a>
          </div>
        </div>
        <div class="card card--muted">
          <PremiumIcon name={data.icon} size={5} class="card__premium-icon" />
          <h2 class="card__title" style="margin-top: var(--space-3)">Who this is for</h2>
          <Checklist items={data.goodFor} />
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split split--sidebar">
      <div class="prose">
        <Content />
      </div>
      <aside class="stack">
        {
          data.includes.length > 0 && (
            <div class="card">
              <h2 class="card__title">What's normally included</h2>
              <Checklist items={data.includes} />
            </div>
          )
        }
        {
          checklist && (
            <div class="card card--muted">
              <h2 class="card__title">{checklist.data.title}</h2>
              <Checklist items={checklist.data.items} />
              {checklist.data.note && <p class="small text-muted" style="margin-top: var(--space-3)">{checklist.data.note}</p>}
            </div>
          )
        }
      </aside>
    </div>
  </section>

  {
    data.notIncluded.length > 0 && !data.hideNotIncluded && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Honest boundaries</p>
            <h2>What this service doesn't cover</h2>
            <p class="lead">
              Being clear up front prevents surprises. Some of these are easy add-ons; others are
              services we don't offer and will tell you so directly.
            </p>
          </div>
          <div class="grid grid--2">
            <div class="card">
              <Checklist items={data.notIncluded} />
            </div>
            <div class="card card--muted">
              <h3 class="card__title">Prefer to ask first?</h3>
              <p class="card__text">
                If you're unsure whether your situation fits, describe it in the estimate or send a
                message — there's no judgment in the question.
              </p>
              <a class="btn btn--secondary" href="/contact/">Ask Us</a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    data.embedForm && (
      <section class="section" id="engine-request">
        <div class="container container--narrow">
          <div class="section-head">
            <p class="eyebrow">{engineRequest.eyebrow}</p>
            <h2>{engineRequest.heading}</h2>
            <p class="lead">{engineRequest.lead}</p>
          </div>
          <div class="btn-row">
            <a class="btn btn--primary btn--large" href={engineRequest.href} data-cta={engineRequest.cta}>
              {engineRequest.label}
            </a>
            <a class="btn btn--ghost" href="/contact/">Prefer to talk it through?</a>
          </div>
        </div>
      </section>
    )
  }

  {
    pageFaqs.length > 0 && (
      <section class="section section--alt">
        <div class="container container--narrow">
          <div class="section-head">
            <p class="eyebrow">Common questions</p>
            <h2>{data.title} questions</h2>
          </div>
          <div class="faq-list">
            {pageFaqs.map((faq) => (
              <FaqItem question={faq.data.question} answer={faq.data.answer} />
            ))}
          </div>
          <p class="mt-4">
            <a href="/faq/">See all frequently asked questions →</a>
          </p>
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <p class="eyebrow">Related services</p>
            <h2>You might also be looking for</h2>
          </div>
          <div class="grid grid--3">
            {related.map((service) => (
              <ServiceCard
                title={service.data.title}
                summary={service.data.summary}
                href={service.data.path}
                icon={service.data.icon}
              />
            ))}
          </div>        </div>
      </section>
    )
  }

  <section class="section section--tight" aria-label="A reflection on this work">
    <div class="container">
      <Scripture verse={serviceScripture} variant="panel" />
    </div>
  </section>

  <div class="container section section--tight">
    <CtaBand
      title={`Ready for ${data.title.toLowerCase()}?`}
      text={data.hideClosingCtaText ? undefined : 'Start with the estimate — it tells you honestly what your home needs and what it should cost.'}
      primaryLabel={data.ctaLabel}
      primaryHref={data.ctaHref}
      secondaryLabel="Get in Touch"
      secondaryHref="/contact/"
    />
  </div>
</BaseLayout>
