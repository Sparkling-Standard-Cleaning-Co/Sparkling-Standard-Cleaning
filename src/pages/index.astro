---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeServiceCard from '../components/HomeServiceCard.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import TrustChips from '../components/TrustChips.astro';
import FaqItem from '../components/FaqItem.astro';
import Checklist from '../components/Checklist.astro';
import Reviews from '../components/Reviews.astro';
import Icon from '../components/Icon.astro';
import { breadcrumbNode } from '../lib/schema';
import { homepageServicePaths } from '../lib/site';
import type { ImageMetadata } from 'astro';
import hayliPortrait from '../assets/images/hayli-founder.webp';
import livingRoomBright from '../assets/images/living-room-bright.jpg';
import bathroomSpacious from '../assets/images/bathroom-spacious.jpg';
import kitchenWhiteClean from '../assets/images/kitchen-white-clean.jpg';
import bedroomMade from '../assets/images/bedroom-made.jpg';
import livingRoomMaintained from '../assets/images/living-room-maintained.jpg';
import vacationBedroom from '../assets/images/vacation-bedroom.jpg';
import emptyRoomMoveout from '../assets/images/empty-room-moveout.jpg';
import officePlanted from '../assets/images/office-planted.jpg';
import kitchenSinkDetail from '../assets/images/kitchen-sink-detail.jpg';

const home = await getEntry('site', 'home');
if (!home) throw new Error('Missing content entry: src/content/site/home.md');
const { data } = home;

const allServices = await getCollection('services');
// Exactly the five primary homepage cards. Church Cleaning is in the
// navigation/footer but must not become a sixth card (owner direction).
const services = homepageServicePaths.flatMap((path) => {
  const service = allServices.find((entry) => entry.data.path === path);
  return service ? [service] : [];
});

// Representative interior per service (licensed stock; never claimed as our
// work — see docs/design/IMAGE-SOURCE-REGISTER.md). Services without a
// fitting honest image render as the text card variant. The hero carousel
// and the service cards use DISTINCT photographs (owner-directed,
// 2026-10-23): recurring and STR cards carry their own scenes instead of
// reusing carousel slides.
const SERVICE_PHOTOS: Record<string, { image: ImageMetadata; alt: string } | undefined> = {
  '/recurring-cleaning/': {
    image: livingRoomMaintained,
    alt: 'A warm, well-kept living room with a fireplace, lamp and dining area.',
  },
  '/house-cleaning/': {
    image: livingRoomBright,
    alt: 'A bright, tidy living room with a sectional sofa, large windows and soft natural light.',
  },
  '/deep-cleaning/': {
    image: kitchenSinkDetail,
    alt: 'A detailed view of a white kitchen with polished cabinets and a clean sink.',
  },
  '/move-in-move-out-cleaning/': {
    image: emptyRoomMoveout,
    alt: 'A bright empty room with wood flooring, ready for move-in day.',
  },
  '/short-term-rental-cleaning/': {
    image: vacationBedroom,
    alt: 'An inviting vacation bedroom, freshly made and ready for guests.',
  },
  '/commercial-cleaning/': {
    image: officePlanted,
    alt: 'The clean interior of a modern office with plants.',
  },
};

const allFaqs = await getCollection('faqs');
const faqs = data.homeFaqIds.flatMap((id) => {
  const faq = allFaqs.find((entry) => entry.id === id);
  return faq ? [faq] : [];
});

const site = Astro.site ?? new URL('https://pending-website-url.invalid');
const schema = [breadcrumbNode(site, [{ name: 'Home', path: '/' }])];
---

<BaseLayout title={data.metaTitle} description={data.metaDescription} schema={schema}>
  <section class="hero">
    <div class="container hero__inner">
      <div>
        <h1>
          {data.hero.headline}{' '}
          {data.hero.highlight && (
            <span class="hero__sparkle-word hero__sparkle-word--line">
              <svg class="hero__sparkle-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 1.5 14 9.9l8.5 2.1-8.5 2.1L12 22.5l-2-8.4L1.5 12 10 9.9Z" />
              </svg>
              <span>{data.hero.highlight}</span>
              <svg class="hero__sparkle-icon hero__sparkle-icon--small" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 1.5 14 9.9l8.5 2.1-8.5 2.1L12 22.5l-2-8.4L1.5 12 10 9.9Z" />
              </svg>
            </span>
          )}
          {data.hero.accent && <span class="hero__accent">{data.hero.accent}</span>}
        </h1>
        <p class="lead">{data.hero.lead}</p>
        <div class="btn-row hero__actions">
          <a class="btn btn--primary btn--large" href="/estimate/" data-cta="home-hero-estimate">
            {data.hero.ctaLabel ?? 'Instant Estimate'}
          </a>
          <a class="btn btn--inverse btn--large" href="#services" data-cta="home-hero-services">Explore Services</a>
        </div>
      </div>
      <div class="hero__panel hero__panel--media">
        <HeroCarousel
          sizes="(min-width: 56rem) 34rem, 92vw"
          slides={[
            {
              src: livingRoomBright,
              alt: 'A bright, tidy living room with a sectional sofa, large windows and soft natural light.',
              widths: [480, 720, 1080],
            },
            {
              src: bathroomSpacious,
              alt: 'A spacious, bright bathroom with clean surfaces and soft natural light.',
              widths: [480, 720, 1080],
            },
            {
              src: kitchenWhiteClean,
              alt: 'A clean white kitchen with a clear counter and sink.',
              widths: [480, 720, 1080],
            },
            {
              src: bedroomMade,
              alt: 'A tidy bedroom in a model home with the bed neatly made.',
              widths: [480, 720, 1080],
            },
          ]}
        />
        <p class="media-caption">Project photos are added only with customer approval.</p>
      </div>
    </div>
  </section>

  <TrustChips />

  <section class="section difference-intro" aria-labelledby="hospitality-heading">
    <div class="container difference-intro__grid">
      <h2 id="hospitality-heading" class="difference-intro__heading">Southern Hospitality</h2>
      <div class="difference-intro__copy">
        <p>
          Here in Pensacola, treating people right is a way of life. Neighbors look out for
          neighbors, guests are welcomed like family, and care shows in the little things — a home
          made ready for company, a porch light left on, a helping hand that doesn&rsquo;t count the
          minutes.
        </p>
        <p>
          Sparkling Standard was built on that same spirit. We clean with genuine care for the
          people who live and work in the spaces we touch, and we take the time to do it properly:
          an eye for detail, a commitment to quality, and the willingness to go the extra mile for
          a neighbor.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="services">
    <div class="container">
      <div class="section-head section-head--center">
        <h2>{data.servicesIntro?.heading}</h2>
        {data.servicesIntro?.lead && <p class="lead services-intro__lead">{data.servicesIntro.lead}</p>}
      </div>
      <div class="service-list service-list--photo">
        {
          services.map((service) => {
            const photo = SERVICE_PHOTOS[service.data.path];
            return (
              <HomeServiceCard
                title={service.data.title}
                summary={service.data.summary}
                paragraphs={service.data.homepageParagraphs}
                href={service.data.path}
                icon={service.data.icon}
                featured={service.data.path === '/recurring-cleaning/'}
                {...(photo ? { image: photo.image, imageAlt: photo.alt } : {})}
              />
            );
          })
        }
      </div>
      <p class="media-caption service-list__caption">Representative interiors — project photos are added only with customer approval.</p>
    </div>
  </section>

  {
    data.estimateBand && (
      <section class="section section--alt" aria-labelledby="estimate-heading">
        <div class="container container--narrow">
          <div class="card card--feature estimate-card">
            <div class="estimate-card__centered">
              {data.estimateBand.eyebrow && <p class="eyebrow">{data.estimateBand.eyebrow}</p>}
              <h2 id="estimate-heading">{data.estimateBand.heading}</h2>
              <p class="lead">{data.estimateBand.text}</p>
              {data.estimateBand.body && <p class="estimate-card__body">{data.estimateBand.body}</p>}
              <div class="estimate-card__actions">
                <a class="btn btn--primary btn--large" href="/estimate/" data-cta="home-estimate">
                  {data.estimateBand.ctaLabel}
                </a>
              </div>
              <Checklist
                class="estimate-assurances estimate-assurances--inline"
                items={['No account required', 'No auto-booking', 'Private estimate']}
              />
            </div>
          </div>
        </div>
      </section>
    )
  }

  {
    data.founderBand && (
      <section class="section" aria-labelledby="founder-heading">
        <div class="container split">
          <div>
            <h2 id="founder-heading">{data.founderBand.heading}</h2>
            {data.founderBand.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            {data.founderBand.linkLabel && (
              <a class="btn btn--secondary" href="/about/" data-cta="home-founder">
                {data.founderBand.linkLabel}
              </a>
            )}
          </div>
          <div class="card founder-card founder-card--homepage">
            <div class="founder-card__media">
              <Image
                src={hayliPortrait}
                alt="Portrait of Hayli, founder and owner-operator of Sparkling Standard"
                widths={[420, 640, 900]}
                sizes="(min-width: 56rem) 30rem, 92vw"
                loading="lazy"
                decoding="async"
              />
            </div>
            <p class="founder-card__name">Hayli</p>
            <p class="founder-card__role">Founder / Owner-Operator</p>
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--alt" aria-labelledby="service-area-heading">
    <div class="container container--narrow">
      <div class="section-head section-head--center">
        {data.areaBand?.eyebrow && <p class="eyebrow">{data.areaBand?.eyebrow}</p>}
        <h2 id="service-area-heading">{data.areaBand?.heading}</h2>
        <p class="lead">{data.areaBand?.text}</p>
      </div>
      <div class="area-band__actions">
        <a class="btn btn--secondary" href="/service-area/" data-cta="home-service-area">
          See Our Service Area <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </div>
  </section>

  <Reviews />

  {
    faqs.length > 0 && (
      <section class="section" aria-labelledby="home-faq-heading">
        <div class="container container--narrow">
          <div class="section-head">
            <p class="eyebrow">Questions</p>
            <h2 id="home-faq-heading">FAQs</h2>
          </div>
          <div class="faq-list">
            {faqs.map((faq) => (
              <FaqItem question={faq.data.question} answer={faq.data.answer} />
            ))}
          </div>
          <p class="mt-4">
            <a class="tap-link" href="/faq/">Read all FAQs →</a>
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>
