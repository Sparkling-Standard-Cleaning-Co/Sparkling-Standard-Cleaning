---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CareersForm from '../components/CareersForm.astro';
import { business } from '../config/business.ts';
import Icon from '../components/Icon.astro';
import {
  CAREER_BENEFITS,
  CAREER_DEFAULT_PAY,
  CAREER_OPPORTUNITIES,
} from '../lib/careers.ts';

const title = 'Cleaning Careers | Sparkling Standard';
const description =
  'Build your future with Sparkling Standard. Apply for residential, commercial, vacation rental or lead cleaning work in Pensacola.';
const money = (cents: number) =>
  new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(
    cents / 100,
  );
---

<BaseLayout title={title} description={description}>
  <section class="section careers-hero">
    <div class="container">
      <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Careers', path: '/careers/' }]} />
      <div class="careers-hero__grid mt-4">
        <div>
          <p class="eyebrow">Careers</p>
          <h1>Build Your Future With Sparkling Standard</h1>
          <p class="lead">
            Take pride in your work, develop valuable skills and become part of a growing cleaning
            company committed to professionalism, consistency and exceptional service.
          </p>
          <div class="btn-row mt-4">
            <a class="btn btn--primary btn--large" href="#application">Apply to Join Our Team</a>
            <a class="btn btn--ghost" href="#opportunities">Explore opportunities</a>
          </div>
        </div>
        <div class="careers-hero__card">
          <p class="eyebrow mb-0">Now recruiting</p>
          <h2>Pensacola</h2>
          <p>
            Pensacola is our active recruiting market. Tampa Bay applications are accepted as
            expressions of future interest while that branch remains prelaunch.
          </p>
          <p class="careers-hero__note">Role availability is confirmed during the hiring process.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="why-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Why work with us</p>
        <h2 id="why-title">A professional place to grow.</h2>
      </div>
      <div class="career-benefits">
        {CAREER_BENEFITS.map(([title, copy]) => (
          <div class="career-benefit">
            <span class="career-benefit__icon" aria-hidden="true"><Icon name="check" size={18} /></span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pay-title">
    <div class="container">
      <div class="career-pay">
        <div>
          <p class="eyebrow">Compensation</p>
          <h2 id="pay-title">Approved role-based rates.</h2>
          <p>
            Rates depend on the approved role and the assignment. Lead and solo assignments carry
            additional responsibility and their own approved rates.
          </p>
        </div>
        <div class="career-pay__cards">
          <div class="career-pay__card">
            <p class="career-pay__label">Regular cleaner</p>
            <p class="career-pay__rate" data-career-pay="regular">{money(CAREER_DEFAULT_PAY.regular)}<span>/hour</span></p>
          </div>
          <div class="career-pay__card">
            <p class="career-pay__label">Lead cleaner</p>
            <p class="career-pay__rate" data-career-pay="lead">{money(CAREER_DEFAULT_PAY.lead)}<span>/hour</span></p>
          </div>
          <div class="career-pay__card">
            <p class="career-pay__label">Solo-cleaner assignment</p>
            <p class="career-pay__rate" data-career-pay="solo">{money(CAREER_DEFAULT_PAY.solo)}<span>/hour</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt" id="opportunities" aria-labelledby="opportunities-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Opportunities</p>
        <h2 id="opportunities-title">Find the work that fits you.</h2>
        <p class="lead">
          We accept applications across these categories. Not every category is open at every
          moment; the current status is shown below.
        </p>
      </div>
      <div class="career-opportunities">
        {CAREER_OPPORTUNITIES.map((opportunity) => (
          <div class="career-opportunity" data-opportunity-code={opportunity.code}>
            <div>
              <h3>{opportunity.title}</h3>
              <p>{opportunity.description}</p>
            </div>
            <span class="career-opportunity__status" data-opportunity-status>Checking availability</span>
          </div>
        ))}
      </div>
      <p class="small text-muted mt-4">
        Tampa Bay is preparing for a future launch. Applications for Tampa Bay are expressions of
        interest only and do not indicate that the branch is currently operational.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="expectations-title">
    <div class="container careers-expectations">
      <div>
        <p class="eyebrow">What we look for</p>
        <h2 id="expectations-title">Careful work. Reliable people.</h2>
        <p>
          We hire people who respect customers, follow procedures and take pride in the details. These
          are the expectations we apply on every assignment.
        </p>
      </div>
      <ul class="career-checklist">
        <li>Reliability and punctuality</li>
        <li>Attention to detail</li>
        <li>Professional conduct</li>
        <li>Respect for customers and their property</li>
        <li>Ability to follow established procedures</li>
        <li>Willingness to learn</li>
        <li>Effective communication</li>
        <li>Pride in delivering high-quality work</li>
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="process-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Our hiring process</p>
        <h2 id="process-title">Four clear steps.</h2>
      </div>
      <ol class="career-process">
        <li>
          <span class="career-process__number">1</span>
          <h3>Submit your application</h3>
          <p>Tell us about yourself, your experience and your availability.</p>
        </li>
        <li>
          <span class="career-process__number">2</span>
          <h3>Meet our team</h3>
          <p>Qualified applicants may be contacted for an interview.</p>
        </li>
        <li>
          <span class="career-process__number">3</span>
          <h3>Complete onboarding and training</h3>
          <p>Selected candidates complete applicable employment paperwork and company training.</p>
        </li>
        <li>
          <span class="career-process__number">4</span>
          <h3>Begin working</h3>
          <p>Approved employees receive assignments through our scheduling and employee systems.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="small text-muted">
        Questions about an application or need an accommodation? Email
        <a href={`mailto:${business.hiringEmail}`}>{business.hiringEmail}</a>.
      </p>
    </div>
  </section>

  <CareersForm />
</BaseLayout>

<script>
  // Public recruiting status is managed in Admin -> Employees & Payroll ->
  // Applicants. The page defaults are the approved rates; the API refreshes
  // them so management changes never require a source edit.
  const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 });
  const labels: Record<string, string> = {
    open: 'Applications accepted',
    future: 'Future interest',
    closed: 'Not currently available',
  };
  void fetch('/api/careers-options', { headers: { Accept: 'application/json' } })
    .then((response) => (response.ok ? response.json() : null))
    .then((data: { pay?: Record<string, number>; opportunities?: Array<Record<string, unknown>> } | null) => {
      if (!data) return;
      if (data.pay) {
        for (const [key, cents] of Object.entries(data.pay)) {
          const target = document.querySelector<HTMLElement>(`[data-career-pay="${key}"]`);
          if (target) target.innerHTML = `${money.format(Number(cents) / 100)}<span>/hour</span>`;
        }
      }
      for (const opportunity of data.opportunities ?? []) {
        if (String(opportunity.branch_id ?? '') !== 'branch_pensacola') continue;
        const card = document.querySelector<HTMLElement>(`[data-opportunity-code="${String(opportunity.code)}"]`);
        const status = card?.querySelector<HTMLElement>('[data-opportunity-status]');
        if (!status) continue;
        const value = String(opportunity.status ?? 'future');
        status.textContent = labels[value] ?? 'Future interest';
        status.dataset.state = value;
      }
    })
    .catch(() => undefined);
</script>

