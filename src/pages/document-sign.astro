---
import '../styles/global.css';
import '../styles/employee.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#8a4a52" />
    <title>Sign Documents | Sparkling Standard</title>
  </head>
  <body class="employee-body">
    <main class="employee-shell">
      <header class="employee-brand">
        <img src="/brand/icon-192.png" alt="" width="40" height="40" />
        <div>
          <p class="employee-brand__name">Sparkling Standard</p>
          <p class="employee-brand__sub">Secure documents</p>
        </div>
      </header>

      <section class="employee-card" data-document-sign>
        <p class="employee-muted" data-document-status>Loading your secure document set…</p>
        <div data-document-content hidden></div>
      </section>
    </main>
    <script>
      import '../scripts/document-sign';
    </script>
  </body>
</html>
