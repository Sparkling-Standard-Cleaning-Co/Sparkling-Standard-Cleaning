---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { business, contactPhone, isPending } from '../config/business';
import { pricing } from '../config/pricing';
import { breadcrumbNode } from '../lib/schema';

// These terms describe the currently implemented model: requests (not instant
// bookings), estimate ranges confirmed personally, optional exact-quote Pay Now or payment after service, and
// the make-it-right policy. Cancellation percentages stay OUT of this page
// until the owner approves final values (pricing.cancellation.ownerApproved).
// Owner legal review is a launch blocker — see docs/launch/OWNER-INPUT-REQUIRED.md.

const site = Astro.site ?? new URL('https://pending-website-url.invalid');
const schema = [
  breadcrumbNode(site, [
    { name: 'Home', path: '/' },
    { name: 'Terms', path: '/terms/' },
  ]),
];

const hasEmail = !isPending(business.email);
const phone = contactPhone();
---

<BaseLayout
  title="Terms of Service"
  description="The terms for estimates, booking requests, scheduling, payment, cancellations and the make-it-right policy."
  schema={schema}
>
  <section class="section section--tight">
    <div class="container container--narrow">
      <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Terms', path: '/terms/' }]} />
      <h1 class="mt-4">Terms of service</h1>
      <p class="lead">
        The rules of working together, written to be read — not to be survived.
      </p>
      <p class="small text-muted">Last updated: October 21, 2026.</p>

      <div class="prose stack mt-6">
        <section>
          <h2>Estimates and requests</h2>
          <ul>
            <li>
              The online estimate is an <strong>estimated range</strong>, not a guaranteed price.
              Final scope, condition, access and unique circumstances can affect the final
              confirmed price.
            </li>
            <li>
              Submitting an estimate or request is a <strong>request, not a confirmed booking</strong>.
              A booking exists only after Sparkling Standard confirms the scope, date and final price with
              you.
            </li>
            <li>
              If the property's condition differs materially from what was described, we may discuss
              a revised price, adjust the scope to the agreed amount, or reschedule with a custom
              quote — always discussed with you before work continues.
            </li>
          </ul>
        </section>

        <section>
          <h2>Scheduling and arrival windows</h2>
          <ul>
            <li>
              The first appointment of the day can be scheduled for an exact arrival time. Later
              appointments use an arrival window.
            </li>
            <li>
              We clean {business.hours.days.toLowerCase()}, between {business.hours.residentialWindow}.
              Commercial work is scheduled within the same published hours, with timing agreed
              during the walkthrough.
            </li>
            <li>A home takes as long as it honestly takes; we do not rush jobs to protect a clock.</li>
          </ul>
        </section>

        <section>
          <h2>Recurring residential cleaning</h2>
          <ul>
            <li>
              A new recurring residential maintenance arrangement requires a Deep Cleaning before
              maintenance service begins. There are no exceptions.
            </li>
            <li>
              The initial Deep Cleaning is scoped and priced separately; recurring visits begin after
              it is complete.
            </li>
          </ul>
        </section>

        <section>
          <h2>Payment</h2>
          <ul>
            <li>
              You may pay an exact estimate securely through Stripe when Pay Now is offered, or
              submit a reservation request without paying upfront. Pay Now does not by itself confirm
              the date or final scope. Commercial cleaning is invoiced monthly with Net 15 terms.
            </li>
            <li>
              No standard deposit or late fee applies initially. If the personally confirmed scope
              differs from the estimate, any adjustment is discussed and agreed before work begins.
              Large projects may be considered separately with written terms agreed before work begins.
            </li>
            <li>
              Accepted methods include {business.payments.accepted.join(', ')}, plus{' '}
              {business.payments.alternate.join(', ')}.
            </li>
          </ul>
        </section>

        <section>
          <h2>Cancellations, rescheduling and access</h2>
          <ul>
            <li>
              We ask for at least {pricing.cancellation.noticeHours.value} hours' notice so the time
              can be offered to someone else.
            </li>
            <li>
              No standard cancellation fee applies initially. Repeated cancellations or access
              problems may lead to declining future bookings.
            </li>
            <li>
              If access is unavailable, we will contact you to work out the next available option.
              We do not retain customer physical keys; access uses an authorized temporary method or
              a customer-controlled lockbox.
            </li>
          </ul>
        </section>

        <section>
          <h2>Our make-it-right policy</h2>
          <p>{pricing.satisfaction.statement}</p>
          <p>
            This applies to items within the agreed cleaning scope. It does not extend to unrelated
            work, restoration, repair, or conditions outside the scope, and it is not an
            unconditional refund promise.
          </p>
        </section>

        <section>
          <h2>What we do not take on</h2>
          <p>
            Post-construction cleaning is not offered. Specialist and hazardous situations —
            including biohazards, sharps, crime scenes, severe hoarding, mold remediation, serious
            infestations, fire restoration, hazardous chemical remediation and unsafe height work —
            require certified specialist providers and are outside our scope. If a job requires a
            specialist, we will say so directly.
          </p>
        </section>

        <section>
          <h2>Pets</h2>
          <p>
            Pets are welcome. If an animal creates a safety risk or prevents the work from being
            done properly, we will ask that it be secured during the visit.
          </p>
        </section>

        <section>
          <h2>Photos and marketing</h2>
          <p>
            Completion photos may be taken for quality and documentation. We obtain written consent
            before publishing identifiable photos or video of your property. Approved marketing
            material is stored securely and retained only as long as needed for the permitted use.
            Photos are never used in a way that exposes identifying or private information.
          </p>
        </section>

        <section>
          <h2>Liability</h2>
          <p>
            We work carefully and treat every home with respect. If something within the agreed
            scope is missed or damaged through our work, contact us promptly and we will work
            quickly to address the affected work within that scope. This is a plain-language
            service commitment, not a separate guarantee, insurance policy, or waiver. Where a
            signed service agreement applies, that agreement controls.
          </p>
        </section>

        <section>
          <h2>Changes</h2>
          <p>
            We may update these terms. The version in effect for your booking is the one confirmed
            with you before your cleaning.
          </p>
        </section>

        <section>
          <h2>Contact</h2>
          <p>
            {
              phone || hasEmail ? (
                <>
                  Questions about these terms?{' '}
                  {phone && <>Call or text <a href={phone.href}>{phone.display}</a>. </>}
                  {hasEmail && <>Email <a href={`mailto:${business.email}`}>{business.email}</a>.</>}
                </>
              ) : (
                <>Questions about these terms? Reach us through the <a href="/contact/">contact page</a>.</>
              )
            }
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
