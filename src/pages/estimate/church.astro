---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FacilityEstimateForm from '../../components/FacilityEstimateForm.astro';
import { breadcrumbNode } from '../../lib/schema';
import { replacePricingTokens } from '../../lib/content/pricing-text';

const entry = await getEntry('site', 'estimate-church');
if (!entry) throw new Error('Missing content entry: src/content/site/estimate-church.md');
const data = replacePricingTokens(entry.data);

const site = Astro.site ?? new URL('https://pending-website-url.invalid');
const schema = [
  breadcrumbNode(site, [
    { name: 'Home', path: '/' },
    { name: 'Instant Estimate', path: '/estimate/' },
    { name: 'Church Cleaning', path: '/estimate/church/' },
  ]),
];
---

<BaseLayout title={data.metaTitle} description={data.metaDescription} schema={schema}>
  <section class="section section--tight estimate-intro">
    <div class="container">
      <Breadcrumbs
        trail={[
          { name: 'Home', path: '/' },
          { name: 'Instant Estimate', path: '/estimate/' },
          { name: 'Church Cleaning', path: '/estimate/church/' },
        ]}
      />
      <div class="section-head mt-4">
        <h1>
          {data.hero.headline}
          {data.hero.accent && <span class="hero__accent">{data.hero.accent}</span>}
        </h1>
        <p class="lead">{data.hero.lead}</p>
      </div>
    </div>
  </section>

  <div class="container container--narrow" style="margin-bottom: var(--space-9)">
    <p><a href="/estimate/">Estimating something else? See all estimate options →</a></p>
    <FacilityEstimateForm engine="church" />
  </div>
</BaseLayout>
