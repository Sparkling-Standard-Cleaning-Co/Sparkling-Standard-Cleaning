---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
---

<BaseLayout
  title="Resume Secure Payment"
  description="Resume secure payment for your Sparkling Standard cleaning request after completing the required agreement."
  noindex
  analytics={false}
>
  <section class="section">
    <div class="container container--narrow text-center">
      <span class="card__icon" style="margin-inline: auto"><Icon name="shield" /></span>
      <h1 class="mt-4">Returning to secure payment.</h1>
      <p class="lead" style="margin-inline: auto" data-resume-state>
        Your agreement is signed. We are reopening the secure payment step.
      </p>
      <p class="small text-muted" data-resume-reference hidden></p>

      <div class="card mt-6" style="text-align:left" data-resume-actions hidden>
        <h2 class="card__title">Price confirmation</h2>
        <p class="step__text" data-resume-message></p>
        <button class="btn btn--primary btn--full mt-4" type="button" data-resume-accept>
          Accept the verified amount and continue
        </button>
      </div>

      <p class="mt-6 small text-muted">
        No card details are handled by this website. Payment is completed on Stripe's secure checkout.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import '../../scripts/payment-resume';
</script>
