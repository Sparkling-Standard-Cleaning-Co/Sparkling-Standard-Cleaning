---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import Scripture from '../components/Scripture.astro';
import { business, isPending } from '../config/business';
import { breadcrumbNode } from '../lib/schema';
import hayliPortrait from '../assets/images/hayli-founder.webp';

const entry = await getEntry('site', 'about');
if (!entry) throw new Error('Missing content entry: src/content/site/about.md');
const { data } = entry;

const founderName = isPending(business.founder.firstName) ? 'The founder' : business.founder.firstName;

const site = Astro.site ?? new URL('https://pending-website-url.invalid');
const schema = [
  breadcrumbNode(site, [
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about/' },
  ]),
];
---

<BaseLayout title={data.metaTitle} description={data.metaDescription} schema={schema}>
  <section class="hero">
    <div class="container">
      <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'About', path: '/about/' }]} />
      <div class="section-head mt-5" style="max-width: 52rem">
        <h1>
          {data.hero.headline}
          {data.hero.accent && <span class="hero__accent">{data.hero.accent}</span>}
        </h1>
        <p class="lead">{data.hero.lead}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="stack">
        {
          data.sections.slice(0, 2).map((section) => (
            <div id={section.id}>
              {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
              <h2>{section.heading}</h2>
              {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
          ))
        }
      </div>
      <div class="card founder-card">
        <div class="founder-card__media">
          <Image
            src={hayliPortrait}
            alt={`Portrait of ${founderName}, founder and owner-operator of ${business.displayName}`}
            widths={[420, 640, 900]}
            sizes="(min-width: 56rem) 30rem, 92vw"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="eyebrow">Meet the founder</p>
        <p class="founder-card__name">{founderName}</p>
        <p class="founder-card__role">{business.founder.role}</p>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container--narrow stack">
      {
        data.sections.slice(2).map((section) => (
          <div id={section.id}>
            {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        ))
      }
      <blockquote class="card card--feature">
        <p style="font-family: var(--font-display); font-size: var(--text-lg); margin-bottom: var(--space-3)">
          “{business.founder.coreStory}”
        </p>
        <p class="small text-muted mb-0">— {founderName}, {business.founder.role}</p>
      </blockquote>
    </div>
  </section>

  <section class="section section--tight" aria-label="A reflection on faithful work">
    <div class="container">
      <Scripture verse="workmanship" variant="panel" />
    </div>
  </section>

  <div class="container section section--tight">
    <CtaBand
      title={data.ctaBand?.heading ?? 'Want to see the standard for yourself?'}
      text={data.ctaBand?.text}
      primaryLabel="Get Instant Estimate"
      primaryHref="/estimate/"
      secondaryLabel="Contact Us"
      secondaryHref="/contact/"
    />
  </div>
</BaseLayout>
