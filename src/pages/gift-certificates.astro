---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import TermsAcceptance from '../components/TermsAcceptance.astro';
import { giftCertificateConfig } from '../config/gift-certificates';
import { business, contactPhone, isPending } from '../config/business';
import { brandWords } from '../config/brand';
import { breadcrumbNode } from '../lib/schema';

const enabled = giftCertificateConfig.enabled;
const phone = contactPhone();
const hasEmail = !isPending(business.email);
const site = Astro.site ?? new URL('https://sparkling-standard.com');
const schema = [
  breadcrumbNode(site, [
    { name: 'Home', path: '/' },
    { name: 'Gift Certificates', path: '/gift-certificates/' },
  ]),
];
---

<BaseLayout
  title="Gift Certificates | Sparkling Standard"
  description="Give a Sparkling Standard gift certificate: a monetary value toward professional cleaning services, delivered as a printable certificate or email gift."
  schema={schema}
>
  <section class="section section--tight gift-hero">
    <div class="container">
      <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Gift Certificates', path: '/gift-certificates/' }]} />
      <div class="section-head gift-hero__head mt-4">
        <p class="eyebrow">Gift certificates</p>
        <h1>Give the gift of a <span class="hero__accent">beautifully clean space.</span></h1>
        <p class="lead">
          Give the gift of a beautifully clean space. Your recipient can apply the certificate value
          toward their preferred Sparkling Standard cleaning service.
        </p>
        <div class="btn-row mt-4">
          <a class="btn btn--primary btn--large" href="#request">
            {enabled ? 'Buy a Gift Certificate' : 'Request a Gift Certificate'}
          </a>
          <a class="btn btn--ghost" href="#coverage">What it covers</a>
        </div>
        {
          !enabled && (
            <p class="small text-muted mt-3" data-gift-status="request">
              Online purchase is not open yet. Request a certificate and we will confirm the amount
              and details with you, then send a secure payment link. <strong>No payment is taken on
              this page.</strong>
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="section section--alt gift-coverage" id="coverage">
    <div class="container">
      <div class="gift-coverage__grid">
        <div class="gift-coverage__copy">
          <p class="eyebrow">What the certificate covers</p>
          <h2>A thoughtful gift, applied their way.</h2>
          <p>{giftCertificateConfig.coverageNote}</p>
        </div>
        <div class="gift-coverage__assurances">
          <p><Icon name="check" size={16} /> No expiration</p>
          <p><Icon name="check" size={16} /> No post-sale service fee</p>
          <p><Icon name="check" size={16} /> Printable or email delivery</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="request">
    <div class="container">
      <div class="section-head gift-purchase__head">
        <p class="eyebrow">{enabled ? 'Purchase' : 'Request'}</p>
        <h2>{enabled ? 'Create a gift certificate' : 'Request a gift certificate'}</h2>
      </div>

      <div class="gift-purchase-grid">
        <div class="gift-purchase__primary">
          <ol class="gift-steps" aria-label="How gifting works">
            <li class="gift-step">
              <span class="gift-step__number">1</span>
              <h3 class="gift-step__title">Choose your amount</h3>
              <p class="gift-step__text">Select a gift value and personalize your certificate.</p>
            </li>
            <li class="gift-step">
              <span class="gift-step__number">2</span>
              <h3 class="gift-step__title">Send your gift</h3>
              <p class="gift-step__text">Receive a printable or digital gift certificate after payment.</p>
            </li>
            <li class="gift-step">
              <span class="gift-step__number">3</span>
              <h3 class="gift-step__title">Enjoy a sparkling clean</h3>
              <p class="gift-step__text">
                The recipient applies it toward their preferred cleaning service online or with our team.
              </p>
            </li>
          </ol>

          <form
            class="gift-form"
            data-lead-form={!enabled ? true : undefined}
            data-gift-purchase={enabled ? true : undefined}
            data-variant="gift"
            action="#"
            method="post"
            novalidate
          >
            {enabled && (
              <fieldset class="gift-amounts">
                <legend>Gift amount</legend>
                <div class="gift-amount-options">
                  {giftCertificateConfig.denominations.map((amount, index) => (
                    <label class="gift-amount-option">
                      <input
                        type="radio"
                        name="denominationUsd"
                        value={String(amount)}
                        checked={index === 1}
                        data-gift-amount
                        required
                      />
                      <span>${amount}</span>
                    </label>
                  ))}
                  {giftCertificateConfig.allowCustomAmount && (
                    <label class="gift-amount-option gift-amount-option--custom">
                      <input type="radio" name="denominationUsd" value="custom" data-gift-amount />
                      <span>Other</span>
                    </label>
                  )}
                </div>
                {giftCertificateConfig.allowCustomAmount && (
                  <div class="field gift-custom-amount" data-gift-custom-field hidden>
                    <label for="gift-custom-value">Custom amount (USD)</label>
                    <input
                      class="input"
                      id="gift-custom-value"
                      name="gift_custom_value"
                      type="number"
                      inputmode="numeric"
                      min={giftCertificateConfig.customAmountMinUsd}
                      max={giftCertificateConfig.customAmountMaxUsd}
                      step="5"
                      placeholder={`$${giftCertificateConfig.customAmountMinUsd}-$${giftCertificateConfig.customAmountMaxUsd}`}
                      data-gift-custom-value
                    />
                  </div>
                )}
              </fieldset>
            )}

            <div class="gift-form__section">
              <h3 class="gift-form__heading">Your details</h3>
              <div class="field-row field-row--2">
                <div class="field">
                  <label for="gift-purchaser-name">Your name</label>
                  <input class="input" id="gift-purchaser-name" name="name" type="text" autocomplete="name" required data-gift-purchaser-name />
                </div>
                <div class="field">
                  <label for="gift-purchaser-email">Your email</label>
                  <input class="input" id="gift-purchaser-email" name="email" type="email" autocomplete="email" required data-gift-purchaser-email />
                </div>
              </div>
            </div>

            <div class="gift-form__section">
              <h3 class="gift-form__heading">Recipient</h3>
              <div class="field-row field-row--2 gift-field-row">
                <div class="field">
                  <label for="gift-recipient-name">Recipient's name</label>
                  <input class="input" id="gift-recipient-name" name="recipient_name" type="text" required data-gift-recipient-name />
                </div>
                <div class="field">
                  <label for="gift-recipient-email">Recipient's email <span class="text-muted">(optional)</span></label>
                  <input class="input" id="gift-recipient-email" name="recipient_email" type="email" autocomplete="off" data-gift-recipient-email />
                  <span class="hint" data-gift-recipient-email-note>Required only for email delivery.</span>
                </div>
              </div>
            </div>

            <div class="gift-form__section">
              <h3 class="gift-form__heading">Delivery</h3>
              <div class="field-row field-row--2 gift-field-row">
                <div class="field">
                  <label for="gift-delivery-method">Delivery method</label>
                  <select class="select" id="gift-delivery-method" name="delivery_method" data-gift-delivery-method>
                    <option value="print">Printable certificate</option>
                    <option value="recipient_email">Email the certificate to the recipient</option>
                  </select>
                </div>
                <div class="field">
                  <label for="gift-valid-from">Valid from <span class="text-muted">(optional)</span></label>
                  <input class="input" id="gift-valid-from" name="valid_from_date" type="date" data-gift-valid-from />
                  <span class="hint">Leave blank for today.</span>
                </div>
              </div>
              <p class="hint gift-delivery-note" data-gift-delivery-note>
                The purchaser always receives a confirmation and certificate copy.
              </p>
            </div>

            <div class="field">
              <label for="gift-message">Personal message <span class="text-muted">(optional)</span></label>
              <textarea
                class="textarea"
                id="gift-message"
                name="gift_message"
                rows="3"
                maxlength={giftCertificateConfig.maxMessageLength}
                placeholder="A short note to include on the certificate."
                data-gift-message
              ></textarea>
            </div>

            <details class="gift-promo">
              <summary>Have a promo code?</summary>
              <div class="gift-promo__body">
                <div class="field-row field-row--2">
                  <input class="input" id="gift-promo-code" name="promo_code" type="text" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="40" placeholder="Enter promo code" data-gift-promo-code />
                  <button class="btn btn--secondary" type="button" data-gift-promo-apply>Apply</button>
                </div>
                <p class="small text-muted" data-gift-promo-status role="status" aria-live="polite"></p>
                <p class="small" data-gift-promo-summary hidden></p>
              </div>
            </details>

            <TermsAcceptance id="gift-terms" />
            <p class="small text-muted">
              Gift certificate terms are part of our
              <a href="/terms/#gift-certificates">Terms and Conditions</a>. Purchased certificates do
              not expire and carry no post-sale service fee.
            </p>
            <div class="honeypot" aria-hidden="true">
              <input
                id="gift-extra-ref"
                name="extra_ref"
                type="text"
                tabindex="-1"
                autocomplete="off"
                data-lpignore="true"
                data-1p-ignore
                data-bwignore
                data-protonpass-ignore
              />
            </div>
            <p class="form-status" data-form-status role="status" aria-live="polite"></p>
            <button class="btn btn--primary btn--large btn--block gift-checkout-button" type="submit">
              <Icon name="send" size={18} /> {enabled ? 'Continue to Secure Checkout' : 'Send Gift Certificate Request'}
            </button>
          </form>
        </div>

        <aside class="gift-summary" aria-label="Gift certificate preview and purchase summary">
          <div class="gift-preview" data-gift-preview>
            <p class="gift-preview__eyebrow">Preview only</p>
            <p class="gift-preview__brand-script">Sparkling</p>
            <p class="gift-preview__brand-caps">Standard</p>
            <p class="gift-preview__descriptor">{brandWords.tagline}</p>
            <p class="gift-preview__title">Gift Certificate</p>
            <p class="gift-preview__value" data-gift-preview-value>$100</p>
            <p class="gift-preview__label">Toward cleaning services</p>
            <p class="gift-preview__recipient">For: <strong data-gift-preview-recipient>Someone Special</strong></p>
            <p class="gift-preview__message" data-gift-preview-message hidden></p>
            <p class="gift-preview__note">
              A personalized certificate is issued after payment verification. No redemption code is
              shown before it is issued.
            </p>
          </div>
          <div class="gift-summary__card">
            <h3>Purchase summary</h3>
            <dl class="gift-summary__rows">
              <div><dt>Gift value</dt><dd data-gift-summary-value>$100.00</dd></div>
              <div data-gift-summary-discount-row hidden><dt>Promotion</dt><dd data-gift-summary-discount>-$0.00</dd></div>
              <div><dt>Delivery</dt><dd data-gift-summary-delivery>Printable</dd></div>
              <div class="gift-summary__total"><dt>Total due</dt><dd data-gift-summary-total>$100.00</dd></div>
            </dl>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="section section--alt gift-terms-section">
    <div class="container container--narrow">
      <div class="section-head">
        <p class="eyebrow">Good to know</p>
        <h2>Certificate terms and questions</h2>
      </div>
      <div class="gift-faq-grid">
        <div class="card card--muted">
          <h3 class="card__title">Certificate terms</h3>
          <p class="card__text">
            Purchased certificates do not expire and carry no post-sale service, dormancy,
            maintenance or cash-out fee. The full
            <a href="/terms/#gift-certificates">gift certificate terms</a> explain redemption and
            balances. Nothing on this page limits a recipient's statutory rights.
          </p>
        </div>
        <div class="card">
          <h3 class="card__title">Questions?</h3>
          <p class="card__text">
            {phone ? <>Call or text <a href={phone.href}>{phone.display}</a>{hasEmail ? ' or ' : '.'}</> : null}
            {hasEmail ? <> email <a href={`mailto:${business.email}`}>{business.email}</a>.</> : null}
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import('../scripts/gift-delivery-choice');
  if (document.querySelector('[data-gift-purchase]')) {
    import('../scripts/gift-checkout');
  } else {
    import('../scripts/lead-forms');
  }
</script>
