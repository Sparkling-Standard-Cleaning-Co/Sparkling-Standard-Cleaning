# ─────────────────────────────────────────────────────────────────────────────
# Environment template — copy to `.env` for local development.
# NOTHING here is required to run or build the site. Every value that affects
# public claims or live integrations is validated before production deploys
# (see scripts/validate-production-env.mjs and docs/launch/OWNER-INPUT-REQUIRED.md).
#
# .env is git-ignored. Never commit real secrets (server-side API keys belong
# only in .env and in the Cloudflare dashboard, never in source).
# ─────────────────────────────────────────────────────────────────────────────

# ── Site identity ────────────────────────────────────────────────────────────
# Production canonical origin (no trailing slash). The confirmed production
# domain is the built-in default; set this only to override it.
PUBLIC_SITE_URL=

# Preview deployments: set to "true" to force noindex/nofollow and Disallow: /.
# NEVER set this on the production deployment.
PUBLIC_PREVIEW_MODE=

# ── Business facts (owner-confirmed facts are the source defaults; set here to override) ──
# Confirmed (October 2026): name, domain, phone, email and founder are in
# src/config/business.ts. Legal name stays PENDING until the owner verifies the
# precise registered spelling/suffix. Production validation rejects a deploy
# while required facts are missing.
PUBLIC_BUSINESS_NAME=
PUBLIC_BUSINESS_LEGAL_NAME=
PUBLIC_BUSINESS_PHONE=
PUBLIC_BUSINESS_EMAIL=

# ── Forms ────────────────────────────────────────────────────────────────────
# Web3Forms public access key (client-safe by design). Empty string renders the
# honest "contact us directly" fallback; it never fakes a successful submit.
PUBLIC_WEB3FORMS_ACCESS_KEY=
# Server-side key used by functions/api/lead.ts when the site is deployed with
# the Cloudflare functions directory. Never expose this in client code.
WEB3FORMS_ACCESS_KEY=

# ── Customer confirmation email (Resend, server-side only; optional) ────────
# Sends the branded "We received your Sparkling Standard request" email after
# the owner notification is delivered. Empty = the customer email is skipped;
# the lead and the on-page thank-you summary are unaffected.
# The sending domain must be verified in Resend (DNS records) before it works.
RESEND_API_KEY=
# Optional overrides (Cloudflare dashboard "Text" variables). Defaults:
#   RESEND_FROM_EMAIL = Sparkling Standard Cleaning Co. <notifications@sparkling-standard.com>
#   RESEND_REPLY_TO   = owner@sparkling-standard.com
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# ── Spam protection (Cloudflare Turnstile, optional but recommended) ────────
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── IndexNow (optional, post-launch indexing accelerator) ───────────────────
# Host the key file at https://<domain>/<key>.txt before using scripts/indexnow.mjs
INDEXNOW_KEY=

# ── Analytics (all public client identifiers; empty = disabled) ─────────────
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_GTM_CONTAINER_ID=

# ── Travel / fuel estimator (server-side only; used by functions/api/travel.ts
#    and the reservation verification in functions/api/lead.ts)
# Operating origin — REQUIRED before the production estimator can compute
# precise distances. Format: "lat,lng" (e.g. "30.4213,-87.2169"). Never exposed
# to the browser, maps or responses.
TRAVEL_ORIGIN=
# Routing provider: mapmap | google | mapbox | (unset = mapmap when a key is
# present, else the offline ZIP-centroid fallback). MapMap handles the
# Pensacola territory (verified 2026-10-01: live routes for Cantonment, Pace
# and Atmore); address suggestions need no retrieve endpoint.
ROUTES_PROVIDER=
# Provider key. The same key also powers address autocomplete through
# functions/api/geocode.ts when ROUTES_PROVIDER=mapmap. Server-side only.
ROUTES_API_KEY=
# Optional MapMap gateway override (defaults to https://api.mapmap.ai).
MAPMAP_BASE=
# The browser map uses MapLibre GL with OpenFreeMap tiles — no key, no cost.
# U.S. Energy Information Administration API key for weekly Gulf Coast gasoline
# prices. Unset = configured reference price is used (estimator still works).
EIA_API_KEY=
# Vehicle economics for the travel adjustment.
VEHICLE_MPG=24
# One-way miles included in the base price before a travel adjustment applies.
INCLUDED_ONE_WAY_MILES=15
# Maximum one-way distance (miles) that receives an instant estimate.
# Beyond this the estimate asks for manual confirmation.
MAX_INSTANT_ESTIMATE_DISTANCE=45
# Fallback reference gasoline price (USD/gal) used when the EIA feed is
# unavailable. Reviewed monthly; see docs/operations/ESTIMATOR-CALIBRATION.md.
REFERENCE_GAS_PRICE=3.10
# Travel data cache duration in seconds (site functions only).
TRAVEL_CACHE_SECONDS=21600
