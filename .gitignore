# build output
dist/
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables (keep only the example committed)
.env
.env.*
!.env.example

# deployment secrets (local only — never commit)
deploy/secrets.env
deploy/secrets*.json
.dev.vars
.dev.vars.*

# local preview/server runtime files
preview-out.log
preview-err.log
preview.pid

# OS files
.DS_Store
Thumbs.db

# local scratch (never commit)
/tmp/

# owner-generated gift certificates / confirmations (contain customer data)
gift-out/

# canvassing intelligence data (address-level operational data; local only)
canvass-out/

# python bytecode (route/print scripts)
__pycache__/
*.pyc