# ─────────────────────────────────────────────────────────────────────────────
# Runtime secrets for the Cloudflare Pages Functions (/api/lead, /api/travel).
#
# Copy to `deploy/secrets.env` and fill with the real values — or generate it
# from your local `.env` with:
#
#   node scripts/generate-deploy-secrets.mjs
#
# Upload with Wrangler (one command, all keys):
#
#   npx wrangler pages secret bulk deploy/secrets.env --project-name sparkling-standard-cleaning
#
# Or enter each key in the dashboard: Pages project → Settings → Environment
# variables → Add → type "Secret".
#
# `deploy/secrets.env` is git-ignored. NEVER commit the populated file.
# ─────────────────────────────────────────────────────────────────────────────

# Web3Forms access key used by functions/api/lead.ts (server relay).
# The SAME key also goes in the PUBLIC_WEB3FORMS_ACCESS_KEY text variable for
# the client-side fallback path; it is a public client-side identifier by design.
WEB3FORMS_ACCESS_KEY=

# Cloudflare Turnstile secret (optional, recommended): enables server-side
# spam verification in functions/api/lead.ts. Pair with PUBLIC_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# Private operating origin for the estimator's travel function, "lat,lng".
# NEVER published — the function reads it at runtime only.
TRAVEL_ORIGIN=

# Routing provider API key (optional): Google Routes or Mapbox.
ROUTES_API_KEY=

# U.S. EIA API key (optional): live Gulf Coast gasoline reference price.
# Without it the estimator uses REFERENCE_GAS_PRICE.
EIA_API_KEY=
